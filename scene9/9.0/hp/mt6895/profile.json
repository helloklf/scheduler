{
  "alias": {
    "boost_affinity": "/sys/module/mtk_fpsgo/parameters/boost_affinity",
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "ddr_freq_min": "/sys/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/min_freq",
    "ddr_freq_max": "/sys/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/max_freq",
    "ddr_freq_cust": "/sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq",
    "ged_kpi": "/sys/module/sspm_v3/holders/ged/parameters/is_GED_KPI_enabled",
    "fpsgo": "/sys/kernel/fpsgo/common/fpsgo_enable",
    "cpufreq": "/proc/cpudvfs/cpufreq_debug",
    "perfmgr_enable": "/sys/module/mtk_fpsgo/parameters/perfmgr_enable",
    "ddr_max": "/sys/class/devfreq/mtk-dvfsrc-devfreq/max_freq"
  },
  "features": {
    "limiter": {
      "ddr_boost": false,
      "limiters": {
        "p1": {
          "cpus": [
            { "max": 2000000, "min": 1500000, "margins": "400" },
            { "max": 2100000, "min": 1200000, "margins": "300 1800000:150" },
            { "max": 2300000, "min": 1600000, "margins": "300 2100000:150" }
          ]
        },
        "p2": {
          "cpus": [
            { "max": 2000000, "min": 1800000, "margins": "400" },
            { "max": 2600000, "min": 1800000, "margins": "400 2100000:200 2400000:120" },
            { "max": 2850000, "min": 2150000, "margins": "400 2450000:200" }
          ]
        },
        "p3": {
          "cpus": [
            null,
            { "max": 2650000, "min": 2450000, "margins": "350" },
            { "max": 2850000, "min": 2650000, "margins": "350" }
          ]
        },
        "inactive": {
          "cpus": [
            { "max": 1800000, "min": 800000, "margins": "300 1500000:200" },
            { "max": 2000000, "min": 400000, "margins": "180" },
            { "max": 2000000, "min": 500000, "margins": "220" }
          ]
        },
        "idle": {
          "cpus": [
            { "max": 1600000, "min": 600000, "margins": "150" },
            { "max": 1800000, "min": 400000, "margins": "120" },
            { "max": 2000000, "min": 500000, "margins": "140" }
          ]
        }
      }
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
        ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"],
        ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "470000"],
        ["$ddr_freq_cust", "4266000000"]
      ],
      "exit": [
        ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"],
        ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "0"],
        ["$ddr_freq_cust", "#0"]
      ]
    }
  },
  "reset": [
    ["@mtk_reset"],
    ["@governor", "schedutil"],
    ["$perfmgr_enable", "#0"]
  ],
  "presets": {
    "common_active": [
      ["$cpu_max_0", "2000000"]
    ],
    "common_inactive": [
      ["@cpu_freqs_min", "450000", "200000", "500000"],
      ["$ddr_freq_min", "#800000000"],
      ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"]
    ],
    "common_app": [
      ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_enable 1|cm_mgr_perf_enable 1"],
      ["@cpuset", "0-3", "0-7", "0-7", "0-7"],
      ["/sys/kernel/ged/hal/custom_upbound_gpu_freq", "#07"],
      ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"],
      ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "0"],
      ["$ddr_max", "#5500000000"]
    ],
    "common_gaming": [
      ["@limiter", "NONE"],
      ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_enable 1|cm_mgr_perf_enable 1"],
      ["@cpuset", "0-2", "1-3", "0-5", "0-7"],
      ["/sys/kernel/ged/hal/custom_upbound_gpu_freq", "#0"],
      ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "#99"],
      ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "#0"],
      ["$ddr_freq_cust", "0"],
      ["$ddr_max", "#6400000000"]
    ],

    "powersave_active": [
      ["@limiter", "p1"],
      ["@cpu_freqs_min", "800000", "500000", "600000"],
      ["$ddr_freq_min", "#2133000000"],
      ["@preset", "common_active"]
    ],
    "powersave_inactive": [
      ["@limiter", "idle"],
      ["@preset", "common_inactive"]
    ],
    "balance_active": [
      ["@limiter", "p2"],
      ["@cpu_freqs_min", "1000000", "900000", "800000"],
      ["$ddr_freq_min", "#2133000000"],
      ["@preset", "common_active"]
    ],
    "balance_inactive": [
      ["@limiter", "inactive"],
      ["@preset", "common_inactive"]
    ],
    "performance_active": [
      ["@limiter3", "p3"],
      ["@cpu_freqs_min", "1200000", "1600000", "1600000"],
      ["$ddr_freq_min", "#2133000000"],
      ["@preset", "common_active"]
    ],
    "performance_inactive": [
      ["@limiter", "p2"],
      ["@preset", "common_inactive"]
    ],
    "fast_active": [
      ["@limiter", "NONE"],
      ["@cpu_freqs_max", "2000000", "2850000", "3100000"],
      ["@cpu_freqs_min", "1200000", "1600000", "1600000"],
      ["$ddr_freq_min", "3200000000"],
      ["@preset", "common_active"]
    ],
    "fast_inactive": [
      ["@limiter", "p3"],
      ["@preset", "common_inactive"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "powersave_active"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@cpu_freqs_min", "450000", "400000", "500000"],
        ["@cpu_freqs_max", "#2000000", "#1900000", "#2350000"],
        ["@cpu_freqs_min", "#500000", "#400000", "#500000"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "balance_active"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@cpu_freqs_min", "450000", "400000", "500000"],
        ["@cpu_freqs_max", "#2000000", "#2250000", "#2650000"],
        ["@cpu_freqs_min", "#500000", "#500000", "#600000"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "performance_active"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@cpu_freqs_min", "800000", "700000", "900000"],
        ["@cpu_freqs_max", "#2000000", "#2650000", "#2850000"],
        ["@cpu_freqs_min", "#800000", "#700000", "#900000"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "fast_active"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@cpu_freqs_min", "1600000", "1800000", "1800000"],
        ["@cpu_freqs_max", "#2000000", "#2850000", "#3100000"],
        ["@cpu_freqs_min", "#1600000", "#1600000", "#1800000"]
      ]
    }
  },
  "apps": [
    { "friendly": "相机", "packages": ["Camera"], "import": "_Camera.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}