{
  "alias": {
    "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "bus_ddr_min": "/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/min_freq",
    "l3_boost": "/sys/devices/system/cpu/bus_dcvs/L3/boost_freq",
    "ddr_boost": "/sys/devices/system/cpu/bus_dcvs/DDR/boost_freq",
    "perfmgr_enable": "/sys/module/perfmgr/parameters/perfmgr_enable",
    "sched_boost": "/proc/sys/walt/sched_boost"
  },
  "features": {
    "limiter": {
      "limiters": {
        "p1": {
          "cpus": [
            { "max": 1593600, "min": 595200, "margins": "300 1113600:150" },
            { "max": 2188800, "min": 729000, "margins": "300 1824000:150" },
            { "max": 2476800, "min": 864000, "margins": "300 1900800:150" }
          ]
        },
        "p2": {
          "cpus": [
            { "max": 1708800, "min": 1113600, "margins": "300" },
            { "max": 2457600, "min": 1612800, "margins": "300 2073600:150" },
            { "max": 2496000, "min": 1651200, "margins": "300 2150400:150" }
          ]
        },
        "p3": {
          "cpus": [
            { "max": 1843200, "min": 1228800, "margins": "300" },
            { "max": 2400000, "min": 2073600, "margins": "300" },
            { "max": 2726400, "min": 2150400, "margins": "300" }
          ]
        },
        "p4": {
          "cpus": [
            { "max": 1843200, "min": 1593600, "margins": "300" },
            { "max": 2400000, "min": 2208000, "margins": "300" },
            { "max": 2803200, "min": 2496000, "margins": "300" }
          ]
        },
        "inactive": {
          "cpus": [
            { "max": 1593600, "min": 595200, "margins": "150" },
            { "max": 1920000, "min": 633600, "margins": "150" },
            { "max": 2016000, "min": 633600, "margins": "150" }
          ]
        },
        "idle": {
          "cpus": [
            { "max": 1593600, "min": 595200, "margins": "100" },
            { "max": 1708800, "min": 633600, "margins": "100" },
            { "max": 1766400, "min": 633600, "margins": "150" }
          ]
        }
      }
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
        ["$sched_boost", "1"]
      ],
      "exit": [
        ["$sched_boost", "0"]
      ]
    }
  },
  "reset": [
    ["@msm_reset"],
    ["$bus_ddr_min", "547000"],
    ["$l3_boost", "0"],
    ["$ddr_boost", "0"],
    ["@governor", "walt"],
    ["@preset", "ddr_max"]
  ],
  "presets": {
    "latency": [
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy3/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy3/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us"]
    ],
    "cpu7_on": [
      ["$core_ctl_7", "1"],
      ["$max_cpus_cpu7", "#1"],
      ["$min_cpus_cpu7", "#1"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_off": [
      ["$core_ctl_7", "1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#0"]
    ],
    "limiter_off": [
      ["/proc/game_opt/disable_cpufreq_limit", "#1"],
      ["/sys/module/migt/parameters/glk_disable", "#1"],
      ["/sys/module/perfmgr/parameters/perfmgr_enable", "#0"]
    ],
    "limiter_on": [
      ["/proc/game_opt/disable_cpufreq_limit", "0"],
      ["/sys/module/migt/parameters/glk_disable", "0"]
    ],
    "common_active": [
      ["@values", "latency", "0", "1000", "0", "1000", "0", "1000"],
      ["@preset", "cpu7_on"]
    ],
    "common_inactive": [
      ["@values", "latency", "0", "2000", "0", "2000", "0", "2000"],
      ["@cpu_freqs_min", "#441600", "#480000", "#480000"],
      ["$sched_boost", "0"]
    ],
    "common_app": [
      ["$perfmgr_enable", "0"],
      ["@cpuset", "0-2", "0-6", "0-7", "0-7"],
      ["$mod_percent", "110"]
    ],
    "common_gaming": [
      ["@values", "latency", "0", "2000", "0", "2000", "0", "2000"],
      ["@cpuset", "0-2", "0-5", "0-5", "0-7"],
      ["@preset", "l3_max"],
      ["$sched_boost", "0"],
      ["$mod_percent", "100"]
    ],

    "l3": [
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:gold/max_freq", "1708800"],
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime/max_freq", "1708800"],
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime-compute/max_freq", "1708800"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:l3:silver/max_freq", "1708800"]
    ],
    "l3_max": [
      ["@values", "l3", "1708800", "1708800", "1708800", "1708800"]
    ],
    "l3_low": [
      ["@values", "l3", "1593600", "1593600", "1593600", "1593600"]
    ],
    "ddr": [
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/max_freq", "4224000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:gold-compute/max_freq", "1555200"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:gold/max_freq", "4224000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:prime-latfloor/max_freq", "4224000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:prime/max_freq", "4224000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:silver/max_freq", "1555200"]
    ],

    "ddr_max": [
      ["@values", "ddr", "4224000", "1555200", "4224000", "4224000", "4224000", "1555200"]
    ],

    "powersave_active": [
      ["@preset", "common_active"],
      ["@target_loads",
        "82 1497600:90",
        "82 1612800:90",
        "82 1651200:90"
      ],
      ["@limiter", "p1"],
      ["@hispeed_freq", "787200", "940800", "960000"]
    ],
    "powersave_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1017600:90",
        "85 1056000:90",
        "85 1094400:90"
      ],
      ["@limiter", "idle"],
      ["@hispeed_freq", "0", "0", "0"]
    ],

    "balance_active": [
      ["@preset", "common_active"],
      ["@target_loads",
        "80 1593600:90",
        "80 1612800:85 1920000:90",
        "80 1766400:85 2016000:90"
      ],
      ["@limiter", "p2"],
      ["@hispeed_freq", "1113600", "1056000", "1094400"]
    ],
    "balance_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1017600:90",
        "85 940800:90 1497600:95",
        "85 960000:90 1651200:95"
      ],
      ["@limiter", "inactive"],
      ["@hispeed_freq", "691200", "0", "0"]
    ],

    "performance_active": [
      ["@preset", "common_active"],
      ["@target_loads",
        "80 1593600:90",
        "80 1708800:85 2073600:90",
        "80 1766400:85 2150400:90"
      ],
      ["@limiter", "p3"],
      ["@hispeed_freq", "1113600", "1286400", "1324800"]
    ],
    "performance_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1017600:90",
        "85 940800:90 1612800:95",
        "85 960000:90 1766400:95"
      ],
      ["@limiter", "p1"],
      ["@hispeed_freq", "787200", "787200", "787200"]
    ],

    "fast_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "#1017600", "#1286400", "#1209600"],
      ["@target_loads",
        "80 1593600:85",
        "80 2073600:85",
        "80 2150400:85"
      ],
      ["@limiter", "p4"],
      ["@hispeed_freq", "1228800", "1497600", "1459200"]
    ],
    "fast_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1593600:90",
        "80 1708800:87 2073600:95",
        "80 1766400:87 2150400:95"
      ],
      ["@limiter", "p2"],
      ["@hispeed_freq", "787200", "787200", "787200"]
    ],

    "pedestal_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "#1017600", "#1612800", "#1651200"],
      ["@target_loads",
        "70",
        "70",
        "70"
      ],
      ["@limiter", "NONE"],
      ["@hispeed_freq", "1228800", "1497600", "1459200"]
    ],
    "pedestal_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "80",
        "80",
        "80"
      ],
      ["@limiter", "NONE"],
      ["@hispeed_freq", "787200", "787200", "787200"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "powersave_active"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "balance_active"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
      ]
    },
    "performance": {
      "call": [
        ["@preset", "performance_active"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "fast_active"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    },
    "pedestal": {
      "call": [
        ["@preset", "pedestal_active"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    }
  },
  "apps": [
    {
      "friendly": "ELP",
      "packages": [
        "IM", "Music", "Reader", "ShortVideo", "Nav", "ScrollOpt"
      ],
      "import": "_ELP.json"
    },
    { "friendly": "相机", "packages": ["Camera"], "import": "_Camera.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}