{
  "alias": {
    "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
    "mod_percent": "/sys/class/kgsl/kgsl-3d0/devfreq/mod_percent",
    "max_cpus_cpu6": "/sys/devices/system/cpu/cpu6/core_ctl/max_cpus",
    "min_cpus_cpu6": "/sys/devices/system/cpu/cpu6/core_ctl/min_cpus",
    "core_ctl_0": "/sys/devices/system/cpu/cpu0/core_ctl/enable",
    "core_ctl_6": "/sys/devices/system/cpu/cpu6/core_ctl/enable",
    "perfmgr_enable": "/sys/module/perfmgr/parameters/perfmgr_enable",
    "sched_boost": "/proc/sys/walt/sched_boost",
    "glk_disable": "/sys/module/migt/parameters/glk_disable",
    "input_boost": "/proc/sys/walt/input_boost/sched_boost_on_input"
  },
  "features": {
    "limiter": {
      "ddr_boost": false,
      "limiters": {}
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
        ["$cpu_max_0", "^2476800"],
        ["$cpu_max_6", "^2841600"]
      ],
      "exit": [
      ]
    }
  },
  "reset": [
    ["@msm_reset"],
    ["@governor", "walt"]
  ],
  "presets": {  
    "latency": [
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy6/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy6/walt/up_rate_limit_us"]
    ],
    "target_loads": [
      ["/sys/devices/system/cpu/cpu0/cpufreq/walt/target_loads"],
      ["/sys/devices/system/cpu/cpu6/cpufreq/walt/target_loads"]
    ],
    "cpu6_on": [
      ["$core_ctl_6", "1"],
      ["$max_cpus_cpu6", "#2"],
      ["$min_cpus_cpu6", "#2"],
      ["$core_ctl_6", "#0"]
    ],
    "cpu6_off": [
      ["$core_ctl_6", "1"],
      ["$min_cpus_cpu6", "#0"],
      ["$max_cpus_cpu6", "#0"]
    ],
    "cpu6_auto": [
      ["$core_ctl_6", "1"],
      ["$min_cpus_cpu6", "#0"],
      ["$max_cpus_cpu6", "#2"]
    ],
    "limiter_off": [
      ["/proc/game_opt/disable_cpufreq_limit", "#1"],
      ["/sys/module/migt/parameters/glk_disable", "#1"],
      ["/sys/module/perfmgr/parameters/perfmgr_enable", "#0"],
      ["/sys/module/migt/parameters/glk_freq_limit_walt", "#0"]
    ],
    "limiter_on": [
      ["/proc/game_opt/disable_cpufreq_limit", "0"],
      ["/sys/module/migt/parameters/glk_disable", "0"]
    ],
    "common_active": [
      ["@preset", "cpu6_on"]
    ],
    "common_inactive": [
      ["@cpu_freqs_min", "0", "0"],
      ["$sched_boost", "0"]
    ],
    "common_app": [
      ["$perfmgr_enable", "0"],
      ["@cpuset", "0-3", "0-5", "0-7", "0-7"],
      ["@values", "latency", "0", "2000", "0", "2000"],
      ["$mod_percent", "125"]
    ],
    "common_gaming": [
      ["@preset", "common_active"],
      ["@limiter", "NONE"],
      ["@cpuset", "0-1", "0-4", "0-4", "0-7"],
      ["$sched_boost", "0"],
      ["@values", "latency", "0", "2000", "0", "2000"],
      ["$mod_percent", "100"]
    ],

    "powersave_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "556800", "806400"],
      ["@target_loads",
        "85",
        "85"],
      ["@hispeed_freq", "902400", "0"]
    ],
    "powersave_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "90",
        "90"],
      ["@hispeed_freq", "0", "0"]
    ],

    "balance_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "691200", "806400"],
      ["@target_loads",
        "80",
        "80"],
      ["@hispeed_freq", "902400", "0"]
    ],
    "balance_inactive": [
      ["@preset", "common_inactive"],
      ["@preset", "cpu6_auto"],
      ["@target_loads",
        "85",
        "85"],
      ["@hispeed_freq", "0", "0"]
    ],

    "performance_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "806400", "806400"],
      ["@target_loads",
        "80",
        "80"],
      ["@hispeed_freq", "902400", "0"]
    ],
    "performance_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85",
        "85"],
      ["@hispeed_freq", "0", "0"]
    ],

    "fast_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "902400", "1017600"],
      ["@target_loads",
        "78",
        "78"],
      ["@hispeed_freq", "1152000", "0"]
    ],
    "fast_inactive": [
      ["@target_loads",
        "85",
        "85"],
      ["@hispeed_freq", "902400", "0"]
    ],

    "pedestal_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "1401600", "1497600"],
      ["@target_loads",
        "70",
        "70"],
      ["@hispeed_freq", "1651200", "0"]
    ],
    "pedestal_inactive": [
      ["@target_loads",
        "80",
        "80"],
      ["@hispeed_freq", "902400", "0"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["/sys/devices/system/cpu/cpufreq/boost", "0"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "1900800", "#2227200"],
        ["@preset", "powersave_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_on"],
        ["@hispeed_freq", "1152000", "0"]
      ]
    },
    "balance": {
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "2476800", "#2841600"],
        ["@preset", "balance_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_on"],
        ["@hispeed_freq", "1152000", "1017600"]
      ]
    },
    "performance": {
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "2707200", "#3244800"],
        ["@preset", "performance_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_off"],
        ["@hispeed_freq", "1152000", "1017600"]
      ]
    },
    "fast": {
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "3129600", "#3724800"],
        ["@preset", "fast_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_off"],
        ["@hispeed_freq", "1152000", "1382400"]
      ]
    },
    "pedestal": {
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "3321600", "#3801600"],
        ["@preset", "pedestal_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_off"],
        ["@hispeed_freq", "1152000", "1382400"]
      ]
    }
  },
  "apps": [
    { "friendly": "相机", "packages": ["Camera"], "import": "_Camera.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}