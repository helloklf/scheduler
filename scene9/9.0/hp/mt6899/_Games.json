{
  "friendly": "游戏(Games)",
  "call": [
    ["@preset", "common_gaming"],
    ["/sys/module/mtk_fpsgo/parameters/p_perf", "1"],
    ["/sys/module/mtk_fpsgo/parameters/better_perf", "1"],
    ["/sys/kernel/fpsgo/fbt/enable_ceiling", "#0"]
  ],
  "limiters": {
    "g3": {
      "mode": "boost",
      "cpus": [
        { "max": 1800000, "min": 700000, "margins": "300" },
        { "max": 2600000, "min": 700000, "margins": "300" },
        { "max": 3000000, "min": 700000, "margins": "300" }
      ]
    },
    "g4": {
      "mode": "boost",
      "cpus": [
        { "max": 2100000, "min": 700000, "margins": "300" },
        { "max": 3000000, "min": 700000, "margins": "300" },
        { "max": 3250000, "min": 700000, "margins": "300" }
      ]
    }
  },
  "modes": [
    {
      "mode": ["powersave"],
      "call": [
        ["@values", "max_freq", "#1700000", "#2100000", "#2400000"],
        ["@values", "min_freq", "400000", "550000", "600000"]
      ],
      "fas": {
        "use": "whitelist",
        "freq": ["2400000", "2100000"]
      }
    },
    {
      "mode": ["balance"],
      "call": [
        ["@values", "max_freq", "#1700000", "#2400000", "#2600000"],
        ["@values", "min_freq", "700000", "800000", "900000"]
      ],
      "fas": {
        "use": "whitelist",
        "freq": ["2800000", "2400000"]
      }
    },
    {
      "mode": ["performance"],
      "call": [
        ["@values", "max_freq", "#1800000", "#2600000", "#3000000"],
        ["@values", "min_freq", "800000", "800000", "900000"],
        ["@limiter", "g3"]
      ],
      "fas": {
        "use": "whitelist",
        "freq": ["3100000", "2800000"]
      }
    },
    {
      "mode": ["*"],
      "call": [
        ["@values", "max_freq", "#2000000", "#3000000", "#3250000"],
        ["@values", "min_freq", "800000", "800000", "900000"],
        ["@governor", "schedutil"],
        ["@ddr_l3_booster"]
      ],
      "fas": {
        "use": "whitelist",
        "freq": ["3250000", "3000000"]
      }
    }
  ]
}