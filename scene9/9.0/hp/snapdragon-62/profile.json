{
  "alias": {
    "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
    "max_cpus_cpu6": "/sys/devices/system/cpu/cpu6/core_ctl/max_cpus",
    "min_cpus_cpu6": "/sys/devices/system/cpu/cpu6/core_ctl/min_cpus",
    "msm_min_freq": "/sys/module/msm_performance/parameters/cpu_min_freq",
    "msm_max_freq": "/sys/module/msm_performance/parameters/cpu_max_freq",
    "llcc_ddr_max": "/sys/class/devfreq/soc:qcom,cpu-llcc-ddr-bw/max_freq",
    "cpu_llcc_max": "/sys/class/devfreq/soc:qcom,cpu-cpu-llcc-bw/max_freq",
    "llcc_ddr_min": "/sys/class/devfreq/soc:qcom,cpu-llcc-ddr-bw/min_freq",
    "cpu_llcc_min": "/sys/class/devfreq/soc:qcom,cpu-cpu-llcc-bw/min_freq"
  },
  "features": {
    "limiter": {
      "limiters": {
        "p1": {
          "cpus": [
            { "max": 2000000, "min": 1400000, "margins": "400" },
            { "max": 2200000, "min": 1400000, "margins": "400" }
          ]
        },
        "p2": {
          "cpus": [
            { "max": 2000000, "min": 1500000, "margins": "400" },
            { "max": 2600000, "min": 1800000, "margins": "400" }
          ]
        },
        "p3": {
          "cpus": [
            { "max": 2000000, "min": 1600000, "margins": "400" },
            { "max": 2600000, "min": 2100000, "margins": "400" }
          ]
        },
        "idle": {
          "core_ctl": [1],
          "cpus": [
            { "max": 1700000, "margins": "150" },
            { "max": 1700000, "margins": "150" }
          ]
        }
      }
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
        ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "24"],
        ["$ddr_freq_cust", "4266000000"]
      ],
      "exit": [
        ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"],
        ["$ddr_freq_cust", "#0"]
      ]
    }
  },
  "reset": [
    ["@msm_reset"],
    ["@governor", "walt", "schedutil"],
    ["@sched_limit", "1000 1000", "1000 1000"]
  ],
  "presets": {
    "hispeed_freq": [
      ["/sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_freq"],
      ["/sys/devices/system/cpu/cpufreq/policy6/schedutil/hispeed_freq"]
    ],
    "hispeed_load": [
      ["/sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_load"],
      ["/sys/devices/system/cpu/cpufreq/policy6/schedutil/hispeed_load"]
    ],
    "sched_config": [
      ["/proc/sys/kernel/sched_downmigrate"],
      ["/proc/sys/kernel/sched_upmigrate"],
      ["/proc/sys/kernel/sched_group_downmigrate"],
      ["/proc/sys/kernel/sched_group_upmigrate"]
    ],
    "sched_boost": [
      ["/proc/sys/kernel/sched_boost_top_app"],
      ["/proc/sys/kernel/sched_boost"],
      ["/dev/stune/top-app/schedtune.prefer_idle"],
      ["/dev/stune/top-app/schedtune.boost"]
    ],
    "min_freq": [
      ["$cpu_min_0"], ["$cpu_min_6"]
    ],
    "max_freq": [
      ["$cpu_max_0"], ["$cpu_max_6"]
    ],
    "common_active": [
      ["$cpu_max_0", "1804800"],
      ["@preset", "cores_force_on"],
      ["@cpuset", "1", "0-3", "0-5", "0-7"]
    ],
    "common_inactive": [
      ["@cpuset", "0-3", "0-3", "0-5", "0-7"]
    ],
    "common_app": [
      ["@cpuset", "0-3", "0-3", "0-5", "0-7"]
    ],
    "common_gaming": [
      ["@limiter", "NONE"],
      ["@cpuset", "0-2", "0-4", "0-5", "0-7"]
    ],

    "cores_force_on": [
      ["$core_ctl_6", "0"], ["$max_cpus_cpu6", "2"], ["$min_cpus_cpu6", "2"]
    ],
    "bw_max": [
      ["$llcc_ddr_max", "#6881"],
      ["$cpu_llcc_max", "#14236"],
      ["$llcc_ddr_min", "#762"],
      ["$cpu_llcc_min", "#4577"]
    ],
    "bw_low": [
      ["$llcc_ddr_max", "#3879"],
      ["$cpu_llcc_max", "#9155"],
      ["$llcc_ddr_min", "#762"],
      ["$cpu_llcc_min", "#4577"]
    ],

    "powersave_active": [
      ["@preset", "common_active"],
      ["@limiter", "p1"],
      ["@cpu_freqs_min", "1094400", "500000"],
      ["@repeat", "sched_config", "70", "80", "150", "400"]
    ],
    "powersave_inactive": [
      ["@limiter", "idle"],
      ["@preset", "common_inactive"],
      ["@cpu_freqs_min", "300000", "500000"],
      ["@repeat", "sched_config", "85", "95", "150", "400"]
    ],

    "balance_active": [
      ["@preset", "common_active"],
      ["@limiter", "NONE"],
      ["@cpu_freqs_min", "1209600", "960000"],
      ["@repeat", "sched_config", "65", "75", "150", "400"]
    ],
    "balance_inactive": [
      ["@limiter", "p2"],
      ["@preset", "common_inactive"],
      ["@cpu_freqs_min", "300000", "500000"],
      ["@repeat", "sched_config", "85", "95", "150", "400"]
    ],

    "performance_active": [
      ["@preset", "common_active"],
      ["@limiter", "NONE"],
      ["@cpu_freqs_max", "#2200000", "#2450000"],
      ["@cpu_freqs_min", "1401600", "1075200"],
      ["@repeat", "sched_config", "62", "70", "150", "400"]
    ],
    "performance_inactive": [
      ["@preset", "common_inactive"],
      ["@limiter", "p3"],
      ["@cpu_freqs_min", "1209600", "710400"],
      ["@repeat", "sched_config", "85", "95", "150", "400"]
    ],

    "fast_active": [
      ["@preset", "common_active"],
      ["@limiter", "NONE"],
      ["@cpu_freqs_max", "#2200000", "#2850000"],
      ["@cpu_freqs_min", "1497600", "1440000"],
      ["@repeat", "sched_config", "62 62", "70 78", "300", "400"]
    ],
    "fast_inactive": [
      ["@preset", "common_inactive"],
      ["@limiter", "p4"],
      ["@cpu_freqs_min", "1209600", "710400"],
      ["@repeat", "sched_config", "85", "95", "150", "400"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "powersave_active"],
        ["@values", "hispeed_freq", "1248000", "806400"],
        ["@values", "hispeed_load", "90", "90"],
        ["@values", "sched_boost", "0", "0", "0", "0"],
        ["@gpu_freq", "min", "500000"],
        ["@preset", "bw_low"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@cpu_freq", "cpu0", "500000", "1800000"],
        ["@cpu_freq", "cpu6", "500000", "2200000"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "balance_active"],
        ["@values", "hispeed_freq", "1248000", "1209600"],
        ["@values", "hispeed_load", "90", "90"],
        ["@values", "sched_boost", "1", "0", "0", "0"],
        ["@gpu_freq", "min", "630000"],
        ["@preset", "bw_max"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@cpu_freq", "cpu0", "800000", "2000000"],
        ["@cpu_freq", "cpu6", "700000", "2400000"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "performance_active"],
        ["@sched_limit", "0 0", "0 0", "0 0"],
        ["@values", "hispeed_freq", "1708800", "1209600"],
        ["@values", "hispeed_load", "87", "87"],
        ["@values", "sched_boost", "1", "0", "0", "0"],
        ["@gpu_freq", "min", "730000"],
        ["@preset", "bw_max"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@cpu_freq", "cpu0", "1000000", "2000000"],
        ["@cpu_freq", "cpu6", "1000000", "2600000"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "fast_active"],
        ["@values", "hispeed_freq", "0", "0"],
        ["@values", "hispeed_load", "0", "0"],
        ["@values", "sched_boost", "1", "0", "1", "10"],
        ["@gpu_freq", "min", "max"],
        ["@preset", "bw_max"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@cpu_freq", "cpu0", "1500000", "2200000"],
        ["@cpu_freq", "cpu6", "1700000", "3000000"]
      ]
    }
  },
  "apps": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Apps.json"
    }
  ],
  "games": [
    {
      "friendly": "游戏",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}