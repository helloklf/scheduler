{
  "platform": "mt6983",
  "platform_name": "D9000",
  "alias": {
    "gpu_freq": "/sys/kernel/ged/hal/custom_upbound_gpu_freq",
    "gpu_min_opp": "/sys/kernel/ged/hal/custom_boost_gpu_freq",
    "boost_affinity": "/sys/module/mtk_fpsgo/parameters/boost_affinity",
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "ddr_freq_min": "/sys/class/devfreq/mtk-dvfsrc-devfreq/min_freq",
    "ddr_freq_cust": "/sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq",
    "ged_kpi": "/sys/module/sspm_v3/holders/ged/parameters/is_GED_KPI_enabled",
    "fpsgo": "/sys/kernel/fpsgo/common/fpsgo_enable",
    "cpufreq": "/proc/cpudvfs/cpufreq_debug",
    "ddr_force_opp": "/sys/devices/platform/1c00f000.dvfsrc/1c00f000.dvfsrc:dvfsrc-helper/dvfsrc_force_vcore_dvfs_opp",
    "limit_cfreq": "/sys/kernel/fpsgo/fbt/limit_cfreq",
    "limit_rfreq": "/sys/kernel/fpsgo/fbt/limit_rfreq",
    "limit_cfreq_m": "/sys/kernel/fpsgo/fbt/limit_cfreq_m",
    "limit_rfreq_m": "/sys/kernel/fpsgo/fbt/limit_rfreq_m",
    "perfmgr_enable": "/sys/module/mtk_fpsgo/parameters/perfmgr_enable",
    "ddr_max": "/sys/class/devfreq/mtk-dvfsrc-devfreq/max_freq"
  },
  "features": {
    "limiter": {
      "ddr_boost": true,
      "limiters": {
        "p1": {
          "cpus": [
            { "max": 1401600, "min": 500000, "margins": "250" },
            { "max": 2150400, "min": 700000, "margins": "400" },
            { "max": 2304000, "min": 1300000, "margins": "400" }
          ]
        },
        "p2": {
          "cpus": [
            { "max": 1500000, "min": 1050000, "margins": "300" },
            { "max": 2400000, "min": 2050000, "margins": "400" },
            { "max": 2650000, "min": 2100000, "margins": "400" }
          ]
        },
        "p3": {
          "cpus": [
            { "max": 1600000, "min": 1400000, "margins": "300" },
            { "max": 2650000, "min": 2400000, "margins": "300" },
            { "max": 2800000, "min": 2400000, "margins": "300" }
          ]
        },
        "p4": {
          "cpus": [
            { "max": 1600000, "min": 1500000, "margins": "300" },
            { "max": 2650000, "min": 2650000, "margins": "300" },
            { "max": 2800000, "min": 2650000, "margins": "300" }
          ]
        },
        "inactive": {
          "cpus": [
            { "max": 1500000, "min": 400000, "margins": "80" },
            { "max": 2100000, "min": 400000, "margins": "100" },
            { "max": 2100000, "min": 1300000, "margins": "130" }
          ]
        },
        "idle": {
          "cpus": [
            { "max": 1200000, "min": 400000, "margins": "50" },
            { "max": 1800000, "min": 400000, "margins": "60" },
            { "max": 1800000, "min": 1300000, "margins": "70", "core_ctl": true }
          ]
        }
      }
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
        ["$gpu_min_opp", "28"],
        ["$ddr_freq_cust", "4266000000"]
      ],
      "exit": [
        ["$gpu_min_opp", "99"],
        ["$ddr_freq_cust", "#0"]
      ]
    }
  },
  "reset": [
    ["@mtk_reset"],
    ["@governor", "schedutil"],
    ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_enable 1|cm_mgr_perf_enable 1|dsu_mode 1"],
    ["$ddr_force_opp", "999"],
    ["$ddr_freq_cust", "0"],
    ["$perfmgr_enable", "#0"]
  ],
  "presets": {
    "cpu7_on": [
      ["$core_ctl_7", "#1"],
      ["$max_cpus_cpu7", "#1"],
      ["$min_cpus_cpu7", "#1"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_off": [
      ["$core_ctl_7", "#1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#0"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_auto": [
      ["$core_ctl_7", "#1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#1"]
    ],
    "common_active": [
      ["@preset", "cpu7_on"],
      ["$ddr_max", "#5500000000"]
    ],
    "common_inactive": [
      ["@cpu_freqs_min", "200000", "400000", "1300000"],
      ["$gpu_min_opp", "99"],
      ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "#0"]
    ],
    "common_app": [
      ["@cpuset", "0-3", "0-7", "0-7", "0-7"],
      ["$gpu_freq", "#15"]
    ],
    "common_gaming": [
      ["@limiter", "NONE"],
      ["$gpu_freq", "#0"],
      ["$gpu_min_opp", "99"],
      ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "0"],
      ["@cpuset", "0-3", "0-5", "0-5", "0-7"],
      ["$boost_affinity", "0"]
    ],

    "powersave_active": [
      ["@limiter", "p1"],
      ["@preset", "common_active"],
      ["$ddr_freq_min", "#1866000000"],
      ["@cpu_freqs_min", "400000", "700000", "1300000"]
    ],
    "powersave_inactive": [
      ["@limiter", "idle"],
      ["@preset", "common_inactive"],
      ["$ddr_freq_min", "#800000000"],
      ["@preset", "cpu7_off"]
    ],
    "balance_active": [
      ["@limiter", "p2"],
      ["@preset", "common_active"],
      ["$ddr_freq_min", "#2667000000"],
      ["@cpu_freqs_min", "500000", "700000", "1300000"]
    ],
    "balance_inactive": [
      ["@limiter", "inactive"],
      ["@preset", "common_inactive"],
      ["$ddr_freq_min", "#800000000"]
    ],
    "performance_active": [
      ["@limiter", "p3"],
      ["@cpu_freqs_min", "700000", "900000", "1300000"],
      ["@preset", "common_active"],
      ["$ddr_freq_min", "#320000000"]
    ],
    "performance_inactive": [
      ["@limiter", "p2"],
      ["@preset", "common_inactive"],
      ["$ddr_freq_min", "#800000000"]
    ],
    "fast_active": [
      ["@limiter", "p4"],
      ["@preset", "common_active"],
      ["$ddr_freq_min", "#320000000"],
      ["@cpu_freqs_min", "1000000", "1000000", "1300000"]
    ],
    "fast_inactive": [
      ["@limiter", "p3"],
      ["@preset", "common_inactive"],
      ["$ddr_freq_min", "#1866000000"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "powersave_active"],
        ["$gpu_freq", "20"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@cpu_freq", "cpu0", "400000", "1200000"],
        ["@cpu_freq", "cpu4", "400000", "1900000"],
        ["@cpu_freq", "cpu7", "1300000", "2100000"],
        ["$ddr_freq_min", "#1866000000"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "balance_active"],
        ["$gpu_freq", "15"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@cpu_freq", "cpu0", "700000", "1500000"],
        ["@cpu_freq", "cpu4", "700000", "2100000"],
        ["@cpu_freq", "cpu7", "1300000", "2400000"],
        ["$ddr_freq_min", "#1866000000"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "performance_active"],
        ["$gpu_freq", "10"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@cpu_freq", "cpu0", "800000", "1600000"],
        ["@cpu_freq", "cpu4", "1000000", "2650000"],
        ["@cpu_freq", "cpu7", "1300000", "2800000"],
        ["$ddr_freq_min", "#1866000000"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "fast_active"],
        ["$gpu_freq", "0"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@cpu_freq", "cpu0", "1000000", "1600000"],
        ["@cpu_freq", "cpu4", "1000000", "2850000"],
        ["@cpu_freq", "cpu7", "1300000", "3000000"],
        ["$ddr_freq_min", "#2667000000"]
      ]
    }
  },
  "apps": [
    { "friendly": "相机", "packages": ["Camera"], "import": "_Camera.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}