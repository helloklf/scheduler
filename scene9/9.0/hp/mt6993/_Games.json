{
  "friendly": "游戏(Games)",
  "call": [
    ["@preset", "common_gaming"],
    ["/sys/module/mtk_fpsgo/parameters/p_perf", "1"],
    ["/sys/module/mtk_fpsgo/parameters/better_perf", "1"],
    ["/sys/kernel/fpsgo/fbt/enable_ceiling", "#0"]
  ],
  "modes": [
    {
      "mode": ["powersave"],
      "call": [
        ["@cpu_freqs_max", "#1600000", "#1900000", "#2300000"],
        ["@cpu_freqs_min", "#500000", "#622000", "#798000"]
      ],
      "fas": {
        "use": "whitelist",
        "freq": ["2300000", "1900000"]
      }
    },
    {
      "mode": ["balance"],
      "call": [
        ["@cpu_freqs_max", "#1700000", "#2200000", "#2600000"],
        ["@cpu_freqs_min", "#700000", "#800000", "#900000"]
      ],
      "fas": {
        "use": "whitelist",
        "freq": ["2600000", "2200000"]
      }
    },
    {
      "mode": ["performance"],
      "call": [
        ["@cpu_freqs_max", "#1800000", "#2600000", "#3000000"],
        ["@cpu_freqs_min", "#800000", "#800000", "#900000"]
      ],
      "fas": {
        "use": "whitelist",
        "freq": ["3000000", "2600000"]
      }
    },
    {
      "mode": ["fast"],
      "call": [
        ["@governor", "schedutil", "sugov_ext"],
        ["@cpu_freqs_max", "#2000000", "#3000000", "#3500000"],
        ["@cpu_freqs_min", "#800000", "#900000", "#1200000"]
      ],
      "fas": {
        "use": "whitelist",
        "mode": "normal",
        "freq": ["3500000", "3000000"]
      }
    },
    {
      "mode": ["*"],
      "call": [
        ["@governor", "schedutil", "sugov_ext"],
        ["@cpu_freqs_max", "#2400000", "#3200000", "#3650000"],
        ["@cpu_freqs_min", "#800000", "#900000", "#1200000"]
      ],
      "fas": {
        "use": "whitelist",
        "mode": "normal",
        "freq": ["3800000", "3200000"]
      }
    }
  ]
}