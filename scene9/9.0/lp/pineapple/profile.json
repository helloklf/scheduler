{
    "platform": "pineapple",
    "platform_name": "8GEN3",
    "alias": {
      "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
      "mod_percent": "/sys/class/kgsl/kgsl-3d0/devfreq/mod_percent",
      "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
      "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
      "perfmgr_enable": "/sys/module/perfmgr/parameters/perfmgr_enable",
      "cpu_min_2": "/sys/devices/system/cpu/cpufreq/policy2/scaling_min_freq",
      "cpu_max_2": "/sys/devices/system/cpu/cpufreq/policy2/scaling_max_freq",
      "cpu_min_5": "/sys/devices/system/cpu/cpufreq/policy5/scaling_min_freq",
      "cpu_max_5": "/sys/devices/system/cpu/cpufreq/policy5/scaling_max_freq",
      "sched_boost": "/proc/sys/walt/sched_boost"
    },
    "features": {
      "limiter": {
        "ddr_boost": false,
        "limiters": {
          "p1": {
            "cpus": [
              { "max": 1689600, "min": 672000, "margins": "150" },
              { "max": 1920000, "min": 960000, "margins": "200 1708800:120" },
              { "max": 1920000, "min": 960000, "margins": "200 1708800:120" },
              { "max": 1939200, "min": 902400, "margins": "200 1708800:120" }
            ]
          },
          "p2": {
            "cpus": [
              { "max": 1689600, "min": 787200, "margins": "150" },
              { "max": 1920000, "min": 960000, "margins": "200 1708800:120" },
              { "max": 1920000, "min": 960000, "margins": "200 1708800:120" },
              { "max": 1939200, "min": 902400, "margins": "200 1708800:120" }
            ]
          },
          "p3": {
            "cpus": [
              { "max": 1804800, "min": 1017600, "margins": "120" },
              { "max": 2515200, "min": 1920000, "margins": "300" },
              { "max": 2515200, "min": 1920000, "margins": "300" },
              { "max": 2630400, "min": 2035200, "margins": "300" }
            ]
          },
          "p4": {
            "cpus": [
              { "max": 1804800, "min": 1017600, "margins": "150" },
              { "max": 2841600, "min": 2438400, "margins": "200" },
              { "max": 2707200, "min": 2438400, "margins": "200" },
              { "max": 2803200, "min": 2438400, "margins": "300" }
            ]
          },
          "inactive": {
            "core_ctl": [3],
            "cpus": [
              { "max": 1689600, "min": 672000, "margins": "100" },
              { "max": 1920000, "min": 614400, "margins": "120" },
              { "max": 1920000, "min": 614400, "margins": "120" },
              { "max": 1939200, "min": 672000, "margins": "120" }
            ]
          },
          "idle": {
            "core_ctl": [3],
            "cpus": [
              { "max": 1689600, "min": 556800, "margins": "100" },
              { "max": 1785600, "min": 614400, "margins": "100" },
              { "max": 1785600, "min": 614400, "margins": "100" },
              { "max": 1708800, "min": 672000, "margins": "100" }
            ]
          }
        }
      },
      "gesture_boost": {
        "enable": true,
        "enter": [
        ],
        "exit": [
          ["$sched_boost", "0"]
        ]
      }
    },
    "reset": [
      ["@msm_reset"],
      ["@governor", "uag", "walt"],
      ["@preset", "limiter_off"],
      ["/sys/devices/system/cpu/bus_dcvs/L3/boost_freq", "364800"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/boost_freq", "547000"]
    ],
    "presets": { 
      "latency": [
        ["/sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy2/walt/down_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy2/walt/up_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy5/walt/down_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy5/walt/up_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us"]
      ],
      "cpu7_on": [
        ["$core_ctl_7", "1"],
        ["$max_cpus_cpu7", "#1"],
        ["$min_cpus_cpu7", "#1"],
        ["$core_ctl_7", "#0"]
      ],
      "cpu7_off": [
        ["$core_ctl_7", "1"],
        ["$min_cpus_cpu7", "#0"],
        ["$max_cpus_cpu7", "#0"]
      ],
      "cpu7_auto": [
        ["$core_ctl_7", "1"],
        ["$min_cpus_cpu7", "#0"],
        ["$max_cpus_cpu7", "#1"]
      ],
      "limiter_off": [
        ["/proc/game_opt/disable_cpufreq_limit", "#1"],
        ["/sys/module/migt/parameters/glk_disable", "#1"],
        ["/sys/module/perfmgr/parameters/perfmgr_enable", "#0"],
        ["/sys/module/migt/parameters/glk_freq_limit_walt", "#0"]
      ],
      "limiter_on": [
        ["/proc/game_opt/disable_cpufreq_limit", "0"],
        ["/sys/module/migt/parameters/glk_disable", "0"]
      ],
      "common_active": [
        ["@preset", "cpu7_on"]
      ],
      "common_inactive": [
        ["@cpu_freqs_min", "307200", "499200", "499200", "480000"],
        ["$sched_boost", "0"]
      ],
      "common_app": [
        ["@cpuset", "0-1", "0-6", "2-7", "2-7"],
        ["/dev/cpuset/sf/cpus", "#2-6"],
        ["@values", "latency", "0", "2000", "0", "2000", "0", "2000", "0", "2000"],
        ["/sys/devices/system/cpu/bus_dcvs/DDRQOS/boost_freq", "0"],
        ["/sys/devices/system/cpu/bus_dcvs/LLCC/240b7400.qcom,bwmon-llcc/max_freq", "806000"],
        ["$mod_percent", "105"]
      ],
      "common_gaming": [
        ["@preset", "common_active"],
        ["@limiter", "NONE"],
        ["@cpuset", "0-1", "0-3,5-6", "0-3,5-6", "0-7"],
        ["/dev/cpuset/sf/cpus", "#2-3"],
        ["$sched_boost", "0"],
        ["/sys/devices/system/cpu/bus_dcvs/DDRQOS/boost_freq", "#1"],
        ["$mod_percent", "95"]
      ],

      "powersave_active": [
        ["@preset", "common_active"],
        ["@target_loads",
          "82 1574400:92",
          "82 960000:87 1612800:92",
          "82 960000:87 1612800:92",
          "82 902400:87 1708800:92"],
        ["@limiter", "p1"],
        ["@hispeed_freq", "0", "844800", "844800", "844800"]
      ],
      "powersave_inactive": [
        ["@preset", "common_inactive"],
        ["@preset", "cpu7_off"],
        ["@target_loads",
          "85 1017600:90",
          "85 960000:90 1612800:95",
          "85 960000:90 1612800:95",
          "85 902400:90 1593600:95"],
        ["@limiter", "idle"],
        ["@hispeed_freq", "0", "0", "0", "0"]
      ],

      "balance_active": [
        ["@preset", "common_active"],
        ["@cpu_freqs_min", "^787200", "^729600", "^729600", "^787200"],
        ["@target_loads",
          "80 1574400:90",
          "80 1708800:85 2131200:90",
          "80 1708800:85 2131200:90",
          "80 1708800:85 2112000:90"],
        ["@limiter", "p2"],
        ["@hispeed_freq", "0", "960000", "960000", "960000"]
      ],
      "balance_inactive": [
        ["@preset", "common_inactive"],
        ["@preset", "cpu7_auto"],
        ["@target_loads",
          "85 1017600:90",
          "85 960000:90 1612800:95",
          "85 960000:90 1612800:95",
          "85 902400:90 1593600:95"],
        ["@limiter", "inactive"],
        ["@hispeed_freq", "0", "729600", "729600", "787200"],
        ["@preset", "cpu7_off"]
      ],

      "performance_active": [
        ["@preset", "common_active"],
        ["@target_loads",
          "80 1574400:90",
          "80 1708800:85 2131200:90",
          "80 1708800:85 2131200:90",
          "80 1708800:85 2112000:90"],
        ["@limiter", "p3"],
        ["@cpu_freqs_min", "^787200", "^844800", "^844800", "^902400"],
        ["@hispeed_freq", "0", "1075200", "1075200", "1017600"]
      ],
      "performance_inactive": [
        ["@preset", "common_inactive"],
        ["@target_loads",
          "85 1017600:90",
          "83 960000:85 1708800:90",
          "83 960000:85 1708800:90",
          "83 902400:85 1708800:90"],
        ["@limiter", "p1"],
        ["@hispeed_freq", "0", "844800", "844800", "844800"]
      ],

      "fast_active": [
        ["@preset", "common_active"],
        ["@target_loads",
          "80 1689600:85",
          "80 2131200:85",
          "80 2131200:85",
          "80 2112000:85"],
        ["@limiter", "p4"],
        ["@cpu_freqs_min", "^902400", "^960000", "^960000", "^902400"],
        ["@hispeed_freq", "0", "1075200", "1286400", "1248000"]
      ],
      "fast_inactive": [
        ["@preset", "common_inactive"],
        ["@target_loads",
          "85 1689600:90",
          "83 1708800:87 2131200:95",
          "83 1708800:87 2131200:95",
          "83 1708800:87 2112000:95"],
        ["@limiter", "p2"],
        ["@hispeed_freq", "0", "844800", "844800", "844800"]
      ]
    },
    "schemes": {
      "powersave": {
        "app": [
          ["@preset", "common_app"],
          ["@preset", "powersave_active"]
        ]
      },
      "balance": {
        "app": [
          ["@preset", "common_app"],
          ["@preset", "balance_active"]
        ]
      },
      "performance": {
        "app": [
          ["@preset", "common_app"],
          ["@preset", "performance_active"]
        ]
      },
      "fast": {
        "app": [
          ["@preset", "common_app"],
          ["@preset", "fast_active"]
        ]
      }
    },
    "apps": [
      {
        "friendly": "ELP",
        "packages": [
          "com.tencent.mobileqq",
          "com.tencent.tim",
          "org.telegram.messenger",
          "Music", "Reader", "ShortVideo", "Nav"
        ],
        "import": "_ELP.json"
      },
      {
        "friendly": "白名单",
        "packages": [
          "com.termux",
          "xyz.chatboxapp.chatbox",
          "com.danemadsen.maid",
          "com.freakurl.apps.ollama",
          "io.github.xororz.localdream"
        ],
        "import": "_WhiteList.json"
      },
      { "friendly": "相机", "packages": ["Camera"], "import": "_Camera.json" },
      { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
    ],
    "games": [
      {
        "friendly": "All",
        "packages": ["*"],
        "import": "_Games.json"
      }
    ]
  }