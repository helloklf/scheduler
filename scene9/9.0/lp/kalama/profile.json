{
  "platform": "kalama",
  "platform_name": "8GEN2",
  "alias": {
    "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "bus_ddr_min": "/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/min_freq",
    "bus_ddr": "/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/max_freq",
    "l3_boost": "/sys/devices/system/cpu/bus_dcvs/L3/boost_freq",
    "ddr_boost": "/sys/devices/system/cpu/bus_dcvs/DDR/boost_freq",
    "perfmgr_enable": "/sys/module/perfmgr/parameters/perfmgr_enable"
  },
  "features": {
    "limiter": {
      "limiters": {
        "p1": {
          "cpus": [
            { "max": 1555200, "min": 556800, "margins": "150", "excludes": [1] },
            { "max": 1785600, "min": 614400, "margins": "220" },
            { "max": 1977600, "min": 729600, "margins": "220" }
          ]
        },
        "p2": {
          "cpus": [
            { "max": 1555200, "min": 787200,  "margins": "300" },
            { "max": 2188800, "min": 1651200, "margins": "250 1920000:120" },
            { "max": 2342400, "min": 1708800, "margins": "250 2092800:120" }
          ]
        },
        "p3": {
          "cpus": [
            { "max": 1670400, "min": 902400, "margins": "300" },
            { "max": 2457600, "min": 2054400, "margins": "300" },
            { "max": 2726400, "min": 2092800, "margins": "300" }
          ]
        },
        "p4": {
          "cpus": [
            { "max": 1804800, "min": 1228800, "margins": "300" },
            { "max": 2803200, "min": 2323200, "margins": "300" },
            { "max": 2995200, "min": 2476800, "margins": "300" }
          ]
        },
        "inactive": {
          "cpus": [
            { "max": 1555200, "min": 556800, "margins": "100" },
            { "max": 1785600, "min": 614400, "margins": "120" },
            { "max": 1843200, "min": 729600, "margins": "120" }
          ]
        },
        "idle": {
          "cpus": [
            { "max": 1555200, "min": 556800, "margins": "90" },
            { "max": 1651200, "min": 614400, "margins": "90" },
            { "max": 1708800, "min": 729600, "margins": "90" }
          ]
        }
      }
    }
  },
  "reset": [
    ["@msm_reset"],
    ["$bus_ddr_min", "547000"],
    ["$l3_boost", "0"],
    ["$ddr_boost", "0"],
    ["@governor", "uag", "walt"]
  ],
  "presets": {
    "latency": [
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy3/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy3/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us"]
    ],
    "cpu7_on": [
      ["$core_ctl_7", "1"],
      ["$max_cpus_cpu7", "#1"],
      ["$min_cpus_cpu7", "#1"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_off": [
      ["$core_ctl_7", "1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#0"]
    ],
    "common_active": [
      ["@preset", "cpu7_on"],
      ["@values", "latency", "1000", "1000", "1000", "1000", "1000", "1000"],
      ["/dev/cpuset/sf/cpus", "3-6"]
    ],
    "common_inactive": [
      ["@values", "latency", "1000", "2000", "1000", "2000", "1000", "2000"],
      ["@cpu_freqs_min", "#307200", "#499200", "#595200"],
      ["@hispeed_load", "90", "90", "90"],
      ["/dev/cpuset/sf/cpus", "0-6"],
      ["$sched_boost", "#0"]
    ],
    "common_app": [
      ["$perfmgr_enable", "0"],
      ["@cpuset", "0-2", "0-6", "0-6", "0-7"],
      ["$mod_percent", "110"]
    ],
    "common_gaming": [
      ["@limiter", "NONE"],
      ["@cpuset", "0-2", "0-5", "0-5", "0-7"],
      ["/dev/cpuset/sf/cpus", "3-5"],
      ["$sched_boost", "#0"],
      ["@values", "latency", "2000", "2000", "2000", "2000", "2000", "2000"],
      ["$mod_percent", "100"]
    ],

    "ddr_max": [
      ["@values", "ddr", "2736000", "1555000", "4224000", "4224000", "4224000", "1555000"]
    ],
    "ddr_low": [
      ["@values", "ddr", "2736000", "1555000", "2736000", "2736000", "2736000", "1555000"]
    ],
    "ddr_mid": [
      ["@values", "ddr", "2736000", "1555000", "3187000", "3187000", "3187000", "1555000"]
    ],
    "ddr": [
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/max_freq", "2736000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:gold-compute/max_freq", "1555000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:gold/max_freq", "4224000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:prime-latfloor/max_freq", "4224000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:prime/max_freq", "4224000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:silver/max_freq", "1555000"]
    ],
    "powersave_active": [
      ["@preset", "common_active"],
      ["@limiter", "p1"],
      ["@hispeed_freq", "787200", "844800", "864000"],
      ["@hispeed_load", "85", "85", "85"]
    ],
    "powersave_inactive": [
      ["@preset", "common_inactive"],
      ["@preset", "cpu7_off"],
      ["@limiter", "idle"],
      ["@hispeed_freq", "0", "0", "0"]
    ],

    "balance_active": [
      ["@preset", "common_active"],
      ["@limiter", "p2"],
      ["@hispeed_freq", "1075200", "1056000", "1132800"],
      ["@hispeed_load", "87", "87", "87"]
    ],
    "balance_inactive": [
      ["@preset", "common_inactive"],
      ["@limiter", "inactive"],
      ["@hispeed_freq", "787200", "844800", "864000"]
    ],

    "performance_active": [
      ["@preset", "common_active"],
      ["@limiter", "p3"],
      ["@hispeed_freq", "1075200", "1401600", "1478400"],
      ["@hispeed_load", "85", "85", "85"]
    ],
    "performance_inactive": [
      ["@preset", "common_inactive"],
      ["@limiter", "p1"],
      ["@hispeed_freq", "1075200", "1056000", "1132800"]
    ],

    "fast_active": [
      ["@preset", "common_active"],
      ["@limiter", "p4"],
      ["@hispeed_freq", "1017600", "1555200", "1651200"],
      ["@hispeed_load", "82", "82", "82"]
    ],
    "fast_inactive": [
      ["@preset", "common_inactive"],
      ["@limiter", "p2"],
      ["@hispeed_freq", "1075200", "1056000", "1132800"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "powersave_active"],
        ["@preset", "ddr_mid"],
        ["$bus_ddr", "2736000"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "balance_active"],
        ["$bus_ddr", "3187000"],
        ["@preset", "ddr_max"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "performance_active"],
        ["$bus_ddr", "3187000"],
        ["@preset", "ddr_max"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["$bus_ddr", "2736000"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "fast_active"],
        ["@preset", "ddr_max"],
        ["$bus_ddr", "3187000"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    }
  },
  "apps": [
    {
      "friendly": "ELP",
      "packages": [
        "IM", "Music", "Reader", "ShortVideo", "Nav", "ScrollOpt"
      ],
      "import": "_ELP.json"
    },
    { "friendly": "相机", "packages": ["Camera"], "import": "_Camera.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}