{
  "platform": "taro",
  "platform_name": "8+GEN1",
  "alias": {
    "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
    "mod_percent": "/sys/class/kgsl/kgsl-3d0/devfreq/mod_percent",
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "bus_ddr_min": "/sys/devices/system/cpu/bus_dcvs/DDR/19091000.qcom,bwmon-ddr/min_freq",
    "bus_ddr": "/sys/devices/system/cpu/bus_dcvs/DDR/19091000.qcom,bwmon-ddr/max_freq",
    "l3_boost": "/sys/devices/system/cpu/bus_dcvs/L3/boost_freq",
    "ddr_boost": "/sys/devices/system/cpu/bus_dcvs/DDR/boost_freq",
    "memlat_low": "/sys/devices/system/cpu/bus_dcvs/DDR/memlat",
    "perfmgr_enable": "/sys/module/perfmgr/parameters/perfmgr_enable",
    "bus_qos": "/sys/devices/system/cpu/bus_dcvs/DDRQOS/boost_freq",
    "tchg": "/proc/touchpanel/game_switch_enable"
  },
  "features": {
    "limiter": {
      "l3_boost": true,
      "ddr_boost": true,
      "limiters": {
        "p1": {
          "cpus": [
            { "step":   -1, "max": 1555200, "min": 691200, "margins": "250 1228800:125", "excludes": [1] },
            { "max": 2112000, "min": 768000, "margins": "250 1766400:135" },
            { "max": 2246400, "min": 787200, "margins": "270 1766400:135" }
          ]
        },
        "p2": {
          "cpus": [
            { "max": 1555200, "min": 1056000, "margins": "280" },
            { "max": 2457600, "min": 1766400, "margins": "280" },
            { "max": 2476800, "min": 1766400, "margins": "280" }
          ]
        },
        "p3": {
          "cpus": [
            { "max": 1670400, "min": 1440000, "margins": "280" },
            { "max": 2572800, "min": 2342400, "margins": "280" },
            { "max": 2707200, "min": 2361600, "margins": "280" }
          ]
        },
        "p4": {
          "cpus": [
            { "max": 1804800, "min": 1574400, "margins": "200" },
            { "max": 2745600, "min": 2572800, "margins": "200" },
            { "max": 2995200, "min": 2592000, "margins": "200" }
          ]
        },
        "inactive": {
          "core_ctl": [2],
          "cpus": [
            { "max": 1555200, "min": 556800, "margins": "120" },
            { "max": 1651200, "margins": "130" },
            { "max": 1766400, "margins": "140" }
          ]
        },
        "idle": {
          "core_ctl": [2],
          "cpus": [
            { "max": 1555200, "min": 441600, "margins": "80" },
            { "max": 1651200, "margins": "80" },
            { "max": 1766400, "margins": "80" }
          ]
        }
      }
    },
    "gesture_boost": {
      "enable": false,
      "enter": [
      ],
      "exit": [
      ]
    }
  },
  "reset": [
    ["@msm_reset"],
    ["$bus_ddr_min", "547000"],
    ["$l3_boost", "0"],
    ["$ddr_boost", "0"],
    ["@governor", "uag", "walt"],
    ["@values", "latency", "0", "2000", "0", "2000", "0", "2000"],
    ["@hispeed_load", "90", "90", "90"]
  ],
  "presets": {
    "latency": [
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy4/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy4/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us"]
    ],
    "cpu7_on": [
      ["$core_ctl_7", "#1"],
      ["$max_cpus_cpu7", "#1"],
      ["$min_cpus_cpu7", "#1"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_off": [
      ["$core_ctl_7", "#1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#0"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_auto": [
      ["$core_ctl_7", "#1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#1"]
    ],
    "limiter_off": [
      ["/proc/game_opt/disable_cpufreq_limit", "#1"],
      ["/sys/module/migt/parameters/glk_disable", "#1"],
      ["/sys/module/perfmgr/parameters/perfmgr_enable", "#0"]
    ],
    "limiter_on": [
      ["/proc/game_opt/disable_cpufreq_limit", "0"],
      ["/sys/module/migt/parameters/glk_disable", "0"]
    ],
    "common_active": [
      ["@preset", "cpu7_on"]
    ],
    "common_inactive": [
      ["@cpu_freqs_min", "#307200", "#633600", "#787200"],
      ["$sched_boost", "0"],
      ["@hispeed_load", "90", "90", "90"]
    ],
    "common_app": [
      ["$perfmgr_enable", "0"],
      ["@cpuset", "0-3", "0-6", "0-7", "0-7"],
      ["$gpu_max_khz", "#680000000"],
      ["$mod_percent", "105"],
      ["$bus_qos", "0"]
    ],
    "common_gaming": [
      ["@limiter", "NONE"],
      ["@cpuset", "0-3", "0-3", "0-5", "0-7"],
      ["$gpu_max_khz", "#990000000"],
      ["$bus_qos", "0"],
      ["/proc/game_opt/disable_cpufreq_limit", "0"],
      ["$mod_percent", "95"],
      ["@gesture", "PAUSE"]
    ],

    "powersave_active": [
      ["@preset", "common_active"],
      ["@target_loads",
        "82 1555200:90",
        "82 998400:85 1766400:90",
        "82 1171200:85 1881600:90"
      ],
      ["@limiter", "p1"],
      ["@hispeed_freq", "1228800", "1113600", "1171200"]
    ],
    "powersave_inactive": [
      ["@preset", "common_inactive"],
      ["@preset", "cpu7_off"],
      ["@target_loads",
        "85 1017600:90",
        "85 998400:90 1440000:95",
        "85 1171200:90 1536000:95"
      ],
      ["@limiter", "idle"],
      ["@hispeed_freq", "0", "0", "0"]
    ],

    "balance_active": [
      ["@preset", "common_active"],
      ["@target_loads",
        "80 1555200:90",
        "80 1651200:85 1996800:90",
        "80 1766400:85 2131200:90"
      ],
      ["@limiter", "p2"],
      ["@hispeed_freq", "1228800", "1555200", "1651200"]
    ],
    "balance_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1017600:90",
        "85 998400:90 1440000:95",
        "85 1171200:90 1536000:95"
      ],
      ["@limiter", "inactive"],
      ["@preset", "cpu7_auto"],
      ["@hispeed_freq", "691200", "633600", "787200"]
    ],

    "performance_active": [
      ["@preset", "common_active"],
      ["@target_loads",
        "80 1555200:90",
        "80 1881600:85 2112000:90",
        "80 1843200:85 2361600:90"
      ],
      ["@limiter", "p3"],
      ["@hispeed_freq", "1228800", "1555200", "1651200"]
    ],
    "performance_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1017600:90",
        "85 998400:90 1651200:95",
        "85 1171200:90 1651200:95"
      ],
      ["@limiter", "p2"],
      ["@hispeed_freq", "1075200", "1324800", "1286400"]
    ],

    "fast_active": [
      ["@preset", "common_active"],
      ["@target_loads",
        "80 1670400:85",
        "80 2188800:85",
        "80 2227200:85"
      ],
      ["@limiter", "p4"],
      ["@hispeed_freq", "1228800", "1555200", "1651200"]
    ],
    "fast_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1670400:90",
        "80 1766400:87 1996800:95",
        "80 1766400:87 1996800:95"
      ],
      ["@limiter", "p3"],
      ["@hispeed_freq", "1171200", "1440000", "1497600"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "powersave_active"],
        ["$bus_ddr", "2736000"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@hispeed_freq", "1056000", "0", "0"],
        ["@cpu_freqs_min", "307200", "633600", "787200"],
        ["@cpu_freqs_max", "1670400", "1996800", "2131200"],
        ["$l3_boost", "#0"],
        ["$tchg", "#0"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "balance_active"],
        ["$bus_ddr", "2736000"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@hispeed_freq", "1228800", "1113600", "1171200"],
        ["@cpu_freqs_min", "307200", "633600", "787200"],
        ["@cpu_freqs_max", "1670400", "2457600", "2476800"],
        ["$l3_boost", "#0"],
        ["$tchg", "#0"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "performance_active"],
        ["$bus_ddr", "2736000"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@cpu_freqs_min", "307200", "633600", "787200"],
        ["@cpu_freqs_max", "1804800", "2572800", "2707200"],
        ["$l3_boost", "#0"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "fast_active"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["$bus_ddr", "3196000"]
      ],
      "game": [
        ["$perfmgr_enable", "#0"],
        ["$l3_boost", "#1804800"],
        ["@preset", "common_gaming"],
        ["$bus_ddr", "3196000"],
        ["$bus_ddr_min", "2736000"],
        ["@cpu_freqs_min", "1056000", "998400", "1171200"],
        ["@cpu_freqs_max", "1804800", "2745600", "2995200"]
      ]
    }
  },
  "apps": [
    {
      "friendly": "ELP",
      "packages": [
        "com.tencent.mobileqq",
        "com.tencent.tim",
        "org.telegram.messenger",
        "Music", "Reader", "ShortVideo", "Nav"
      ],
      "import": "_ELP.json"
    },
    { "friendly": "相机", "packages": ["Camera"], "import": "_Camera.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}