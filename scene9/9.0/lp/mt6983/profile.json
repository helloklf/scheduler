{
  "platform": "mt6983",
  "platform_name": "D9000",
  "alias": {
    "gpu_freq": "/sys/kernel/ged/hal/custom_upbound_gpu_freq",
    "gpu_min_opp": "/sys/kernel/ged/hal/custom_boost_gpu_freq",
    "boost_affinity": "/sys/module/mtk_fpsgo/parameters/boost_affinity",
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "ddr_freq_min": "/sys/class/devfreq/mtk-dvfsrc-devfreq/min_freq",
    "ddr_freq_cust": "/sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq",
    "ged_kpi": "/sys/module/sspm_v3/holders/ged/parameters/is_GED_KPI_enabled",
    "fpsgo": "/sys/kernel/fpsgo/common/fpsgo_enable",
    "cpufreq": "/proc/cpudvfs/cpufreq_debug",
    "ddr_force_opp": "/sys/devices/platform/1c00f000.dvfsrc/1c00f000.dvfsrc:dvfsrc-helper/dvfsrc_force_vcore_dvfs_opp",
    "perfmgr_enable": "/sys/module/mtk_fpsgo/parameters/perfmgr_enable",
    "ddr_max": "/sys/class/devfreq/mtk-dvfsrc-devfreq/max_freq",
    "dcs": "/sys/kernel/ged/hal/dcs_mode"
  },
  "features": {
    "limiter": {
      "ddr_boost": true,
      "limiters": {
        "p1": {
          "cpus": [
            { "max": 1400000, "min": 500000, "margins": "200 1200:120", "excludes": [1] },
            { "max": 2100000, "min": 700000, "margins": "350 1600:200" },
            { "max": 2100000, "min": 1300000, "margins": "350 1600:200" }
          ]
        },
        "p2": {
          "cpus": [
            { "max": 1500000, "min": 800000, "margins": "250 1200:150" },
            { "max": 2400000, "min": 1600000, "margins": "300 2100:150" },
            { "max": 2400000, "min": 1800000, "margins": "300 2100:150" }
          ]
        },
        "p3": {
          "cpus": [
            { "max": 1800000, "min": 1200000, "margins": "270 1500:100" },
            { "max": 2650000, "min": 1900000, "margins": "300 2300:150" },
            { "max": 2650000, "min": 2100000, "margins": "300 2400:150" }
          ]
        },
        "p4": {
          "cpus": [
            { "max": 1800000, "min": 1500000, "margins": "300" },
            { "max": 2800000, "min": 2300000, "margins": "300 2650:150" },
            { "max": 2800000, "min": 2300000, "margins": "300 2650:150" }
          ]
        },
        "inactive": {
          "core_ctl": [2],
          "cpus": [
            { "max": 1600000, "min": 400000, "margins": "80" },
            { "max": 2100000, "min": 400000, "margins": "100" },
            { "max": 2100000, "min": 1300000, "margins": "100" }
          ]
        },
        "idle": {
          "core_ctl": [2],
          "cpus": [
            { "max": 1200000, "min": 400000, "margins": "50" },
            { "max": 1800000, "min": 400000, "margins": "60" },
            { "max": 1800000, "min": 1300000, "margins": "70" }
          ]
        }
      }
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
        ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "28"],
        ["$ddr_freq_cust", "4266000000"]
      ],
      "exit": [
        ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"],
        ["$ddr_freq_cust", "#0"]
      ]
    }
  },
  "reset": [
    ["@mtk_reset"],
    ["@governor", "schedutil"],
    ["$boost_affinity", "#0"],
    ["$ddr_force_opp", "999"],
    ["$ddr_freq_cust", "0"],
    ["$ddr_max", "#5500000000"]
  ],
  "presets": {
    "min_freq": [
      ["$cpu_min_0"], ["$cpu_min_4"], ["$cpu_min_7"]
    ],
    "max_freq": [
      ["$cpu_max_0"], ["$cpu_max_4"], ["$cpu_max_7"]
    ],
    "cpu7_on": [
      ["$core_ctl_7", "#1"],
      ["$max_cpus_cpu7", "#1"],
      ["$min_cpus_cpu7", "#1"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_off": [
      ["$core_ctl_7", "#1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#0"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_auto": [
      ["$core_ctl_7", "#1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#1"]
    ],
    "common_active": [
      ["@preset", "cpu7_on"]
    ],
    "common_inactive": [
      ["$gpu_min_opp", "99"]
    ],
    "common_app": [
      ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_enable 0|cm_mgr_perf_enable 0|dsu_mode 0"],
      ["/sys/kernel/ged/hal/custom_upbound_gpu_freq", "#18"],
      ["@cpuset", "0-3", "0-6", "0-7", "0-7"]
    ],
    "common_gaming": [
      ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_enable 1|cm_mgr_perf_enable 1|dsu_mode 1"],
      ["@limiter", "NONE"],
      ["/sys/kernel/ged/hal/custom_upbound_gpu_freq", "#0"],
      ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"],
      ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "0"],
      ["@cpuset", "0-3", "0-5", "0-5", "0-7"],
      ["$gpu_freq", "0"]
    ],

    "powersave_active": [
      ["@limiter", "p1"],
      ["@preset", "common_active"],
      ["$ddr_freq_min", "#1866000000"],
      ["@values", "min_freq", "400000", "700000", "1300000"]
    ],
    "powersave_inactive": [
      ["@limiter", "idle"],
      ["@values", "min_freq", "200000", "400000", "1300000"],
      ["@preset", "common_inactive"],
      ["$ddr_freq_min", "#800000000"],
      ["@preset", "cpu7_off"]
    ],
    "balance_active": [
      ["@limiter", "p2"],
      ["@preset", "common_active"],
      ["$ddr_freq_min", "#2667000000"],
      ["@values", "min_freq", "500000", "700000", "1300000"]
    ],
    "balance_inactive": [
      ["@limiter", "inactive"],
      ["@values", "min_freq", "200000", "400000", "1300000"],
      ["@preset", "common_inactive"],
      ["$ddr_freq_min", "#800000000"]
    ],
    "performance_active": [
      ["@limiter", "p3"],
      ["@values", "min_freq", "700000", "900000", "1300000"],
      ["@preset", "common_active"],
      ["$ddr_freq_min", "#2667000000"]
    ],
    "performance_inactive": [
      ["@limiter", "NONE"],
      ["@preset", "common_inactive"],
      ["$ddr_freq_min", "#800000000"],
      ["@cpu_freq", "cpu0", "200000", "1400000"],
      ["@cpu_freq", "cpu4", "400000", "2300000"],
      ["@cpu_freq", "cpu7", "1300000", "2300000"]
    ],
    "fast_active": [
      ["@limiter", "p4"],
      ["@preset", "common_active"],
      ["$ddr_freq_min", "#3200000000"],
      ["@values", "min_freq", "1000000", "1000000", "1300000"]
    ],
    "fast_inactive": [
      ["@limiter", "NONE"],
      ["@preset", "common_inactive"],
      ["$ddr_freq_min", "#1866000000"],
      ["@cpu_freq", "cpu0", "500000", "1800000"],
      ["@cpu_freq", "cpu4", "700000", "2650000"],
      ["@cpu_freq", "cpu7", "1300000", "2650000"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "powersave_active"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["$gpu_freq", "#20"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@values", "min_freq", "400000", "400000", "1300000"],
        ["@values", "max_freq", "#1500000", "#1900000", "#1900000"],
        ["$ddr_freq_min", "#1866000000"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "balance_active"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["$gpu_freq", "#15"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@values", "min_freq", "700000", "700000", "1300000"],
        ["@values", "max_freq", "#1600000", "#2450000", "#2400000"],
        ["$ddr_freq_min", "#1866000000"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "performance_active"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["$gpu_freq", "#10"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@values", "min_freq", "800000", "1000000", "1300000"],
        ["@values", "max_freq", "#1600000", "#2650000", "#2800000"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "fast_active"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["$gpu_freq", "#10"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@values", "min_freq", "1000000", "1000000", "1300000"],
        ["@values", "max_freq", "#1800000", "#2850000", "#3000000"],
        ["$ddr_freq_min", "#2667000000"]
      ]
    }
  },
  "apps": [
    {
      "friendly": "ELP",
      "packages": [
        "com.tencent.mobileqq",
        "com.tencent.tim",
        "org.telegram.messenger"
      ],
      "categories": ["Music", "Reader", "ShortVideo", "Nav"],
      "import": "_ELP.json"
    },
    { "friendly": "扫码", "categories": ["Scanner"], "import": "_Scanner.json" },
    { "friendly": "相机", "categories": ["Camera"], "import": "_Camera.json" },
    { "friendly": "待机", "packages": ["standby"], "import": "_Standby.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_FAS.json"
    }
  ]
}