{
  "friendly": "相机",
  "limiters": {
    "camera": {
      "mode": "bottom",
      "cpus": [
        { "max": 2000000, "margins": "220 1500000:120" },
        { "max": 2100000, "margins": "220 1700000:120" },
        { "max": 2300000, "margins": "220 1700000:120" }
      ]
    }
  },
  "call": [
    ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_enable 1|cm_mgr_perf_enable 1|dsu_mode 1"],
    ["@limiter", "camera"]
  ]
}