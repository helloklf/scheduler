{
    "platform": "sun",
    "platform_name": "8GEN4",
    "alias": {
      "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
      "mod_percent": "/sys/class/kgsl/kgsl-3d0/devfreq/mod_percent",
      "max_cpus_cpu0": "/sys/devices/system/cpu/cpu0/core_ctl/max_cpus",
      "min_cpus_cpu0": "/sys/devices/system/cpu/cpu0/core_ctl/min_cpus",
      "max_cpus_cpu6": "/sys/devices/system/cpu/cpu6/core_ctl/max_cpus",
      "min_cpus_cpu6": "/sys/devices/system/cpu/cpu6/core_ctl/min_cpus",
      "core_ctl_0": "/sys/devices/system/cpu/cpu0/core_ctl/enable",
      "core_ctl_6": "/sys/devices/system/cpu/cpu6/core_ctl/enable",
      "perfmgr_enable": "/sys/module/perfmgr/parameters/perfmgr_enable",
      "cpu_min_6": "/sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq",
      "cpu_max_6": "/sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq",
      "cpu_min_0": "/sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq",
      "cpu_max_0": "/sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq",
      "sched_boost": "/proc/sys/walt/sched_boost",
      "glk_disable": "/sys/module/migt/parameters/glk_disable",
      "input_boost": "/proc/sys/walt/input_boost/sched_boost_on_input"
    },
    "features": {
      "limiter": {
        "ddr_boost": false,
        "limiters": {
          "p1": {
            "core_ctl": [0, 1],
            "cpus": [
              { "max": 1785600, "min": 748800,  "margins": "150 1152000:90", "excludes": [0], "prefer": 1 },
              { "max": 1958400, "min": 1017600, "margins": "150 1209600:100" }
            ]
          },
          "p2": {
            "cpus": [
              { "max": 1996800, "min": 960000,  "margins": "200 1555200:130", "excludes": [0] },
              { "max": 2438400, "min": 1017600, "margins": "200 1689600:130" }
            ]
          },
          "p3": {
            "cpus": [
              { "max": 2400000, "min": 1152000, "margins": "200 1785600:130" },
              { "max": 2841600, "min": 1209600, "margins": "200 1958400:130" }
            ]
          },
          "inactive": {
            "core_ctl": [0, 1],
            "cpus": [
              { "max": 1785600, "min": 556800,  "margins": "120 960000:90", "excludes": [0] },
              { "max": 1958400, "min": 1017600, "margins": "120 1689600:90" }
            ]
          },
          "idle": {
            "core_ctl": [0, 1],
            "cpus": [
              { "max": 1555200, "min": 556800,  "margins": "100 960000:80",
                "excludes": [0] },
              { "max": 1689600, "min": 1017600, "margins": "100 1689600:80" }
            ]
          }
        }
      },
      "gesture_boost": {
        "enable": true,
        "enter": [
          ["$cpu_max_0", "^1996800"],
          ["$cpu_max_6", "^2438400"]
        ],
        "exit": [
        ]
      }
    },
    "reset": [
      ["@msm_reset"],
      ["@governor", "walt"]
    ],
    "presets": {
      "latency": [
        ["/sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy6/walt/down_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy6/walt/up_rate_limit_us"]
      ],
      "target_loads": [
        ["/sys/devices/system/cpu/cpu0/cpufreq/walt/target_loads"],
        ["/sys/devices/system/cpu/cpu6/cpufreq/walt/target_loads"]
      ],
      "cpu6_on": [
        ["$core_ctl_0", "1"],
        ["$max_cpus_cpu0", "#6"],
        ["$min_cpus_cpu0", "#6"],
        ["$core_ctl_0", "0"],
        ["$core_ctl_6", "1"],
        ["$max_cpus_cpu6", "#2"],
        ["$min_cpus_cpu6", "#2"],
        ["$core_ctl_6", "#0"]
      ],
      "cpu6_off": [
        ["$core_ctl_6", "1"],
        ["$min_cpus_cpu6", "#0"],
        ["$max_cpus_cpu6", "#0"]
      ],
      "cpu6_auto": [
        ["$core_ctl_6", "1"],
        ["$min_cpus_cpu6", "#0"],
        ["$max_cpus_cpu6", "#2"]
      ],
      "limiter_off": [
        ["/proc/game_opt/disable_cpufreq_limit", "#1"],
        ["/sys/module/migt/parameters/glk_disable", "#1"],
        ["/sys/module/perfmgr/parameters/perfmgr_enable", "#0"],
        ["/sys/module/migt/parameters/glk_freq_limit_walt", "#0"]
      ],
      "limiter_on": [
        ["/proc/game_opt/disable_cpufreq_limit", "0"],
        ["/sys/module/migt/parameters/glk_disable", "0"]
      ],
      "common_active": [
      ],
      "common_inactive": [
        ["@cpu_freqs_min", "0", "0"],
        ["$sched_boost", "0"]
      ],
      "common_app": [
        ["$perfmgr_enable", "0"],
        ["@cpuset", "0-3", "0-5", "0-7", "0-7"],
        ["@values", "latency", "0", "1000", "0", "1000"],
        ["$mod_percent", "105"]
      ],
      "common_gaming": [
        ["@preset", "common_active"],
        ["@limiter", "NONE"],
        ["@cpuset", "0-1", "0-3", "0-4", "0-7"],
        ["$sched_boost", "0"],
        ["@values", "latency", "0", "2000", "0", "2000"],
        ["$mod_percent", "100"],
        ["@preset", "cpu6_on"]
      ],

      "powersave_active": [
        ["@preset", "common_active"],
        ["@cpu_freqs_min", "556800", "1017600"],
        ["@target_loads",
          "82 1152000:85 1363200:90",
          "82 1209600:85 1689600:90"],
        ["@hispeed_freq", "748800", "0"],
        ["@limiter", "p1"]
      ],
      "powersave_inactive": [
        ["@preset", "common_inactive"],
        ["@preset", "cpu6_off"],
        ["@target_loads",
          "85 1152000:90",
          "85 1209600:90 1689600:95"],
        ["@hispeed_freq", "0", "0"],
        ["@limiter", "idle"]
      ],

      "balance_active": [
        ["@preset", "common_active"],
        ["@cpu_freqs_min", "556800", "1017600"],
        ["@target_loads",
          "80 1152000:85 1555200:90",
          "80 1689600:85 1958400:90"],
        ["@hispeed_freq", "748800", "0"],
        ["@preset", "cpu6_on"],
        ["@limiter", "p2"]
      ],
      "balance_inactive": [
        ["@preset", "common_inactive"],
        ["@preset", "cpu6_auto"],
        ["@target_loads",
          "85 1152000:90",
          "85 1209600:90 1689600:95"],
        ["@hispeed_freq", "0", "0"],
        ["@limiter", "inactive"]
      ],

      "performance_active": [
        ["@preset", "common_active"],
        ["@cpu_freqs_min", "748800", "1017600"],
        ["@target_loads",
          "80 1555200:85 2227200:95",
          "80 1958400:85 2841600:90 3283200:95"],
        ["@hispeed_freq", "1152000", "0"],
        ["@preset", "cpu6_on"],
        ["@limiter", "p3"]
      ],
      "performance_inactive": [
        ["@preset", "common_inactive"],
        ["@target_loads",
          "83 1555200:90",
          "83 1958400:87 2438400:93"],
        ["@hispeed_freq", "960000", "1017600"],
        ["@limiter", "inactive"]
      ],

      "fast_active": [
        ["@preset", "common_active"],
        ["@cpu_freqs_min", "960000", "1017600"],
        ["@target_loads",
          "78 1996800:83 2400000:87 2745600:95",
          "78 2246400:83 2841600:87 3513600:95"],
        ["@hispeed_freq", "1152000", "1017600"],
        ["@preset", "cpu6_on"]
      ],
      "fast_inactive": [
        ["@target_loads",
          "80 1996800:87 2400000:95",
          "80 2246400:87 2841600:95"],
        ["@hispeed_freq", "1152000", "1017600"]
      ]
    },
    "schemes": {
      "powersave": {
        "call": [
          ["/sys/devices/system/cpu/cpufreq/boost", "0"]
        ],
        "app": [
          ["@preset", "common_app"],
          ["@cpu_freqs_max", "1785600", "#1958400"],
          ["@preset", "powersave_active"]
        ],
        "game": [
          ["@preset", "common_gaming"],
          ["@preset", "limiter_on"],
          ["@hispeed_freq", "1152000", "0"]
        ]
      },
      "balance": {
        "app": [
          ["@preset", "common_app"],
          ["@cpu_freqs_max", "1996800", "#2246400"],
          ["@preset", "balance_active"]
        ],
        "game": [
          ["@preset", "common_gaming"],
          ["@preset", "limiter_on"],
          ["@hispeed_freq", "1152000", "1017600"]
        ]
      },
      "performance": {
        "app": [
          ["@preset", "common_app"],
          ["@cpu_freqs_max", "2400000", "#2841600"],
          ["@preset", "performance_active"]
        ],
        "game": [
          ["@preset", "common_gaming"],
          ["@preset", "limiter_off"],
          ["@hispeed_freq", "1152000", "1017600"]
        ]
      },
      "fast": {
        "app": [
          ["@preset", "common_app"],
          ["@cpu_freqs_max", "2400000", "#3283200"],
          ["@preset", "fast_active"]
        ],
        "game": [
          ["@preset", "common_gaming"],
          ["@preset", "limiter_off"],
          ["@hispeed_freq", "1152000", "1401600"]
        ]
      }
    },
    "apps": [
      {
        "friendly": "ELP",
        "packages": [
          "com.tencent.mobileqq",
          "com.tencent.tim",
          "org.telegram.messenger",
          "Music", "Reader", "ShortVideo", "Nav"
        ],
        "import": "_ELP.json"
      },
      { "friendly": "相机", "packages": ["Camera"], "import": "_Camera.json" },
      { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
    ],
    "games": [
      {
        "friendly": "All",
        "packages": ["*"],
        "import": "_Games.json"
      }
    ]
  }