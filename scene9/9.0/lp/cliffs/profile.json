{
  "platform": "kalama",
  "platform_name": "8GEN2",
  "alias": {
    "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
    "mod_percent": "/sys/class/kgsl/kgsl-3d0/devfreq/mod_percent",
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "bus_ddr_min": "/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/min_freq",
    "bus_ddr": "/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/max_freq",
    "l3_boost": "/sys/devices/system/cpu/bus_dcvs/L3/boost_freq",
    "ddr_boost": "/sys/devices/system/cpu/bus_dcvs/DDR/boost_freq",
    "perfmgr_enable": "/sys/module/perfmgr/parameters/perfmgr_enable",
    "sched_boost": "/proc/sys/walt/sched_boost"
  },
  "features": {
    "limiter": {
      "limiters": {
        "p1": {
          "cpus": [
          { "max": 1593600, "min": 595200, "margins": "100", "mt": 50 },
          { "max": 1920000, "min": 787200, "margins": "200" },
          { "max": 2150400, "min": 960000, "margins": "220" }
          ]
        },
        "p2": {
          "cpus": [
            { "max": 1708800, "min": 787200,  "margins": "300" },
            { "max": 2361600, "min": 1708800, "margins": "300" },
            { "max": 2457600, "min": 1766400, "margins": "300" }
          ]
        },
        "p3": {
          "cpus": [
            { "max": 1900800, "min": 902400,  "margins": "300" },
            { "max": 2611200, "min": 2188800, "margins": "300" },
            { "max": 2803200, "min": 2457600, "margins": "300" }
          ]
        },
        "p4": {
          "cpus": [
            { "max": 1900800, "min": 1228800, "margins": "300" },
            { "max": 2803200, "min": 2361600, "margins": "300" },
            { "max": 2803200, "min": 2457600, "margins": "300" }
          ]
        },
        "inactive": {
          "cpus": [
            { "max": 1593600, "min": 595200, "margins": "100" },
            { "max": 1920000, "min": 633600, "margins": "120" },
            { "max": 1900800, "min": 633600, "margins": "120" }
          ]
        },
        "idle": {
          "cpus": [
            { "max": 1593600, "min": 595200, "margins": "90" },
            { "max": 1708800, "min": 633600, "margins": "90" },
            { "max": 1766400, "min": 633600, "margins": "90" }
          ]
        }
      }
    }
  },
  "reset": [
    ["@msm_reset"],
    ["$bus_ddr_min", "547000"],
    ["$l3_boost", "0"],
    ["$ddr_boost", "0"],
    ["@governor", "uag", "walt"]
  ],
  "presets": {
    "latency": [
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy3/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy3/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us"]
    ],
    "cpu7_on": [
      ["$core_ctl_7", "1"],
      ["$max_cpus_cpu7", "#1"],
      ["$min_cpus_cpu7", "#1"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_off": [
      ["$core_ctl_7", "1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#0"]
    ],
    "cpu7_auto": [
      ["$core_ctl_7", "1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#1"]
    ],
    "common_active": [
      ["@preset", "cpu7_on"],
      ["@values", "latency", "0", "1000", "0", "1000", "0", "1000"],
      ["/dev/cpuset/top-app/sf/cpus", "3-6"]
    ],
    "common_inactive": [
      ["@values", "latency", "0", "2000", "0", "2000", "0", "2000"],
      ["@cpu_freqs_min", "307200", "480000", "480000"],
      ["/dev/cpuset/top-app/sf/cpus", "0-6"],
      ["@hispeed_load", "90", "90", "90"]
    ],
    "common_app": [
      ["$perfmgr_enable", "0"],
      ["@cpuset", "0-2", "0-6", "0-7", "0-7"],
      ["$mod_percent", "105"]
    ],
    "common_gaming": [
      ["@limiter", "NONE"],
      ["@cpuset", "0-2", "0-5", "0-5", "0-7"],
      ["/dev/cpuset/top-app/sf/cpus", "3-5"],
      ["$mod_percent", "95"]
    ],

    "l3_max": [
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:gold/max_freq", "1804800"],
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime/max_freq", "1804800"],
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime-compute/max_freq", "1804800"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:l3:silver/max_freq", "1804800"]
    ],

    "ddr_max": [
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/max_freq", "2736000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:gold-compute/max_freq", "1555000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:gold/max_freq", "4224000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:prime-latfloor/max_freq", "4224000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:prime/max_freq", "4224000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:silver/max_freq", "1555000"]
    ],

    "ddr_low": [
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/max_freq", "2736000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:gold-compute/max_freq", "1555000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:gold/max_freq", "2736000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:prime-latfloor/max_freq", "2736000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:prime/max_freq", "2736000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:silver/max_freq", "1555000"]
    ],

    "powersave_active": [
      ["@preset", "common_active"],
      ["@limiter", "inactive"],
      ["@hispeed_freq", "787200", "787200", "787200"],
      ["@hispeed_load", "85", "85", "85"]
    ],
    "powersave_inactive": [
      ["@preset", "common_inactive"],
      ["@preset", "cpu7_off"],
      ["@limiter", "idle"],
      ["@hispeed_freq", "0", "0", "0"]
    ],

    "balance_active": [
      ["@preset", "common_active"],
      ["@limiter", "inactive"],
      ["@hispeed_freq", "1017600", "1056000", "1094400"],
      ["@hispeed_load", "90", "90", "90"]
    ],
    "balance_inactive": [
      ["@preset", "common_inactive"],
      ["@preset", "cpu7_auto"],
      ["@limiter", "inactive"],
      ["@hispeed_freq", "787200", "787200", "787200"]
    ],

    "performance_active": [
      ["@preset", "common_active"],
      ["@limiter", "inactive"],
      ["@hispeed_freq", "1017600", "1286400", "1209600"],
      ["@hispeed_load", "85", "85", "85"]
    ],
    "performance_inactive": [
      ["@preset", "common_inactive"],
      ["@limiter", "inactive"],
      ["@hispeed_freq", "787200", "787200", "787200"]
    ],

    "fast_active": [
      ["@preset", "common_active"],
      ["@limiter", "inactive"],
      ["@hispeed_freq", "1228800", "1401600", "1459200"],
      ["@hispeed_load", "85", "85", "85"]
    ],
    "fast_inactive": [
      ["@preset", "common_inactive"],
      ["@limiter", "inactive"],
      ["@hispeed_freq", "787200", "787200", "787200"]
    ],
    "freq_low": [
      ["@cpu_freqs_max", "1708800", "#1708800", "#1766400"],
      ["@cpu_freqs_min", "595200", "480000", "480000"]
    ],
    "freq_middle": [
      ["@cpu_freqs_max", "1708800", "#2073600", "#2150400"],
      ["@cpu_freqs_min", "633600", "633600", "633600"]
    ],
    "freq_high": [
      ["@cpu_freqs_max", "1843200", "#2361600", "#2457600"],
      ["@cpu_freqs_min", "787200", "787200", "787200"]
    ],
    "freq_extreme": [
      ["@cpu_freqs_max", "#1843200", "#2803200", "#2803200"],
      ["@cpu_freqs_min", "1056000", "1056000", "1094400"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "powersave_active"],
        ["$bus_ddr", "2736000"],
        ["@preset", "ddr_low"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@hispeed_freq", "787200", "787200", "787200"],
        ["@preset", "freq_low"],
        ["/proc/game_opt/disable_cpufreq_limit", "0"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "balance_active"],
        ["$bus_ddr", "3187000"],
        ["@preset", "ddr_max"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@hispeed_freq", "1017600", "1056000", "1094400"],
        ["@preset", "freq_middle"],
        ["/proc/game_opt/disable_cpufreq_limit", "0"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "performance_active"],
        ["$bus_ddr", "3187000"],
        ["@preset", "ddr_max"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["$bus_ddr", "2736000"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@hispeed_freq", "1017600", "1286400", "1209600"],
        ["@preset", "freq_high"],
        ["$l3_boost", "#1593600"],
        ["$bus_ddr", "3187000"],
        ["/proc/game_opt/disable_cpufreq_limit", "#1"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "fast_active"],
        ["@preset", "ddr_max"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["$bus_ddr", "2736000"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@hispeed_freq", "1228800", "1401600", "1459200"],
        ["@preset", "freq_extreme"],
        ["$bus_ddr", "3187000"],
        ["$bus_ddr_min", "2736000"],
        ["$perfmgr_enable", "#0"],
        ["$l3_boost", "#1593600"],
        ["/proc/game_opt/disable_cpufreq_limit", "#1"]
      ]
    }
  },
  "apps": [
    {
      "friendly": "ELP",
      "packages": [
        "com.tencent.mobileqq",
        "com.tencent.tim",
        "org.telegram.messenger",
        "Music", "Reader", "ShortVideo", "Nav"
      ],
      "import": "_ELP.json"
    },
    { "friendly": "相机", "packages": ["Camera"], "import": "_Camera.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}