{
  "platform": "sun",
  "platform_name": "8GEN4",
  "alias": {
    "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
    "mod_percent": "/sys/class/kgsl/kgsl-3d0/devfreq/mod_percent",
    "max_cpus_cpu0": "/sys/devices/system/cpu/cpu0/core_ctl/max_cpus",
    "min_cpus_cpu0": "/sys/devices/system/cpu/cpu0/core_ctl/min_cpus",
    "max_cpus_cpu6": "/sys/devices/system/cpu/cpu6/core_ctl/max_cpus",
    "min_cpus_cpu6": "/sys/devices/system/cpu/cpu6/core_ctl/min_cpus",
    "core_ctl_0": "/sys/devices/system/cpu/cpu0/core_ctl/enable",
    "core_ctl_6": "/sys/devices/system/cpu/cpu6/core_ctl/enable",
    "perfmgr_enable": "/sys/module/perfmgr/parameters/perfmgr_enable",
    "sched_boost": "/proc/sys/walt/sched_boost",
    "glk_disable": "/sys/module/migt/parameters/glk_disable",
    "input_boost": "/proc/sys/walt/input_boost/sched_boost_on_input"
  },
  "features": {
    "limiter": {
      "ddr_boost": false,
      "limiters": {
        "p1": {
          "core_ctl": [0, 1],
          "cpus": [
            { "max": 1996800, "min": 748800,  "margins": "150 1113600:100 1670400:70", "excludes": [0], "prefer": 1 },
            { "max": 1958400, "min": 768000, "margins": "200 1017600:150 1267200:100" }
          ]
        },
        "p2": {
          "cpus": [
            { "max": 2400000, "min": 960000,  "margins": "200 1555200:130 1996800:90", "excludes": [0] },
            { "max": 2438400, "min": 1017600, "margins": "200 1632000:130" }
          ]
        },
        "p3": {
          "cpus": [
            { "max": 2745600, "min": 1152000, "margins": "200 1785600:130 2361600:70" },
            { "max": 2841600, "min": 1209600, "margins": "200 1977600:130" }
          ]
        },
        "inactive": {
          "core_ctl": [0, 1],
          "cpus": [
            { "max": 1785600, "min": 556800,  "margins": "120 998400:90", "excludes": [0] },
            { "max": 1958400, "min": 768000, "margins": "120 1632000:90" }
          ]
        },
        "idle": {
          "core_ctl": [0, 1],
          "cpus": [
            { "max": 1555200, "min": 556800,  "margins": "100 998400:80", "excludes": [0] },
            { "max": 1689600, "min": 768000, "margins": "100 1632000:80" }
          ]
        }
      }
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
      ],
      "exit": [
      ]
    }
  },
  "reset": [
    ["@msm_reset"],
    ["@governor", "walt"]
  ],
  "presets": {
    "latency": [
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy6/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy6/walt/up_rate_limit_us"]
    ],
    "target_loads": [
      ["/sys/devices/system/cpu/cpu0/cpufreq/walt/target_loads"],
      ["/sys/devices/system/cpu/cpu6/cpufreq/walt/target_loads"]
    ],
    "cpu6_on": [
      ["$core_ctl_0", "1"],
      ["$max_cpus_cpu0", "#6"],
      ["$min_cpus_cpu0", "#6"],
      ["$core_ctl_0", "0"],
      ["$core_ctl_6", "1"],
      ["$max_cpus_cpu6", "#2"],
      ["$min_cpus_cpu6", "#2"],
      ["$core_ctl_6", "#0"]
    ],
    "cpu6_off": [
      ["$core_ctl_6", "1"],
      ["$min_cpus_cpu6", "#0"],
      ["$max_cpus_cpu6", "#0"]
    ],
    "cpu6_auto": [
      ["$core_ctl_6", "1"],
      ["$min_cpus_cpu6", "#0"],
      ["$max_cpus_cpu6", "#2"]
    ],
    "limiter_off": [
      ["/proc/game_opt/disable_cpufreq_limit", "#1"],
      ["/sys/module/migt/parameters/glk_disable", "#1"],
      ["/sys/module/perfmgr/parameters/perfmgr_enable", "#0"],
      ["/sys/module/migt/parameters/glk_freq_limit_walt", "#0"]
    ],
    "limiter_on": [
      ["/proc/game_opt/disable_cpufreq_limit", "0"],
      ["/sys/module/migt/parameters/glk_disable", "0"]
    ],
    "common_active": [
    ],
    "common_inactive": [
      ["@cpu_freqs_min", "0", "0"],
      ["$sched_boost", "0"]
    ],
    "common_app": [
      ["$perfmgr_enable", "0"],
      ["@cpuset", "0-3", "0-5", "0-7", "0-7"],
      ["@values", "latency", "1000", "1000", "1000", "1000"],
      ["$mod_percent", "105"]
    ],
    "common_gaming": [
      ["@preset", "common_active"],
      ["@limiter", "NONE"],
      ["@cpuset", "0-1", "0-3", "0-4", "0-7"],
      ["$sched_boost", "0"],
      ["@values", "latency", "1000", "2000", "1000", "2000"],
      ["$mod_percent", "100"],
      ["@preset", "cpu6_on"]
    ],

    "powersave_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "#691200", "#768000"],
      ["@target_loads",
        "85 1113600:90 1670400:90",
        "85 1017600:90 1747200:90"],
      ["@hispeed_freq", "883200", "0"],
      ["@limiter", "p1"]
    ],
    "powersave_inactive": [
      ["@preset", "common_inactive"],
      ["@preset", "cpu6_auto"],
      ["@target_loads",
        "90 787200:95",
        "90 1017600:95 1977600:98"],
      ["@hispeed_freq", "0", "0"],
      ["@limiter", "idle"]
    ],

    "balance_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "#691200", "768000"],
      ["@target_loads",
        "82 1113600:87 1555200:92 1996800:97",
        "82 1267200:87 1977600:92 2438400:97"],
      ["@hispeed_freq", "883200", "0"],
      ["@preset", "cpu6_on"],
      ["@limiter", "p2"]
    ],
    "balance_inactive": [
      ["@preset", "common_inactive"],
      ["@preset", "cpu6_auto"],
      ["@target_loads",
        "85 1324800:90 1555200:95",
        "85 1267200:90 1977600:95"],
      ["@hispeed_freq", "0", "0"],
      ["@limiter", "inactive"]
    ],

    "performance_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "883200", "768000"],
      ["@target_loads",
        "80 1555200:85 1996800:90 2496000:95",
        "80 1977600:85 2880000:90 3398400:95"],
      ["@hispeed_freq", "1113600", "1132800"],
      ["@preset", "cpu6_on"],
      ["@limiter", "p3"]
    ],
    "performance_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1555200:90",
        "83 1977600:85 2438400:90"],
      ["@hispeed_freq", "883200", "1017600"],
      ["@limiter", "inactive"]
    ],

    "fast_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "1228800", "1132800"],
      ["@target_loads",
        "75 1670400:80 1996800:85 2496000:90",
        "75 2227200:80 2880000:85 3648000:90"],
      ["@hispeed_freq", "1228800", "1132800"],
      ["@preset", "cpu6_on"]
    ],
    "fast_inactive": [
      ["@target_loads",
        "85 1996800:90",
        "83 2227200:87 2880000:95"],
      ["@hispeed_freq", "1113600", "1017600"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["/sys/devices/system/cpu/cpufreq/boost", "0"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "2112000", "#2112000"],
        ["@preset", "powersave_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_on"],
        ["@hispeed_freq", "1113600", "0"]
      ]
    },
    "balance": {
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "2496000", "#2880000"],
        ["@preset", "balance_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_on"],
        ["@hispeed_freq", "1113600", "1132800"]
      ]
    },
    "performance": {
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "2496000", "#3129600"],
        ["@preset", "performance_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_off"],
        ["@hispeed_freq", "1113600", "1382400"]
      ]
    },
    "fast": {
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "2899200", "#3648000"],
        ["@preset", "fast_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_off"],
        ["@hispeed_freq", "1113600", "1382400"]
      ]
    }
  },
  "apps": [
    {
      "friendly": "ELP",
      "packages": [
        "IM", "Music", "Reader", "ShortVideo", "Nav", "ScrollOpt"
      ],
      "import": "_ELP.json"
    },
    { "friendly": "相机", "packages": ["Camera"], "import": "_Camera.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}