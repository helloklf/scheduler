{
  "platform": "mt6895",
  "platform_name": "D8100",
  "alias": {
    "boost_affinity": "/sys/module/mtk_fpsgo/parameters/boost_affinity",
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "ddr_freq_min": "/sys/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/min_freq",
    "ddr_freq_max": "/sys/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/max_freq",
    "ddr_freq_cust": "/sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq",
    "ged_kpi": "/sys/module/sspm_v3/holders/ged/parameters/is_GED_KPI_enabled",
    "fpsgo": "/sys/kernel/fpsgo/common/fpsgo_enable",
    "cpufreq": "/proc/cpudvfs/cpufreq_debug",
    "perfmgr_enable": "/sys/module/mtk_fpsgo/parameters/perfmgr_enable",
    "ddr_max": "/sys/class/devfreq/mtk-dvfsrc-devfreq/max_freq"
  },
  "features": {
    "limiter": {
      "ddr_boost": false,
      "params": {
        "p1": {
          "cpus": [
            { "max": 2000000, "min": 1600000, "margins": "500" },
            { "max": 2450000, "min": 1600000, "margins": "300 2100000:150" },
            { "max": 2650000, "min": 1800000, "margins": "300 2100000:200 2450000:120" }
          ]
        },
        "p2": {
          "cpus": [
            null,
            { "max": 2650000, "min": 2200000, "margins": "400 2450000:200" },
            { "max": 2850000, "min": 2450000, "margins": "400" }
          ]
        },
        "p3": {
          "cpus": [
            null,
            { "max": 2850000, "min": 2450000, "margins": "350 2650000:200" },
            { "max": 2850000, "min": 2650000, "margins": "350"}
          ]
        },
        "inactive": {
          "cpus": [
            { "max": 1800000, "min": 800000, "margins": "300 1500000:200" },
            { "max": 1900000, "min": 900000, "margins": "160 1800000:100" },
            { "max": 2300000, "min": 900000, "margins": "200 1800000:100" }
          ]
        },
        "idle": {
          "cpus": [
            { "max": 1800000, "min": 700000, "margins": "200" },
            { "max": 1800000, "min": 500000, "margins": "120" },
            { "max": 2000000, "min": 500000, "margins": "140 1800000:100", "core_ctl": true }
          ]
        }
      }
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
        ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"],
        ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "470000"],
        ["$ddr_freq_cust", "4266000000"]
      ],
      "exit": [
        ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"],
        ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "0"],
        ["$ddr_freq_cust", "#0"]
      ]
    }
  },
  "reset": [
    ["@mtk_reset"],
    ["@governor", "schedutil"],
    ["$perfmgr_enable", "#0"],
    ["$boost_affinity", "#0"]
  ],
  "presets": {
    "min_freq": [
      ["$cpu_min_0"], ["$cpu_min_4"], ["$cpu_min_7"]
    ],
    "max_freq": [
      ["$cpu_max_0"], ["$cpu_max_4"], ["$cpu_max_7"]
    ],
    "cpu7_on": [
      ["$core_ctl_7", "#1"],
      ["$max_cpus_cpu7", "#1"],
      ["$min_cpus_cpu7", "#1"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_off": [
      ["$core_ctl_7", "#1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#0"],
      ["$core_ctl_7", "#0"]
    ],
    "common_active": [
      ["$cpu_max_0", "2000000"],
      ["@preset", "cpu7_on"]
    ],
    "common_inactive": [
      ["@values", "min_freq", "450000", "200000", "500000"],
      ["$ddr_freq_min", "#800000000"],
      ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"]
    ],
    "common_app": [
      ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_enable 1|cm_mgr_perf_enable 1|dsu_mode 0"],
      ["@cpuset", "0-3", "0-6", "0-6", "0-7"],
      ["/sys/kernel/ged/hal/custom_upbound_gpu_freq", "#07"],
      ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"],
      ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "0"],
      ["$ddr_max", "#5500000000"]
    ],
    "common_gaming": [
      ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_enable 1|cm_mgr_perf_enable 1|dsu_mode 1"],
      ["@cpuset", "0-2", "1-3", "0-5", "0-7"],
      ["/sys/kernel/ged/hal/custom_upbound_gpu_freq", "#0"],
      ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "#99"],
      ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "#0"],
      ["$ddr_freq_cust", "0"],
      ["$ddr_max", "#6400000000"],
      ["@limiter", "NONE"],
      ["@ddr_l3_booster"]
    ],

    "powersave_active": [
      ["@limiter", "p1"],
      ["@values", "min_freq", "800000", "500000", "600000"],
      ["$ddr_freq_min", "#2133000000"],
      ["@preset", "common_active"]
    ],
    "powersave_inactive": [
      ["@limiter", "idle"],
      ["@preset", "common_inactive"]
    ],
    "balance_active": [
      ["@limiter", "p2"],
      ["@values", "min_freq", "1000000", "900000", "800000"],
      ["$ddr_freq_min", "#2133000000"],
      ["@preset", "common_active"]
    ],
    "balance_inactive": [
      ["@limiter", "inactive"],
      ["@preset", "common_inactive"]
    ],
    "performance_active": [
      ["@limiter", "p3"],
      ["@values", "min_freq", "1200000", "1600000", "1600000"],
      ["$ddr_freq_min", "3200000000"],
      ["@preset", "common_active"]
    ],
    "performance_inactive": [
      ["@limiter", "p2"],
      ["@preset", "common_inactive"]
    ],
    "fast_active": [
      ["@values", "max_freq", "2000000", "2850000", "3100000"],
      ["@values", "min_freq", "1200000", "1600000", "1600000"],
      ["$ddr_freq_min", "3200000000"],
      ["@preset", "common_active"]
    ],
    "fast_inactive": [
      ["@limiter", "p3"],
      ["@preset", "common_inactive"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "powersave_active"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "balance_active"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "performance_active"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "fast_active"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    },
    "pedestal": {
      "call": [
        ["@preset", "fast_active"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    }
  },
  "apps": [
    { "friendly": "相机", "categories": ["Camera"], "import": "_Camera.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "双核强化",
      "packages": [
        "com.miHoYo.Yuanshen", "com.miHoYo.ys.mi", "com.miHoYo.ys.bilibili", "com.miHoYo.GenshinImpact",
        "com.miHoYo.hkrpg", "com.miHoYo.hkrpg.bilibili", "com.HoYoverse.hkrpgoversea"
      ],
      "import": "_DualCore.json"
    },
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}