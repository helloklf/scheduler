{
  "friendly": "游戏(双核强化)",
  "call": [
    ["@preset", "common_gaming"],
    ["@ddr_l3_booster"]
  ],
  "modes": [
    {
      "mode": ["powersave"],
      "call": [
        ["@cpu_freqs_max", "#1800000", "#2300000", "#2300000"],
        ["@cpu_freqs_min",  "#700000",  "#500000",  "#500000"]
      ]
    },
    {
      "mode": ["balance"],
      "call": [
        ["@cpu_freqs_max", "#2000000", "#2450000", "#2450000"],
        ["@cpu_freqs_min",  "#800000",  "#700000", "#700000"]
      ]
    },
    {
      "mode": ["performance"],
      "call": [
        ["@cpu_freqs_max", "#2000000", "#2850000", "#2850000"],
        ["@cpu_freqs_min",  "#1000000", "#900000", "#900000"]
      ]
    },
    {
      "mode": ["fast"],
      "call": [
        ["@cpu_freqs_max", "#2000000", "#2850000", "#3100000"],
        ["@cpu_freqs_min", "#1200000", "#1200000", "#1200000"]
      ]
    },
    {
      "mode": ["*"],
      "call": [
        ["@cpu_freqs_max", "#2000000", "#3000000", "#3100000"],
        ["@cpu_freqs_min", "#1200000", "#1600000", "#1600000"]
      ]
    }
  ]
}