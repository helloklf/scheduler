{
  "platform": "mt6983",
  "platform_name": "D9000",
  "alias": {
    "gpu_freq": "/sys/kernel/ged/hal/custom_upbound_gpu_freq",
    "gpu_min_opp": "/sys/kernel/ged/hal/custom_boost_gpu_freq",
    "boost_affinity": "/sys/module/mtk_fpsgo/parameters/boost_affinity",
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "ddr_freq_min": "/sys/class/devfreq/mtk-dvfsrc-devfreq/min_freq",
    "ddr_freq_cust": "/sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq",
    "ged_kpi": "/sys/module/sspm_v3/holders/ged/parameters/is_GED_KPI_enabled",
    "fpsgo": "/sys/kernel/fpsgo/common/fpsgo_enable",
    "cpufreq": "/proc/cpudvfs/cpufreq_debug",
    "ddr_force_opp": "/sys/devices/platform/1c00f000.dvfsrc/1c00f000.dvfsrc:dvfsrc-helper/dvfsrc_force_vcore_dvfs_opp",
    "limit_cfreq": "/sys/kernel/fpsgo/fbt/limit_cfreq",
    "limit_rfreq": "/sys/kernel/fpsgo/fbt/limit_rfreq",
    "limit_cfreq_m": "/sys/kernel/fpsgo/fbt/limit_cfreq_m",
    "limit_rfreq_m": "/sys/kernel/fpsgo/fbt/limit_rfreq_m",
    "perfmgr_enable": "/sys/module/mtk_fpsgo/parameters/perfmgr_enable",
    "pandor_perfmgr_enable": "/sys/module/perfmgr_mtk/parameters/perfmgr_enable",
    "ddr_max": "/sys/class/devfreq/mtk-dvfsrc-devfreq/max_freq",
    "sched_boost": "/sys/kernel/fpsgo/fbt/switch_idleprefer"
  },
  "features": {
    "limiter": {
      "ddr_boost": true,
      "limiters": {
        "p1": {
          "cpus": [
            { "max": 1400000, "min": 700000, "margins": "250" },
            { "max": 2300000, "min": 1300000, "margins": "400" },
            { "max": 2300000, "min": 1300000, "margins": "400" }
          ]
        },
        "p2": {
          "cpus": [
            { "max": 1500000, "min": 1050000, "margins": "300" },
            { "max": 2600000, "min": 2050000, "margins": "400" },
            { "max": 2600000, "min": 2100000, "margins": "400" }
          ]
        },
        "p3": {
          "cpus": [
            { "max": 1600000, "min": 1400000, "margins": "300" },
            { "max": 2800000, "min": 2300000, "margins": "300" },
            { "max": 2800000, "min": 2300000, "margins": "300" }
          ]
        },
        "p4": {
          "cpus": [
            { "max": 1600000, "min": 1500000, "margins": "300" },
            { "max": 2850000, "min": 2650000, "margins": "300" },
            { "max": 3000000, "min": 2650000, "margins": "300" }
          ]
        },
        "inactive": {
          "cpus": [
            { "max": 1500000, "min": 700000, "margins": "150" },
            { "max": 2100000, "min": 700000, "margins": "150" },
            { "max": 2100000, "min": 1300000, "margins": "150" }
          ]
        },
        "idle": {
          "cpus": [
            { "max": 1200000, "min": 500000, "margins": "120" },
            { "max": 1800000, "min": 500000, "margins": "120" },
            { "max": 1800000, "min": 1300000, "margins": "120", "core_ctl": true }
          ]
        }
      }
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
        ["$gpu_min_opp", "28"],
        ["$ddr_freq_cust", "4266000000"]
      ],
      "exit": [
        ["$gpu_min_opp", "99"],
        ["$ddr_freq_cust", "#0"]
      ]
    }
  },
  "reset": [
    ["@mtk_reset"],
    ["@governor", "schedutil"],
    ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_enable 1|cm_mgr_perf_enable 1|dsu_mode 1"],
    ["$ddr_force_opp", "999"],
    ["$ddr_freq_cust", "0"],
    ["$perfmgr_enable", "#0"],
    ["$pandor_perfmgr_enable", "#0"]
  ],
  "presets": {
    "cpu7_on": [
      ["$core_ctl_7", "#1"],
      ["$max_cpus_cpu7", "#1"],
      ["$min_cpus_cpu7", "#1"],
      ["$core_ctl_7", "#0"]
    ],
    "common_active": [
      ["@preset", "cpu7_on"],
      ["$sched_boost", "1"]
    ],
    "common_inactive": [
      ["@cpu_freqs_min", "200000", "400000", "1300000"],
      ["$gpu_min_opp", "99"],
      ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "0"],
      ["$sched_boost", "0"],
      ["$ddr_freq_min", "#800000000"]
    ],
    "common_app": [
      ["$ddr_max", "#5500000000"],
      ["@cpuset", "0-3", "0-6", "0-7", "0-7"],
      ["$gpu_freq", "#10"]
    ],
    "common_gaming": [
      ["$ddr_max", "#6400000000"],
      ["@preset", "common_active"],
      ["@limiter", "NONE"],
      ["$gpu_freq", "#0"],
      ["$gpu_min_opp", "99"],
      ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "0"],
      ["@cpuset", "0-3", "0-5", "0-5", "0-7"],
      ["$boost_affinity", "0"],
      ["$sched_boost", "#0"],
      ["$fpsgo", "#1"],
      ["$ged_kpi", "#0"],
      ["@gesture", "PAUSE"]
    ],

    "powersave_active": [
      ["@limiter", "p1"],
      ["@preset", "common_active"],
      ["$ddr_freq_min", "#1866000000"],
      ["@cpu_freqs_min", "400000", "700000", "1300000"]
    ],
    "powersave_inactive": [
      ["@limiter", "idle"],
      ["@preset", "common_inactive"]
    ],
    "balance_active": [
      ["@limiter", "p2"],
      ["@preset", "common_active"],
      ["$ddr_freq_min", "#2667000000"],
      ["@cpu_freqs_min", "500000", "700000", "1300000"]
    ],
    "balance_inactive": [
      ["@limiter", "inactive"],
      ["@preset", "common_inactive"]
    ],
    "performance_active": [
      ["@limiter", "p3"],
      ["@cpu_freqs_min", "700000", "900000", "1300000"],
      ["@preset", "common_active"],
      ["$ddr_freq_min", "#320000000"]
    ],
    "performance_inactive": [
      ["@limiter", "p2"],
      ["@preset", "common_inactive"]
    ],
    "fast_active": [
      ["@limiter", "p4"],
      ["@preset", "common_active"],
      ["$ddr_freq_min", "#320000000"],
      ["@cpu_freqs_min", "1000000", "1000000", "1300000"]
    ],
    "fast_inactive": [
      ["@limiter", "p3"],
      ["@preset", "common_inactive"]
    ]
  },
  "schemes": {
    "powersave": {
      "app": [
        ["@preset", "common_app"],
        ["@preset", "powersave_active"]
      ]
    },
    "balance": {
      "app": [
        ["@preset", "common_app"],
        ["@preset", "balance_active"]
      ]
    },
    "performance": {
      "app": [
        ["@preset", "common_app"],
        ["@preset", "performance_active"]
      ]
    },
    "fast": {
      "app": [
        ["@preset", "common_app"],
        ["@preset", "fast_active"]
      ]
    },
    "pedestal": {
      "app": [
        ["@preset", "common_app"],
        ["@preset", "fast_active"]
      ]
    }
  },
  "apps": [
    { "friendly": "相机", "packages": ["Camera"], "import": "_Camera.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "双核强化",
      "packages": [
        "com.miHoYo.Yuanshen", "com.miHoYo.ys.mi", "com.miHoYo.ys.bilibili", "com.miHoYo.GenshinImpact",
        "com.miHoYo.hkrpg", "com.miHoYo.hkrpg.bilibili", "com.HoYoverse.hkrpgoversea"
      ],
      "import": "_DualCore.json"
    },
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}