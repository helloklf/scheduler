{
  "friendly": "游戏(Games)",
  "call": [
    ["@preset", "common_gaming"],
    ["@ddr_l3_booster"]
  ],
  "modes": [
    {
      "mode": ["powersave"],
      "call": [
        ["$ddr_map", "2300000:6400000 2000000:5500000 1700000:4100000 1600000:3094000"],
        ["$cpufreq", "0 220000 1800000|4 400000 2300000|7 1200000 2400000"],
        ["@values", "max_freq", "1700000", "2200000", "2400000"],
        ["@values", "min_freq", "500000",  "500000",  "1200000"],
        ["@values", "target_loads",
          "0 1200000|1 1700000|2 1700000",
          "0 20|1 20|2 20",
          "0 15|1 15|2 15"
        ]
      ]
    },
    {
      "mode": ["balance"],
      "call": [
        ["$ddr_map", "2300000:6400000 1900000:5500000 1700000:4100000 1600000:3094000"],
        ["$cpufreq", "0 220000 2000000|4 400000 2600000|7 1200000 2800000"],
        ["@values", "max_freq", "1800000", "2600000", "2800000"],
        ["@values", "min_freq", "500000",  "700000",  "1200000"],
        ["@values", "target_loads",
          "0 1200000|1 1900000|2 2100000",
          "0 25|1 20|2 20",
          "0 20|1 15|2 15"
        ]
      ]
    },
    {
      "mode": ["performance"],
      "call": [
        ["/sys/class/devfreq/mtk-dvfsrc-devfreq/min_freq", "4100000000"],
        ["$ddr_map", "2300000:6400000 1900000:5500000 1700000:4100000 1400000:3094000"],
        ["$cpufreq", "0 220000 2000000|4 400000 2850000|7 1200000 3050000"],
        ["@values", "max_freq", "2000000", "2850000", "3050000"],
        ["@values", "min_freq", "800000",  "900000",  "1200000"],
        ["@values", "target_loads",
          "0 1200000|1 2300000|2 2400000",
          "0 25|1 20|2 20",
          "0 20|1 15|2 15"
        ]
      ],
      "sensors": [
        {
          "sensor": "battery",
          "interval": 10000,
          "rules": [
            { "threshold": [-1, 43], "enter_once": [["@values", "max_freq", "2000000", "2800000", "2800000"]] },
            { "threshold": [43, -1], "enter_once": [["@values", "max_freq", "2000000", "2850000", "3050000"]] }
          ]
        }
      ]
    },
    {
      "mode": ["fast"],
      "call": [
        ["$ddr_map", "2800000:8533000 2300000:6400000 1900000:5500000 1700000:4100000"],
        ["/sys/class/devfreq/mtk-dvfsrc-devfreq/min_freq", "4100000000"],
        ["$cpufreq", "0 220000 2000000|4 400000 3000000|7 1200000 3250000"],
        ["@values", "max_freq", "2000000", "3000000", "3250000"],
        ["@values", "min_freq", "800000",  "1100000", "1500000"],
        ["/sys/kernel/helio-dvfsrc/dvfsrc_qos_mode", "1"],
        ["@values", "target_loads",
          "0 1500000|1 2400000|2 2800000",
          "0 25|1 25|2 25",
          "0 20|1 15|2 15"
        ]
      ],
      "sensors": [
        {
          "sensor": "battery",
          "interval": 10000,
          "rules": [
            { "threshold": [-1, 48], "enter_once": [["@values", "max_freq", "2000000", "2600000", "2800000"]] },
            { "threshold": [48, 43], "enter_once": [["@values", "max_freq", "2000000", "2850000", "3050000"]] },
            { "threshold": [43, -1], "enter_once": [["@values", "max_freq", "2000000", "3000000", "3250000"]] }
          ]
        }
      ]
    },
    {
      "mode": ["*"],
      "call": [
        ["$ddr_map", "2600000:8533000 2100000:6400000 1700000:5500000 1500000:4100000"],
        ["$gpu_max_freq", "#00"],
        ["/sys/class/devfreq/mtk-dvfsrc-devfreq/min_freq", "5500000000"],
        ["$cpufreq", "0 220000 2000000|4 400000 3000000|7 1200000 3250000"],
        ["@values", "max_freq", "2000000", "3000000", "3250000"],
        ["@values", "min_freq", "1200000", "1400000", "1600000"],
        ["/sys/kernel/helio-dvfsrc/dvfsrc_qos_mode", "1"],
        ["@values", "target_loads",
          "0 1600000|1 2400000|2 2800000",
          "0 25|1 25|2 30",
          "0 20|1 20|2 20"
        ]
      ],
      "sensors": [
        {
          "sensor": "battery",
          "interval": 10000,
          "rules": [
            { "threshold": [-1, 48], "enter_once": [["@values", "max_freq", "2000000", "2600000", "2800000"]] },
            { "threshold": [48, 44], "enter_once": [["@values", "max_freq", "2000000", "2850000", "3050000"]] },
            { "threshold": [44, -1], "enter_once": [["@values", "max_freq", "2000000", "3000000", "3250000"]] }
          ]
        }
      ]
    }
  ]
}