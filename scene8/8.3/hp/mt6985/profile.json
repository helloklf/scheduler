{
  "platform": "mt6985",
  "platform_name": "D9200",
  "alias": {
    "boost_affinity": "/sys/module/mtk_fpsgo/parameters/boost_affinity",
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "ddr_freq_min": "/sys/class/devfreq/mtk-dvfsrc-devfreq/min_freq",
    "ddr_freq_cust": "/sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq",
    "ged_kpi": "/sys/module/sspm_v3/holders/ged/parameters/is_GED_KPI_enabled",
    "fpsgo": "/sys/kernel/fpsgo/common/fpsgo_enable",
    "perfmgr_enable": "/sys/module/mtk_fpsgo/parameters/perfmgr_enable",
    "perfmgr_enable2": "/sys/module/perfmgr_mtk/parameters/perfmgr_enable",
    "ddr_max": "/sys/class/devfreq/mtk-dvfsrc-devfreq/max_freq",
    "gpu_max_freq": "/sys/kernel/ged/hal/custom_upbound_gpu_freq",
    "gpu_min_opp": "/sys/kernel/ged/hal/custom_boost_gpu_freq",
    "cpufreq": "/proc/cpudvfs/cpufreq_debug",
    "ddr_map": "/sys/module/mtk_fpsgo/parameters/ddrfreq_remap_table",
    "cpus_limit": "/sys/module/mtk_fpsgo/parameters/cpus_limit",
    "switch_idleprefer": "/sys/kernel/fpsgo/fbt/switch_idleprefer",
    "core_ctl": "/sys/module/mtk_core_ctl/parameters/policy_enable"
  },
  "features": {
    "limiter": {
      "ddr_boost": true,
      "params": [
        { "id": "p1:cpu0", "max": 1700000, "min": 1000000, "margin": 300 },
        { "id": "p1:cpu4", "max": 2100000, "min": 1800000, "margin": 300 },
        { "id": "p1:cpu7", "max": 2100000, "min": 1800000, "margin": 300 },

        { "id": "p2:cpu0", "max": 1700000, "min": 1200000, "margin": 300 },
        { "id": "p2:cpu4", "max": 2400000, "min": 1900000, "margin": 300 },
        { "id": "p2:cpu7", "max": 2600000, "min": 2100000, "margin": 300 },

        { "id": "p3:cpu0", "max": 1800000, "min": 1400000, "margin": 300 },
        { "id": "p3:cpu4", "max": 2600000, "min": 2300000, "margin": 300 },
        { "id": "p3:cpu7", "max": 2800000, "min": 2400000, "margin": 300 },

        { "id": "p4:cpu0", "max": 2000000, "min": 1500000, "margin": 300 },
        { "id": "p4:cpu4", "max": 2850000, "min": 2650000, "margin": 300 },
        { "id": "p4:cpu7", "max": 3050000, "min": 2800000, "margin": 300 },


        { "id": "inactive:cpu0", "max": 1700000, "min": 500000,  "margin": 120 },
        { "id": "inactive:cpu4", "max": 1900000, "min": 500000,  "margin": 120 },
        { "id": "inactive:cpu7", "max": 1900000, "min": 1200000, "margin": 120 },

        { "id": "idle:cpu0", "max": 1400000, "min": 500000, "margin": 100 },
        { "id": "idle:cpu4", "max": 1800000, "min": 500000, "margin": 100 },
        { "id": "idle:cpu7", "max": 1800000, "min": 1200000, "margin": 100 }
      ]
    }
  },
  "presets": {
    "reset": [
      ["@governor", "sugov_ext", "schedutil"],
      ["@preset", "common_active"],
      ["$perfmgr_enable", "#0"],
      ["$perfmgr_enable2", "#0"],
      ["/sys/class/devfreq/mtk-dvfsrc-devfreq/min_freq", "800000000"],
      ["$cpus_limit", "#3000000 3350000"]
    ],
    "min_freq": [
      ["$cpu_min_0"], ["$cpu_min_4"], ["$cpu_min_7"]
    ],
    "max_freq": [
      ["$cpu_max_0"], ["$cpu_max_4"], ["$cpu_max_7"]
    ],
    "latency": [
      ["/sys/devices/system/cpu/cpufreq/policy0/sugov_ext/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy0/sugov_ext/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy4/sugov_ext/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy4/sugov_ext/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/sugov_ext/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/sugov_ext/up_rate_limit_us"]
    ],
    "target_loads": [
      ["/sys/devices/system/cpu/sched_ctl/sched_turn_point_freq", "0 1500000|1 1700000|2 1700000"],
      ["/sys/devices/system/cpu/sched_ctl/sched_target_margin_low", "0 20|1 20|2 20"],
      ["/sys/devices/system/cpu/sched_ctl/sched_target_margin", "0 20|1 20|2 20"]
    ],
    "cpu7_on": [
      ["$core_ctl_7", "#1"],
      ["$max_cpus_cpu7", "#1"],
      ["$min_cpus_cpu7", "#1"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_off": [
      ["$core_ctl_7", "#1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#0"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_auto": [
      ["$core_ctl_7", "#1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#1"]
    ],
    "common_active": [
      ["@preset", "cpu7_on"]
    ],
    "common_inactive": [
      ["@values", "min_freq", "220000", "400000", "1200000"]
    ],
    "common_app": [
      ["@values", "latency", "1000", "1000", "1000", "1000", "1000", "1000"],
      ["$ddr_map", "1700000:4100000 1600000:3094000 1500000:2133000 1400000:1600000"],
      ["@cpuset", "0-3", "0-6", "0-7", "0-7"],
      ["/sys/kernel/cm_mgr/dbg_cm_mgr", "dsu_mode 0|cm_aggr 0|dsu_mode_change 0|cm_mgr_dram_opp_ceiling 3"],
      ["$switch_idleprefer", "#1"],
      ["/sys/kernel/helio-dvfsrc/dvfsrc_qos_mode", "0"],
      ["$gpu_max_freq", "#14"],
      ["$core_ctl", "#1"]
    ],
    "common_gaming": [
      ["@values", "latency", "1000", "1000", "1000", "1000", "1000", "1000"],
      ["@limiters", "NONE"],
      ["@cpuset", "0-3", "0-5", "0-5", "0-7"],
      ["/sys/kernel/cm_mgr/dbg_cm_mgr", "dsu_mode 1|cm_aggr 1|dsu_mode_change 2|cm_mgr_dram_opp_ceiling -1"],
      ["$switch_idleprefer", "#0"],
      ["/sys/class/devfreq/mtk-dvfsrc-devfreq/min_freq", "1866000000"],
      ["$gpu_max_freq", "#3"],
      ["$core_ctl", "#0"]
    ],

    "powersave_active": [
      ["@limiters", "p1:cpu0", "p1:cpu4", "p1:cpu7"],
      ["@preset", "common_active"],
      ["@values", "min_freq", "500000", "700000", "1200000"],
      ["@values", "target_loads",
        "0 1000000|1 1200000|2 1700000",
        "0 20|1 20|2 20",
        "0 17|1 17|2 17"
      ]
    ],
    "powersave_inactive": [
      ["@limiters", "idle:cpu0", "idle:cpu4", "idle:cpu7"],
      ["@preset", "common_inactive"],
      ["@values", "target_loads",
        "0 1000000|1 900000|2 1200000",
        "0 17|1 17|2 17",
        "0 12|1 12|2 12"
      ]
    ],
    "balance_active": [
      ["@limiters", "p2:cpu0", "p2:cpu4", "p2:cpu7"],
      ["@preset", "common_active"],
      ["@values", "min_freq", "500000", "700000", "1200000"],
      ["@values", "target_loads",
        "0 1200000|1 1600000|2 1900000",
        "0 20|1 20|2 20",
        "0 17|1 17|2 17"
      ]
    ],
    "balance_inactive": [
      ["@limiters", "inactive:cpu0", "inactive:cpu4", "inactive:cpu7"],
      ["@preset", "common_inactive"],
      ["@values", "target_loads",
        "0 1200000|1 1200000|2 1200000",
        "0 20|1 20|2 20",
        "0 15|1 15|2 15"
      ]
    ],
    "performance_active": [
      ["@limiters", "p3:cpu0", "p3:cpu4", "p3:cpu7"],
      ["@preset", "common_active"],
      ["@values", "min_freq", "700000", "900000", "1200000"],
      ["@values", "target_loads",
        "0 1500000|1 2100000|2 2100000",
        "0 25|1 25|2 25",
        "0 20|1 20|2 20"
      ]
    ],
    "performance_inactive": [
      ["@limiters", "p2:cpu0", "p2:cpu4", "p2:cpu7"],
      ["@preset", "common_inactive"],
      ["@values", "target_loads",
        "0 1200000|1 1200000|2 1200000",
        "0 20|1 20|2 20",
        "0 15|1 15|2 15"
      ]
    ],
    "fast_active": [
      ["@limiters", "p4:cpu0", "p4:cpu4", "p4:cpu7"],
      ["@preset", "common_active"],
      ["@values", "min_freq", "1000000", "1000000", "1200000"],
      ["@values", "target_loads",
        "0 1500000|1 2100000|2 2100000",
        "0 25|1 25|2 25",
        "0 20|1 20|2 20"
      ]
    ],
    "fast_inactive": [
      ["@limiters", "p3:cpu0", "p3:cpu4", "p3:cpu7"],
      ["@preset", "common_inactive"],
      ["@values", "target_loads",
        "0 1500000|1 1600000|2 1600000",
        "0 20|1 20|2 20",
        "0 15|1 15|2 15"
      ]
    ],
    "freq_low": [
      ["$cpufreq", "0 220000 1800000|4 400000 2300000|7 1200000 2400000"],
      ["@values", "max_freq", "1700000", "2100000", "2100000"],
      ["@values", "min_freq", "220000", "400000", "1200000"]
    ],
    "freq_middle": [
      ["$cpufreq", "0 220000 1700000|4 400000 2600000|7 1200000 2600000"],
      ["@values", "max_freq", "1700000", "#2400000", "#2400000"],
      ["@values", "min_freq", "220000", "400000", "1200000"]
    ],
    "freq_high": [
      ["$cpufreq", "0 220000 1800000|4 400000 2800000|7 1200000 2800000"],
      ["@values", "max_freq", "1700000", "#2650000", "#2800000"],
      ["@values", "min_freq", "220000", "400000", "1200000"]
    ],
    "freq_extreme": [
      ["$cpufreq", "0 220000 2000000|4 400000 2850000|7 1200000 3050000"],
      ["@values", "max_freq", "#2000000", "#2850000", "#3050000"],
      ["@values", "min_freq", "220000", "400000", "1200000"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "reset"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@preset", "freq_middle"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "reset"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@preset", "freq_high"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "reset"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@preset", "freq_extreme"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "reset"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@preset", "freq_extreme"]
      ]
    }
  },
  "apps": [
    { "friendly": "扫码", "categories": ["Scanner"], "import": "_Scanner.json" },
    { "friendly": "相机", "categories": ["Camera"], "import": "_Camera.json" },
    { "friendly": "待机", "packages": ["standby"], "import": "_Standby.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}