{
  "platform": "mt6991",
  "platform_name": "D9400",
  "alias": {
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "ddr_freq_min": "/sys/class/devfreq/mtk-dvfsrc-devfreq/min_freq",
    "ddr_freq_cust": "/sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq",
    "ged_kpi": "/sys/module/sspm_v3/holders/ged/parameters/is_GED_KPI_enabled",
    "fpsgo": "/sys/kernel/fpsgo/common/fpsgo_enable",
    "perfmgr_enable": "/sys/module/mtk_fpsgo/parameters/perfmgr_enable",
    "ddr_max": "/sys/class/devfreq/mtk-dvfsrc-devfreq/max_freq",
    "gpu_max_freq": "/sys/kernel/ged/hal/custom_upbound_gpu_freq",
    "gpu_min_opp": "/sys/kernel/ged/hal/custom_boost_gpu_freq",
    "cpufreq": "/proc/powerhal_cpu_ctrl/perfserv_freq",
    "cpus_limit": "/sys/module/mtk_fpsgo/parameters/cpus_limit",
    "uclamp_boost": "/dev/cpuctl/top-app/cpu.uclamp.min"
  },
  "features": {
    "limiter": {
      "ddr_boost": false,
      "params": [
        { "id": "p1:cpu0", "max": 1800000, "min": 1200000, "margins": "300 1500000:150 1800000:120" },
        { "id": "p1:cpu4", "max": 2300000, "min": 1700000, "margins": "300 1900000:120" },
        { "id": "p1:cpu7", "max": 2400000, "min": 1700000, "margins": "300 2100000:120" },

        { "id": "p1:cpu0", "max": 2000000, "min": 1500000, "margins": "200 1800000:120" },
        { "id": "p2:cpu4", "max": 2400000, "min": 2000000, "margins": "300 2300000:120" },
        { "id": "p2:cpu7", "max": 2600000, "min": 2300000, "margins": "300 2600000:120" },

        { "id": "p3:cpu0", "max": 2000000, "min": 1500000, "margins": "200 1800000:100" },
        { "id": "p3:cpu4", "max": 2600000, "min": 2400000, "margin": 300 },
        { "id": "p3:cpu7", "max": 2800000, "min": 2600000, "margin": 300 },

        { "id": "p4:cpu0", "max": 2000000, "min": 1800000, "margin": 200 },
        { "id": "p4:cpu4", "max": 2800000, "min": 2600000, "margin": 300 },
        { "id": "p4:cpu7", "max": 3000000, "min": 2800000, "margin": 300 },


        { "id": "inactive:cpu0", "max": 1800000, "min": 1000000, "margin": 120 },
        { "id": "inactive:cpu4", "max": 2100000, "min": 1000000, "margin": 120 },
        { "id": "inactive:cpu7", "max": 2100000, "min": 1000000, "margin": 120 },

        { "id": "idle:cpu0", "max": 1600000, "min": 800000, "margin": 100 },
        { "id": "idle:cpu4", "max": 1800000, "min": 800000, "margin": 100 },
        { "id": "idle:cpu7", "max": 1800000, "min": 800000, "margin": 100 }
      ]
    }
  },
  "presets": {
    "reset": [
      ["@governor", "sugov_ext"],
      ["$perfmgr_enable", "#0"],
      ["/sys/class/devfreq/mtk-dvfsrc-devfreq/min_freq", "754000000"],
      ["$cpus_limit", "#3000000 3400000"]
    ],
    "min_freq": [
      ["$cpu_min_0"], ["$cpu_min_4"], ["$cpu_min_7"]
    ],
    "max_freq": [
      ["$cpu_max_0"], ["$cpu_max_4"], ["$cpu_max_7"]
    ],
    "latency": [
      ["/sys/devices/system/cpu/cpufreq/policy0/sugov_ext/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy0/sugov_ext/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy4/sugov_ext/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy4/sugov_ext/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/sugov_ext/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/sugov_ext/up_rate_limit_us"]
    ],
    "common_inactive": [
      ["@values", "min_freq", "#339000", "622000", "798000"],
      ["$uclamp_boost", "0"]
    ],
    "common_app": [
      ["@values", "latency", "1000", "1000", "1000", "1000", "1000", "1000"],
      ["@cpuset", "0-3", "0-6", "0-7", "0-7"],
      ["$gpu_max_freq", "#24"],
      ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_dram_opp_ceiling 3"],
      ["/sys/module/mtk_fpsgo/parameters/p_perf", "0"],
      ["/sys/module/mtk_fpsgo/parameters/better_perf", "0"],
      ["/sys/module/mtk_fpsgo/parameters/boost_affinity", "1"],
      ["@ioctl", "/proc/easmgr/eas_ioctl",
        "0x40046715", "500000", "0x40046717", "500000", "0x40046719", "500000"
      ]
    ],
    "common_gaming": [
      ["@values", "latency", "1000", "1000", "1000", "1000", "1000", "1000"],
      ["@limiters", "NONE"],
      ["@cpuset", "0-3", "0-5", "0-5", "0-7"],
      ["@gesture", "PAUSE"],
      ["$gpu_max_freq", "#9"],
      ["/sys/module/mtk_fpsgo/parameters/boost_affinity", "#0"],
      ["$uclamp_boost", "0"]
    ],
    "limiter_off": [
      ["/proc/game_opt/disable_cpufreq_limit", "#1"],
      ["/sys/module/migt/parameters/glk_disable", "#1"],
      ["/sys/module/perfmgr/parameters/perfmgr_enable", "#0"],
      ["/sys/module/migt/parameters/glk_freq_limit_walt", "#0"]
    ],
    "limiter_on": [
      ["/proc/game_opt/disable_cpufreq_limit", "0"],
      ["/sys/module/migt/parameters/glk_disable", "0"]
    ],

    "powersave_active": [
      ["@preset", "common_active"],
      ["@values", "min_freq", "#500000", "#622000", "#798000"],
      ["$uclamp_boost", "20"],
      ["@ioctl", "/proc/easmgr/eas_ioctl",
        "0x40046716", "15", "0x40046718", "15", "0x4004671A", "15"]
    ],
    "powersave_inactive": [
      ["@preset", "common_inactive"],
      ["@ioctl", "/proc/easmgr/eas_ioctl",
        "0x40046716", "10", "0x40046718", "8", "0x4004671A", "8"]
    ],
    "balance_active": [
      ["@preset", "common_active"],
      ["@values", "min_freq", "500000", "622000", "798000"],
      ["$uclamp_boost", "30"],
      ["@ioctl", "/proc/easmgr/eas_ioctl",
        "0x40046716", "20", "0x40046718", "18", "0x4004671A", "18"]
    ],
    "balance_inactive": [
      ["@preset", "common_inactive"],
      ["@ioctl", "/proc/easmgr/eas_ioctl",
        "0x40046716", "12", "0x40046718", "10", "0x4004671A", "10"]
    ],
    "performance_active": [
      ["@values", "min_freq", "^600000", "^700000", "^900000"],
      ["@preset", "common_active"],
      ["$uclamp_boost", "50"],
      ["@ioctl", "/proc/easmgr/eas_ioctl",
        "0x40046716", "22", "0x40046718", "20", "0x4004671A", "20"]
    ],
    "performance_inactive": [
      ["@preset", "common_inactive"],
      ["@ioctl", "/proc/easmgr/eas_ioctl",
        "0x40046716", "15", "0x40046718", "15", "0x4004671A", "15"]
    ],
    "fast_active": [
      ["@preset", "common_active"],
      ["@values", "min_freq", "^600000", "^1200000", "^900000"],
      ["$uclamp_boost", "50"],
      ["@ioctl", "/proc/easmgr/eas_ioctl",
        "0x40046716", "25", "0x40046718", "25", "0x4004671A", "25"]
    ],
    "fast_inactive": [
      ["@preset", "common_inactive"],
      ["@ioctl", "/proc/easmgr/eas_ioctl",
        "0x40046716", "18", "0x40046718", "18", "0x4004671A", "18"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "powersave_active"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@values", "max_freq", "#1600000", "#1900000", "#2300000"]
      ],
      "game": [
        ["@ioctl", "/proc/easmgr/eas_ioctl",
          "0x40046715", "500000", "0x40046716", "18",
          "0x40046717", "200000", "0x40046718", "18",
          "0x40046719", "200000", "0x4004671A", "18"
        ]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "balance_active"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@values", "max_freq", "#2100000", "#2300000", "#2800000"]
      ],
      "game": [
        ["@ioctl", "/proc/easmgr/eas_ioctl",
          "0x40046715", "500000", "0x40046716", "20",
          "0x40046717", "200000", "0x40046718", "20",
          "0x40046719", "200000", "0x4004671A", "20"
        ]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "performance_active"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@values", "max_freq", "#2400000", "#2600000", "#3200000"]
      ],
      "game": [
        ["@ioctl", "/proc/easmgr/eas_ioctl",
          "0x40046715", "500000", "0x40046716", "25",
          "0x40046717", "200000", "0x40046718", "25",
          "0x40046719", "200000", "0x4004671A", "25"
        ]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "fast_active"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["$gpu_max_freq", "#10"],
        ["@values", "max_freq", "#2400000", "#2800000", "#3400000"]
      ],
      "game": [
        ["@ioctl", "/proc/easmgr/eas_ioctl",
          "0x40046715", "500000", "0x40046716", "25",
          "0x40046717", "200000", "0x40046718", "25",
          "0x40046719", "200000", "0x4004671A", "25"
        ]
      ]
    },
    "pedestal": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "fast_active"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["$gpu_max_freq", "#5"],
        ["@values", "max_freq", "#2400000", "#3000000", "#3400000"]
      ],
      "game": [
        ["@ioctl", "/proc/easmgr/eas_ioctl",
          "0x40046715", "500000", "0x40046716", "30",
          "0x40046717", "200000", "0x40046718", "30",
          "0x40046719", "200000", "0x4004671A", "30"
        ]
      ]
    }
  },
  "apps": [
    { "friendly": "极速响应", "categories": ["Launcher"], "import": "_Launcher.json" },
    { "friendly": "扫码", "categories": ["Scanner"], "import": "_Scanner.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "双核强化",
      "packages": [
        "com.miHoYo.Yuanshen", "com.miHoYo.ys.mi", "com.miHoYo.ys.bilibili", "com.miHoYo.GenshinImpact"
      ],
      "import": "_DualCore.json"
    },
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}