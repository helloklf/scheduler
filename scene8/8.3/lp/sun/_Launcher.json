{
  "friendly": "极速响应",
  "modes": [
    {
      "mode": ["powersave"],
      "booster": {
        "duration": 3000,
        "idle_delay": 1700,
        "enter": [
          ["@preset", "powersave_active"],
          ["@limiters", "p1:cpu0", "p1:cpu6"],
          ["@preset", "cpu6_on"]
        ],
        "exit": [
          ["@preset", "powersave_inactive"],
          ["@limiters", "idle:cpu0", "idle:cpu6"]
        ]
      }
    },
    {
      "mode": ["balance"],
      "booster": {
        "duration": 3000,
        "idle_delay": 1700,
        "enter": [
          ["@preset", "balance_active"],
          ["@limiters", "p2:cpu0", "p2:cpu6"]
        ],
        "exit": [
          ["@preset", "balance_inactive"],
          ["@limiters", "inactive:cpu0", "inactive:cpu6"]
        ]
      }
    },
      {
      "mode": ["performance"],
      "booster": {
        "duration": 3000, "idle_delay": 1000,
        "enter": [ ["@preset", "performance_active"] ],
        "exit": [ ["@preset", "balance_inactive"] ]
      }
    },
      {
      "mode": ["*"],
      "booster": {
        "duration": 3000, "idle_delay": 1000,
        "enter": [
          ["@preset", "fast_active"],
          ["$sched_boost", "1"]
        ],
        "exit": [ ["@preset", "performance_inactive"] ]
      }
    }
  ]
}