{
  "friendly": "游戏(FAS)",
  "call": [
    ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_perf_mode_ceiling_opp 2"],
    ["/sys/module/mtk_fpsgo/parameters/p_perf", "1"],
    ["/sys/module/mtk_fpsgo/parameters/better_perf", "1"]
  ],
  "limiters": [
    { "id": "g1:cpu0","max": 1700000, "min": 500000, "margins": "220 1500000:120" },
    { "id": "g1:cpu4","max": 1900000, "min": 900000, "margins": "250 1700000:120" },
    { "id": "g1:cpu7","max": 2100000, "min": 900000, "margins": "250 1700000:150" },

    { "id": "g2:cpu0","max": 1700000, "min": 1200000, "margins": "220 1500000:120" },
    { "id": "g2:cpu4","max": 2100000, "min": 1700000, "margins": "250 1900000:150" },
    { "id": "g2:cpu7","max": 2400000, "min": 1700000, "margins": "250 2100000:150" },

    { "id": "g3:cpu0","max": 2000000, "min": 1400000, "margins": "250 1600000:120" },
    { "id": "g3:cpu4","max": 2400000, "min": 2000000, "margins": "250 2400000:120" },
    { "id": "g3:cpu7","max": 2800000, "min": 2300000, "margins": "250 2600000:120" },

    { "id": "g4:cpu0","max": 2000000, "min": 1500000, "margins": "300 1800000:120" },
    { "id": "g4:cpu4","max": 2800000, "min": 2400000, "margins": "250 2600000:120" },
    { "id": "g4:cpu7","max": 3000000, "min": 2600000, "margins": "250 2800000:120" }
  ],
  "modes": [
    {
      "mode": ["powersave"],
      "call": [
        ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_dram_opp_ceiling 3"],
        ["$cpufreq", "#300000 1700000 550000 2100000 600000 2300000"]
      ],
      "fas": {
        "limiters": ["g1:cpu0", "g1:cpu4", "g1:cpu7"],
        "freq": ["2300000", "2100000", "-2"]
      }
    },
    {
      "mode": ["balance"],
      "call": [
        ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_dram_opp_ceiling 3"],
        ["$cpufreq", "#300000 1700000 550000 2400000 600000 2600000"]
      ],
      "fas": {
        "limiters": ["g2:cpu0", "g2:cpu4", "g2:cpu7"],
        "freq": ["2600000", "2400000", "-2"]
      }
    },
    {
      "mode": ["performance"],
      "call": [
        ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_dram_opp_ceiling 2"],
        ["$cpufreq", "#300000 1700000 550000 2600000 600000 2800000"]
      ],
      "fas": {
        "limiters": ["g3:cpu0", "g3:cpu4", "g3:cpu7"],
        "lower_freq": 900000,
        "freq": ["2800000", "2600000", "-2"]
      }
    },
    {
      "mode": ["fast"],
      "call": [
        ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_dram_opp_ceiling 2"],
        ["$cpufreq", "#300000 1900000 550000 2850000 600000 3250000"]
      ],
      "fas": {
        "mode": "normal",
        "limiters": ["g4:cpu0", "g4:cpu4", "g4:cpu7"],
        "lower_freq": 1000000,
        "freq": ["3250000", "2850000", "-2"]
      }
    }
  ]
}