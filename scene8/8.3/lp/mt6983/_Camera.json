{
  "friendly": "相机",
  "limiters": [
    { "id": "camera:cpu0", "mode": "bottom", "max": 2000000, "margins": "220 1500000:120" },
    { "id": "camera:cpu4", "mode": "bottom", "max": 2100000, "margins": "220 1700000:120" },
    { "id": "camera:cpu7", "mode": "bottom", "max": 2300000, "margins": "220 1700000:120" }
  ],
  "call": [
    ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_enable 1|cm_mgr_perf_enable 1|dsu_mode 1"],
    ["@limiters", "camera:cpu0", "camera:cpu4", "camera:cpu7"]
  ]
}