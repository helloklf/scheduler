{
  "platform": "kalama",
  "platform_name": "8GEN2",
  "alias": {
    "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "bus_ddr_min": "/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/min_freq",
    "bus_ddr": "/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/max_freq",
    "l3_boost": "/sys/devices/system/cpu/bus_dcvs/L3/boost_freq",
    "ddr_boost": "/sys/devices/system/cpu/bus_dcvs/DDR/boost_freq",
    "perfmgr_enable": "/sys/module/perfmgr/parameters/perfmgr_enable"
  },
  "features": {
    "limiter": {
      "active_interval": 30,
      "gaming_interval": 30,
      "inactive_interval": 100,
      "logger": false,
      "params": [
        { "id": "p1:cpu0", "step": -0.8, "max": 1555200, "min": 556800, "margin": 150, "excludes": [1] },
        { "id": "p1:cpu3", "step": -0.8, "max": 1785600, "min": 614400, "margin": 220, "max_margin_ratio": 0.25 },
        { "id": "p1:cpu7", "step": -0.8, "max": 1977600, "min": 729600, "margin": 220 },

        { "id": "p2:cpu0", "step": -0.8, "max": 1555200, "min": 787200, "margin": 300 },
        { "id": "p2:cpu3", "step": -0.7, "max": 2188800, "min": 1651200, "margin": 300 },
        { "id": "p2:cpu7", "step": -0.7, "max": 2476800, "min": 1708800, "margin": 300 },

        { "id": "p3:cpu0", "step": -0.8, "max": 1670400, "min": 902400, "margin": 300 },
        { "id": "p3:cpu3", "step": -0.7, "max": 2457600, "min": 2054400, "margin": 300 },
        { "id": "p3:cpu7", "step": -0.7, "max": 2726400, "min": 2092800, "margin": 300 },

        { "id": "p4:cpu0", "step": -0.7, "max": 1804800, "min": 1228800, "margin": 300 },
        { "id": "p4:cpu3", "step": -0.7, "max": 2803200, "min": 2323200, "margin": 300 },
        { "id": "p4:cpu7", "step": -0.7, "max": 2995200, "min": 2476800, "margin": 300 },

        { "id": "inactive:cpu0", "max": 1555200, "min": 556800, "margin": 100 },
        { "id": "inactive:cpu3", "max": 1785600, "min": 614400, "margin": 120 },
        { "id": "inactive:cpu7", "max": 1843200, "min": 729600, "margin": 120 },

        { "id": "idle:cpu0", "max": 1555200, "min": 556800, "margin": 90 },
        { "id": "idle:cpu3", "max": 1651200, "min": 614400, "margin": 90 },
        { "id": "idle:cpu7", "max": 1708800, "min": 729600, "margin": 90 }
      ]
    }
  },
  "presets": {
    "reset": [
      ["@msm_reset"],
      ["$bus_ddr_min", "547000"],
      ["$l3_boost", "0"],
      ["$ddr_boost", "0"],
      ["@governor", "uag", "walt"]
    ],

    "hispeed_freq": [
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/hispeed_freq"],
      ["/sys/devices/system/cpu/cpufreq/policy3/walt/hispeed_freq"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/hispeed_freq"]
    ],
    "hispeed_load": [
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/hispeed_load"],
      ["/sys/devices/system/cpu/cpufreq/policy3/walt/hispeed_load"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/hispeed_load"]
    ],
    "latency": [
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy3/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy3/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us"]
    ],
    "min_freq": [
      ["$cpu_min_0"], ["$cpu_min_3"], ["$cpu_min_7"]
    ],
    "max_freq": [
      ["$cpu_max_0"], ["$cpu_max_3"], ["$cpu_max_7"]
    ],
    "cpu7_on": [
      ["$core_ctl_7", "1"],
      ["$max_cpus_cpu7", "#1"],
      ["$min_cpus_cpu7", "#1"]
    ],
    "cpu7_off": [
      ["$core_ctl_7", "1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#0"]
    ],
    "cpu7_auto": [
      ["$core_ctl_7", "1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#1"]
    ],
    "common_active": [
      ["@preset", "cpu7_on"],
      ["@values", "latency", "0", "1000", "0", "1000", "0", "1000"],
      ["/dev/cpuset/top-app/sf/cpus", "3-6"]
    ],
    "common_inactive": [
      ["@values", "latency", "0", "2000", "0", "2000", "0", "2000"],
      ["@values", "min_freq", "307200", "499200", "595200"],
      ["@values", "hispeed_load", "90", "90", "90"],
      ["/dev/cpuset/top-app/sf/cpus", "0-6"],
      ["$sched_boost", "#0"]
    ],
    "common_app": [
      ["$perfmgr_enable", "0"],
      ["@cpuset", "0-2", "0-6", "0-6", "0-7"],
      ["@preset", "memlat"]
    ],
    "common_gaming": [
      ["@limiters", "NONE"],
      ["@cpuset", "0-2", "0-5", "0-5", "0-7"],
      ["/dev/cpuset/top-app/sf/cpus", "3-5"],
      ["$sched_boost", "#0"],
      ["@values", "latency", "2000", "2000", "2000", "2000", "2000", "2000"],
      ["@values", "memlat", "#30", "#10", "#2", "#3187000"]
    ],

    "l3": [
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:gold/max_freq", "1804800"],
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime/max_freq", "1804800"],
      ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime-compute/max_freq", "1804800"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:l3:silver/max_freq", "1804800"]
    ],
    "l3_max": [
      ["@values", "l3", "1804800", "1804800", "1804800", "1804800"]
    ],
    "l3_low": [
      ["@values", "l3", "1574400", "1574400", "1574400", "1574400"]
    ],

    "ddr_max": [
      ["@values", "ddr", "2736000", "1555000", "4224000", "4224000", "4224000", "1555000"]
    ],
    "ddr_low": [
      ["@values", "ddr", "2736000", "1555000", "2736000", "2736000", "2736000", "1555000"]
    ],
    "ddr_mid": [
      ["@values", "ddr", "2736000", "1555000", "3187000", "3187000", "3187000", "1555000"]
    ],
    "ddr": [
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/max_freq", "2736000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:gold-compute/max_freq", "1555000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:gold/max_freq", "4224000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:prime-latfloor/max_freq", "4224000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:prime/max_freq", "4224000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:silver/max_freq", "1555000"]
    ],

    "bak_memlat": [
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/decay_rate", "90"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/window_ms", "40"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/sample_ms", "4"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/max_freq", "#2736000"]
    ],

    "powersave_active": [
      ["@preset", "common_active"],
      ["@limiters", "p1:cpu0", "p1:cpu3", "p1:cpu7"],
      ["@values", "hispeed_freq", "787200", "844800", "864000"],
      ["@values", "hispeed_load", "85", "85", "85"],
      ["@cpuset", "1", "0-6", "0-7", "0-7"]
    ],
    "powersave_inactive": [
      ["@preset", "common_inactive"],
      ["@preset", "cpu7_off"],
      ["@limiters", "idle:cpu0", "idle:cpu3", "idle:cpu7"],
      ["@values", "hispeed_freq", "0", "0", "0"]
    ],

    "balance_active": [
      ["@preset", "common_active"],
      ["@limiters", "p2:cpu0", "p2:cpu3", "p2:cpu7"],
      ["@values", "hispeed_freq", "1075200", "1056000", "1132800"],
      ["@values", "hispeed_load", "87", "87", "87"]
    ],
    "balance_inactive": [
      ["@preset", "common_inactive"],
      ["@preset", "cpu7_auto"],
      ["@limiters", "inactive:cpu0", "inactive:cpu3", "inactive:cpu7"],
      ["@values", "hispeed_freq", "787200", "844800", "864000"]
    ],

    "performance_active": [
      ["@preset", "common_active"],
      ["@limiters", "p3:cpu0", "p3:cpu3", "p3:cpu7"],
      ["@values", "hispeed_freq", "1075200", "1401600", "1478400"],
      ["@values", "hispeed_load", "85", "85", "85"]
    ],
    "performance_inactive": [
      ["@preset", "common_inactive"],
      ["@limiters", "p2:cpu0", "p2:cpu3", "p2:cpu7"],
      ["@values", "hispeed_freq", "1075200", "1056000", "1132800"]
    ],

    "fast_active": [
      ["@preset", "common_active"],
      ["@limiters", "p4:cpu0", "p4:cpu3", "p4:cpu7"],
      ["@values", "hispeed_freq", "1017600", "1555200", "1651200"],
      ["@values", "hispeed_load", "82", "82", "82"]
    ],
    "fast_inactive": [
      ["@preset", "common_inactive"],
      ["@limiters", "p3:cpu0", "p3:cpu3", "p3:cpu7"],
      ["@values", "hispeed_freq", "1075200", "1056000", "1132800"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "powersave_active"],
        ["@preset", "ddr_mid"],
        ["$bus_ddr", "2736000"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "balance_active"],
        ["$bus_ddr", "3187000"],
        ["@preset", "ddr_max"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "performance_active"],
        ["$bus_ddr", "3187000"],
        ["@preset", "ddr_max"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["$bus_ddr", "2736000"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "fast_active"],
        ["@preset", "ddr_max"],
        ["$bus_ddr", "3187000"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    }
  },
  "apps": [
    {
      "friendly": "ELP",
      "packages": [
        "com.tencent.mobileqq",
        "com.tencent.tim",
        "org.telegram.messenger"
      ],
      "categories": ["Music", "Reader", "ShortVideo", "Nav"],
      "import": "_ELP.json"
    },
    { "friendly": "极速响应", "categories": ["Launcher"], "import": "_Launcher.json" },
    { "friendly": "扫码", "categories": ["Scanner"], "import": "_Scanner.json" },
    { "friendly": "相机", "categories": ["Camera"], "import": "_Camera.json" },
    { "friendly": "待机", "packages": ["standby"], "import": "_Standby.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_FAS.json"
    }
  ]
}