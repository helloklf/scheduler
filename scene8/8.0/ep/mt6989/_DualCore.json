{
  "friendly": "游戏(Games)",
  "call": [
    ["@preset", "common_gaming"],
    ["/sys/module/mtk_fpsgo/parameters/p_perf", "1"],
    ["/sys/module/mtk_fpsgo/parameters/better_perf", "1"],
    ["/sys/kernel/fpsgo/fbt/enable_ceiling", "#0"]
  ],
  "modes": [
    {
      "mode": ["powersave"],
      "call": [
        ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_dram_opp_ceiling 3"],
        ["@values", "max_freq", "1600000", "2100000", "2100000"],
        ["@values", "min_freq", "400000", "600000", "600000"],
        ["@values", "target_loads",
          "0 1000000|1 1500000|2 1500000",
          "0 20|1 20|2 20",
          "0 15|1 15|2 15"
        ]
      ]
    },
    {
      "mode": ["balance"],
      "call": [
        ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_dram_opp_ceiling 3"],
        ["@values", "max_freq", "1700000", "2300000", "2300000"],
        ["@values", "min_freq", "700000", "800000", "800000"],
        ["@values", "target_loads",
          "0 1200000|1 1900000|2 1900000",
          "0 20|1 20|2 20",
          "0 15|1 15|2 15"
        ]
      ]
    },
    {
      "mode": ["performance"],
      "call": [
        ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_dram_opp_ceiling -1"],
        ["@values", "max_freq", "1700000", "2600000", "2600000"],
        ["@values", "min_freq", "800000", "900000", "900000"],
        ["@values", "target_loads",
          "0 1500000|1 2300000|2 2300000",
          "0 20|1 20|2 20",
          "0 15|1 15|2 15"
        ]
      ]
    },
    {
      "mode": ["*"],
      "call": [
        ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_dram_opp_ceiling -1"],
        ["@values", "max_freq", "2000000", "2800000", "2800000"],
        ["@values", "min_freq", "800000", "900000", "900000"],
        ["@values", "target_loads",
          "0 1500000|1 2500000|2 2500000",
          "0 20|1 20|2 20",
          "0 15|1 15|2 15"
        ]
      ]
    }
  ]
}