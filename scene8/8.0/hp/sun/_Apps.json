{
  "friendly": "一般应用",
  "modes": [{
    "mode": ["powersave"],
    "booster": {
      "duration": 3000,
      "idle_delay": 1700,
      "enter": [
        ["@limiters", "NONE"],
        ["@preset", "powersave_active"],
        ["@preset", "cpu6_auto"]
      ],
      "exit": [
        ["@preset", "powersave_inactive"],
        ["@limiters", "idle:cpu0", "idle:cpu6"]
      ]
    }
  }, {
    "mode": ["balance"],
    "booster": {
      "duration": 3000,
      "idle_delay": 1700,
      "enter": [
        ["@preset", "balance_active"],
        ["@preset", "cpu6_auto"]
      ],
      "exit": [
        ["@preset", "balance_inactive"]
      ]
    }
  }, {
    "mode": ["performance"],
    "booster": {
      "duration": 3000,
      "idle_delay": 1700,
      "enter": [
        ["@preset", "performance_active"]
      ],
      "exit": [
        ["@preset", "performance_inactive"]
      ]
    }
  }, {
    "mode": ["*"],
    "booster": {
      "duration": 3000,
      "idle_delay": 1700,
      "enter": [
        ["@preset", "fast_active"],
        ["$sched_boost", "1"]
      ],
      "exit": [
        ["@preset", "fast_inactive"]
      ]
    }
  }]
}