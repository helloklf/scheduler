{
  "platform": "msmnile",
  "platform_name": "855/855+",
  "alias": {
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
    "gpu_min_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/min_freq"
  },
  "features": {
    "limiter": {
      "active_interval": 30,
      "inactive_interval": 100,
      "params": [
        { "id": "p1:cpu0", "max": 1708800, "min": 1036800, "margin": 400 },
        { "id": "p1:cpu4", "max": 1708800, "min": 1056000, "margin": 300 },
        { "id": "p1:cpu7", "max": 1804800, "min": 1171200, "margin": 300 },

        { "id": "p2:cpu0", "max": 1708800, "min": 1478400, "margin": 450 },
        { "id": "p2:cpu4", "max": 2419200, "turning": 2131200, "min": 1708800, "margin": 400 },
        { "id": "p2:cpu7", "max": 2419200, "turning": 2131200, "min": 1804800, "margin": 400 },

        { "id": "p3:cpu4", "max": 2419200, "min": 2131200, "margin": 300 },
        { "id": "p3:cpu7", "max": 2841600, "min": 2419200, "margin": 300 },


        { "id": "inactive:cpu0","max": 1708800, "min": 844800, "margin": 200 },
        { "id": "inactive:cpu4","max": 1920000, "min": 768000, "margin": 170 },
        { "id": "inactive:cpu7","max": 2131200, "min": 825600, "margin": 180 },

        { "id": "idle:cpu0","max": 1600000, "min": 844800, "margin": 100 },
        { "id": "idle:cpu4","max": 1708800, "min": 768000, "margin": 100 },
        { "id": "idle:cpu7","max": 1920000, "min": 825600, "margin": 100 }
      ]
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
        ["@values", "sched_boost", "1", "1", "1", "30"]
      ],
      "exit": [
        ["@values", "sched_boost", "1", "0", "0", "0"]
      ]
    }
  },
  "presets": {
    "reset": [
      ["@msm_reset"],
      ["@thermal_threshold", "99800"],
      ["@preset", "ufshc_perf_off", "bw_max"],
      ["$gpu_min_khz", "#0"]
    ],
    "bw": [
      ["/sys/class/devfreq/soc:qcom,cpu-llcc-ddr-bw/min_freq"],
      ["/sys/class/devfreq/soc:qcom,cpu-llcc-ddr-bw/max_freq"],
      ["/sys/class/devfreq/soc:qcom,cpu-cpu-llcc-bw/min_freq"],
      ["/sys/class/devfreq/soc:qcom,cpu-cpu-llcc-bw/max_freq"]
    ],
    "ufshc_perf_on": [
      ["/sys/devices/platform/soc/1d84000.ufshc/clkscale_enable", "0"],
      ["/sys/devices/platform/soc/1d84000.ufshc/clkgate_enable", "0"],
      ["/sys/devices/platform/soc/1d84000.ufshc/hibern8_on_idle_enable", "0"],
      ["/sys/class/devfreq/1d84000.ufshc/min_freq", "300000000"]
    ],
    "ufshc_perf_off": [
      ["/sys/devices/platform/soc/1d84000.ufshc/clkscale_enable", "1"],
      ["/sys/devices/platform/soc/1d84000.ufshc/clkgate_enable", "1"],
      ["/sys/devices/platform/soc/1d84000.ufshc/hibern8_on_idle_enable", "1"],
      ["/sys/class/devfreq/1d84000.ufshc/min_freq", "37500000"]
    ],
    "sched_boost": [
      ["/proc/sys/kernel/sched_boost_top_app"],
      ["/proc/sys/kernel/sched_boost"],
      ["/dev/stune/top-app/schedtune.prefer_idle"],
      ["/dev/stune/top-app/schedtune.boost"]
    ],
    "bw_max": [
      ["@values", "bw", "762", "7980", "2288", "15258"],
      ["@values", "bw", "762", "7980", "2288", "15258"]
    ],
    "min_freq": [
      ["$cpu_min_0"], ["$cpu_min_4"], ["$cpu_min_7"]
    ],
    "max_freq": [
      ["$cpu_max_0"], ["$cpu_max_4"], ["$cpu_max_7"]
    ],
    "common_active": [
      ["$cpu_max_0", "1785600"],
      ["@cpuset", "0-3", "0-3", "1-6", "0-7"],
      ["@sched_limit", "0 0", "0 1000", "0 1000"]
    ],
    "common_inactive": [
      ["@values", "min_freq", "#300000", "#710400", "#825600"],
      ["@cpuset", "0-3", "0-3", "0-6", "0-7"],
      ["@values", "sched_boost", "0", "0", "0", "0"],
      ["@sched_limit", "0 0", "0 8000", "0 8000"]
    ],
    "common_gaming": [
      ["@limiters", "NONE"],
      ["@cpuset", "1", "1-3", "0-5", "0-7"],
      ["@values", "sched_boost", "1", "0", "0", "0"],
      ["@sched_limit", "1000 0", "1000 0", "1000 0"]
    ],
    "common_app": [
      ["@values", "sched_boost", "1", "0", "0", "0"]
    ],

    "powersave_active": [
      ["@preset", "common_active"],
      ["@limiters", "p1:cpu0", "p1:cpu4", "p1:cpu7"],
      ["@values", "min_freq", "#844800", "#710400", "#825600"]
    ],
    "powersave_inactive": [
      ["@preset", "common_inactive"],
      ["@limiters", "idle:cpu0", "idle:cpu4", "idle:cpu7"]
    ],

    "balance_active": [
      ["@preset", "common_active"],
      ["@limiters", "p2:cpu0", "p2:cpu4", "p2:cpu7"],
      ["@values", "min_freq", "#1036800", "#1056000", "#1056000"]
    ],
    "balance_inactive": [
      ["@limiters", "inactive:cpu0", "inactive:cpu4", "inactive:cpu7"],
      ["@preset", "common_inactive"]
    ],

    "performance_active": [
      ["@limiters", "p3:cpu4", "p3:cpu7"],
      ["@preset", "common_active"],
      ["@values", "min_freq", "#1036800", "#1056000", "#1171200"]
    ],
    "performance_inactive": [
      ["@limiters", "p1:cpu0", "p1:cpu4", "p1:cpu7"],
      ["@preset", "common_inactive"]
    ],

    "fast_active": [
      ["@limiters", "NONE"],
      ["@preset", "common_active"],
      ["@values", "min_freq", "#1305600", "#1497600", "#1497600"],
      ["@values", "max_freq", "#1785600", "#2419200", "#3200000"]
    ],
    "fast_inactive": [
      ["@limiters", "NONE"],
      ["@preset", "common_inactive"],
      ["@limiters", "p3:cpu4", "p3:cpu7"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "powersave_active"],
        ["@gpu_freq", "min", "610MHz"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "balance_active"],
        ["@gpu_freq", "min", "610MHz"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "performance_active"],
        ["@gpu_freq", "min", "max"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "fast_active"],
        ["@gpu_freq", "min", "max"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"]
      ]
    }
  },
  "apps": [
    {
      "friendly": "ELP",
      "packages": [
        "com.tencent.mobileqq",
        "com.tencent.tim",
        "org.telegram.messenger"
      ],
      "categories": ["Music", "Reader", "ShortVideo"],
      "import": "_ELP.json"
    },
    { "friendly": "极速响应", "categories": ["Launcher"], "import": "_Launcher.json" },
    { "friendly": "扫码", "categories": ["Scanner"], "import": "_Scanner.json" },
    { "friendly": "相机", "categories": ["Camera"], "import": "_Camera.json" },
    { "friendly": "待机", "packages": ["standby"], "import": "_Standby.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "原神",
      "categories": ["GenshinImpact"],
      "import": "_GenshinImpact.json"
    },
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}