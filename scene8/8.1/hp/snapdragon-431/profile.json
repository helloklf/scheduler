{
  "platform": "taro",
  "platform_name": "8+GEN1",
  "alias": {
    "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "bus_ddr_min": "/sys/devices/system/cpu/bus_dcvs/DDR/19091000.qcom,bwmon-ddr/min_freq",
    "bus_ddr": "/sys/devices/system/cpu/bus_dcvs/DDR/19091000.qcom,bwmon-ddr/max_freq",
    "l3_boost": "/sys/devices/system/cpu/bus_dcvs/L3/boost_freq",
    "memlat_low": "/sys/devices/system/cpu/bus_dcvs/DDR/memlat",
    "perfmgr_enable": "/sys/module/perfmgr/parameters/perfmgr_enable"
  },
  "features": {
    "limiter": {
      "params": [
        { "id": "p1:cpu0", "step": -1, "max": 1600000, "min": 700000, "margin": 250 },
        { "id": "p1:cpu4", "step": -0.7, "max": 2000000, "min": 800000, "margin": 270 },
        { "id": "p1:cpu7", "step": -0.2, "max": 2200000, "min": 1000000, "margin": 250 },

        { "id": "p2:cpu0", "max": 1800000, "min": 1100000, "margin": 280 },
        { "id": "p2:cpu4", "max": 2450000, "min": 1700000, "margin": 280 },
        { "id": "p2:cpu7", "max": 2500000, "min": 1700000, "margin": 280 },

        { "id": "p3:cpu0", "max": 1800000, "min": 1500000, "margin": 280 },
        { "id": "p3:cpu4", "max": 2600000, "min": 2250000, "margin": 280 },
        { "id": "p3:cpu7", "max": 2850000, "min": 2350000, "margin": 280 },

        { "id": "p4:cpu0", "max": 2000000, "min": 1600000, "margin": 200 },
        { "id": "p4:cpu4", "max": 2850000, "min": 2550000, "margin": 200 },
        { "id": "p4:cpu7", "max": 3000000, "min": 2550000, "margin": 200 },


        { "id": "g0:cpu0", "step": -0.7, "max": 1600000, "turning": 1400000, "min": 800000, "margin": 200 },
        { "id": "g0:cpu4", "step": -0.9, "max": 2000000, "turning": 1700000, "min": 600000, "margin": 300 },
        { "id": "g0:cpu7", "step": -0.9, "max": 2000000, "turning": 1700000, "min": 700000, "margin": 300 },

        { "id": "g1:cpu0", "step": -0.7, "max": 1600000, "turning": 1500000, "min": 1100000, "margin": 200 },
        { "id": "g1:cpu4", "step": -0.7, "max": 2200000, "turning": 1900000, "min": 800000, "margin": 300, "mode": "performance" },
        { "id": "g1:cpu7", "step": -0.7, "max": 2300000, "turning": 1900000, "min": 800000, "margin": 300, "mode": "performance" },

        { "id": "g2:cpu0", "step": -0.7, "max": 1800000, "turning": 1500000, "min": 1100000, "margin": 250 },
        { "id": "g2:cpu4", "step": -0.7, "max": 2500000, "turning": 2150000, "min": 1100000, "margin": 300, "mode": "performance" },
        { "id": "g2:cpu7", "step": -0.5, "max": 2500000, "turning": 2150000, "min": 1100000, "margin": 300, "mode": "performance" },

        { "id": "g3:cpu0", "max": 2000000, "turning": 1750000, "min": 1500000, "margin": 250 },
        { "id": "g3:cpu4", "max": 2750000, "turning": 2500000, "min": 2100000, "margin": 300 },
        { "id": "g3:cpu7", "max": 2850000, "turning": 2500000, "min": 2100000, "margin": 300 },

        { "id": "g4:cpu7", "turning": 3000000, "min": 2700000, "margin": 300 },


        { "id": "inactive:cpu0", "max": 1600000, "min": 600000, "margin": 120 },
        { "id": "inactive:cpu4", "max": 1900000, "margin": 130 },
        { "id": "inactive:cpu7", "max": 1900000, "margin": 140 },

        { "id": "idle:cpu0", "max": 1500000, "min": 500000, "margin": 90 },
        { "id": "idle:cpu4", "max": 1700000, "margin": 90 },
        { "id": "idle:cpu7", "max": 1700000, "margin": 90, "core_ctl": true }
      ]
    },
    "gesture_boost": {
      "enable": false,
      "enter": [
      ],
      "exit": [
      ]
    }
  },
  "presets": {
    "reset": [
      ["@msm_reset"],
      ["$bus_ddr_min", "547000"],
      ["@governor", "walt", "schedutil"]
    ],

    "hispeed_freq": [
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/hispeed_freq"],
      ["/sys/devices/system/cpu/cpufreq/policy4/walt/hispeed_freq"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/hispeed_freq"]
    ],
    "hispeed_load": [
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/hispeed_load"],
      ["/sys/devices/system/cpu/cpufreq/policy4/walt/hispeed_load"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/hispeed_load"]
    ],
    "latency": [
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy4/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy4/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us"]
    ],
    "target_loads": [
      ["/sys/devices/system/cpu/cpu0/cpufreq/walt/target_loads"],
      ["/sys/devices/system/cpu/cpu4/cpufreq/walt/target_loads"],
      ["/sys/devices/system/cpu/cpu7/cpufreq/walt/target_loads"]
    ],
    "min_freq": [
      ["$cpu_min_0"], ["$cpu_min_4"], ["$cpu_min_7"]
    ],
    "max_freq": [
      ["$cpu_max_0"], ["$cpu_max_4"], ["$cpu_max_7"]
    ],
    "cpu7_on": [
      ["$core_ctl_7", "#1"],
      ["$max_cpus_cpu7", "#1"],
      ["$min_cpus_cpu7", "#1"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_off": [
      ["$core_ctl_7", "#1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#0"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_auto": [
      ["$core_ctl_7", "#1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#1"]
    ],
    "common_active": [
      ["@preset", "cpu7_on"],
      ["@values", "latency", "0", "1000", "0", "1000", "0", "1000"],
      ["@uclamp", "0.00~max", "0.00~max", "0.5~max"],
      ["@values", "hispeed_load", "87", "87", "87"]
    ],
    "common_inactive": [
      ["@values", "min_freq", "307200", "633600", "787200"],
      ["@values", "latency", "0", "2000", "0", "2000", "0", "2000"],
      ["@uclamp", "0.00~max", "0.00~max", "0.00~max"],
      ["@values", "hispeed_load", "95", "95", "95"]
    ],
    "common_app": [
      ["$perfmgr_enable", "0"],
      ["@cpuset", "0-3", "0-3", "0-7", "0-7"],
      ["$l3_boost", "0"],
      ["$gpu_max_khz", "#680000000"]
    ],
    "common_gaming": [
      ["@limiters", "NONE"],
      ["@uclamp", "0.00~max", "0.00~max", "0.00~max"],
      ["@cpuset", "0-2", "0-3", "0-5", "0-7"],
      ["$gpu_max_khz", "#990000000"]
    ],

    "powersave_active": [
      ["@values", "min_freq", "556800", "633600", "787200"],
      ["@preset", "common_active"],
      ["@limiters", "p1:cpu0", "p1:cpu4", "p1:cpu7"]
    ],
    "powersave_inactive": [
      ["@preset", "common_inactive"],
      ["@preset", "cpu7_off"],
      ["@limiters", "idle:cpu0", "idle:cpu4", "idle:cpu7"]
    ],

    "balance_active": [
      ["@values", "min_freq", "556800", "633600", "787200"],
      ["@preset", "common_active"],
      ["@limiters", "p2:cpu0", "p2:cpu4", "p2:cpu7"]
    ],
    "balance_inactive": [
      ["@preset", "common_inactive"],
      ["@limiters", "inactive:cpu0", "inactive:cpu4", "inactive:cpu7"],
      ["@preset", "cpu7_auto"]
    ],

    "performance_active": [
      ["@preset", "common_active"],
      ["@limiters", "p3:cpu0", "p3:cpu4", "p3:cpu7"]
    ],
    "performance_inactive": [
      ["@preset", "common_inactive"],
      ["@limiters", "p2:cpu0", "p2:cpu4", "p2:cpu7"]
    ],

    "fast_active": [
      ["@preset", "common_active"],
      ["@limiters", "p4:cpu0", "p4:cpu4", "p4:cpu7"]
    ],
    "fast_inactive": [
      ["@preset", "common_inactive"],
      ["@limiters", "p3:cpu0", "p3:cpu4", "p3:cpu7"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "powersave_active"],
        ["$bus_ddr", "2736000"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@values", "hispeed_freq", "1056000", "0", "0"],
        ["@values", "max_freq", "1670400", "1996800", "2131200"],
        ["@values", "min_freq", "307200", "633600", "787200"],
        ["$l3_boost", "#0"],
        ["@values", "latency", "0", "2000", "0", "2000", "0", "2000"],
        ["@limiters", "g1:cpu0", "g1:cpu4", "g1:cpu7"],
        ["/proc/game_opt/disable_cpufreq_limit", "0"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "balance_active"],
        ["$bus_ddr", "2736000"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@values", "hispeed_freq", "1228800", "1113600", "1171200"],
        ["@values", "max_freq", "1670400", "2457600", "2476800"],
        ["@values", "min_freq", "691200", "633600", "787200"],
        ["$l3_boost", "#0"],
        ["@values", "latency", "0", "2000", "0", "2000", "0", "2000"],
        ["@limiters", "g2:cpu0", "g2:cpu4", "g2:cpu7"],
        ["/proc/game_opt/disable_cpufreq_limit", "0"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "performance_active"],
        ["$bus_ddr", "2736000"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@values", "max_freq", "1804800", "2572800", "2707200"],
        ["@values", "min_freq", "691200", "768000", "921600"],
        ["$l3_boost", "#0"],
        ["@limiters", "g3:cpu0", "g3:cpu4", "g3:cpu7"],
        ["/proc/game_opt/disable_cpufreq_limit", "1"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "fast_active"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["$bus_ddr", "3196000"]
      ],
      "game": [
        ["@limiters", "NONE"],
        ["$perfmgr_enable", "#0"],
        ["$l3_boost", "#1708800"],
        ["@preset", "common_gaming"],
        ["$bus_ddr", "3196000"],
        ["$bus_ddr_min", "2736000"],
        ["@values", "max_freq", "2200000", "2850000", "3200000"],
        ["@values", "min_freq",  "900000", "1200000", "1200000"],
        ["/proc/game_opt/disable_cpufreq_limit", "1"]
      ]
    }
  },
  "apps": [
    { "friendly": "极速响应", "categories": ["Launcher"], "import": "_Launcher.json" },
    { "friendly": "扫码", "categories": ["Scanner"], "import": "_Scanner.json" },
    { "friendly": "相机", "categories": ["Camera"], "import": "_Camera.json" },
    { "friendly": "待机", "packages": ["standby"], "import": "_Standby.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"]
    }
  ]
}