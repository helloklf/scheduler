  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "powersave_active"],
        ["@preset", "ddr_low"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "balance_active"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@preset", "ddr_low"]
      ],
      "game": [
        ["@preset", "ddr_max"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "performance_active"],
        ["@preset", "ddr_max"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "fast_active"],
        ["@preset", "ddr_max"]
      ],
      "app": [
        ["@preset", "common_app"]
      ]
    }
