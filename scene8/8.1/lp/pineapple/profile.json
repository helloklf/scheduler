{
    "platform": "pineapple",
    "platform_name": "8GEN3",
    "alias": {
      "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
      "mod_percent": "/sys/class/kgsl/kgsl-3d0/devfreq/mod_percent",
      "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
      "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
      "perfmgr_enable": "/sys/module/perfmgr/parameters/perfmgr_enable",
      "cpu_min_2": "/sys/devices/system/cpu/cpufreq/policy2/scaling_min_freq",
      "cpu_max_2": "/sys/devices/system/cpu/cpufreq/policy2/scaling_max_freq",
      "cpu_min_5": "/sys/devices/system/cpu/cpufreq/policy5/scaling_min_freq",
      "cpu_max_5": "/sys/devices/system/cpu/cpufreq/policy5/scaling_max_freq",
      "sched_boost": "/proc/sys/walt/sched_boost"
    },
    "features": {
      "limiter": {
        "ddr_boost": false,
        "params": [
          { "id": "p1:cpu0", "step": -0.9, "max": 1689600, "min": 672000, "margin": 150 },
          { "id": "p1:cpu2", "step": -0.9, "max": 1920000, "min": 960000, "margins": "200 1708800:120" },
          { "id": "p1:cpu5", "step": -0.9, "max": 1920000, "min": 960000, "margins": "200 1708800:120" },
          { "id": "p1:cpu7", "step": -0.8, "max": 1939200, "min": 902400, "margins": "200 1708800:120" },
  
          { "id": "p2:cpu0", "step": -0.8, "max": 1689600, "min": 787200,  "margin": 150 },
          { "id": "p2:cpu2", "step": -0.9, "max": 2380800, "min": 1612800, "margins": "200 2188800:120" },
          { "id": "p2:cpu5", "step": -0.7, "max": 2131200, "min": 1497600, "margins": "200 2188800:120" },
          { "id": "p2:cpu7", "step": -0.7, "max": 2380800, "min": 1708800, "margins": "200 2112000:150" },
  
          { "id": "p3:cpu0", "step": -0.8, "max": 1804800, "min": 1017600, "margin": 120 },
          { "id": "p3:cpu2", "step": -0.7, "max": 2515200, "min": 1920000, "margin": 300 },
          { "id": "p3:cpu5", "step": -0.7, "max": 2515200, "min": 1920000, "margin": 300 },
          { "id": "p3:cpu7", "step": -0.7, "max": 2630400, "min": 2035200, "margin": 300 },
  
          { "id": "p4:cpu0", "step": -0.8, "max": 1804800, "min": 1017600, "margin": 150 },
          { "id": "p4:cpu2", "step": -0.7, "max": 2841600, "min": 2438400, "margin": 200 },
          { "id": "p4:cpu5", "step": -0.7, "max": 2707200, "min": 2438400, "margin": 200 },
          { "id": "p4:cpu7", "step": -0.7, "max": 2803200, "min": 2438400, "margin": 300 },
  
          { "id": "inactive:cpu0", "max": 1689600, "min": 672000, "margin": 100 },
          { "id": "inactive:cpu2", "max": 1920000, "min": 614400, "margin": 120 },
          { "id": "inactive:cpu5", "max": 1920000, "min": 614400, "margin": 120 },
          { "id": "inactive:cpu7", "max": 1939200, "min": 672000, "margin": 120 },
  
          { "id": "idle:cpu0", "max": 1689600, "min": 556800, "margin": 100 },
          { "id": "idle:cpu2", "max": 1785600, "min": 614400, "margin": 100 },
          { "id": "idle:cpu5", "max": 1785600, "min": 614400, "margin": 100 },
          { "id": "idle:cpu7", "max": 1708800, "min": 672000, "margin": 100, "core_ctl": true }
        ]
      },
      "gesture_boost": {
        "enable": true,
        "enter": [
        ],
        "exit": [
          ["$sched_boost", "0"]
        ]
      }
    },
    "presets": {
      "reset": [
        ["@msm_reset"],
        ["@governor", "uag", "walt"],
        ["@preset", "limiter_off"],
        ["/sys/devices/system/cpu/bus_dcvs/L3/boost_freq", "364800"],
        ["/sys/devices/system/cpu/bus_dcvs/DDR/boost_freq", "547000"]
      ],
  
      "hispeed_freq": [
        ["/sys/devices/system/cpu/cpufreq/policy0/walt/hispeed_freq"],
        ["/sys/devices/system/cpu/cpufreq/policy2/walt/hispeed_freq"],
        ["/sys/devices/system/cpu/cpufreq/policy5/walt/hispeed_freq"],
        ["/sys/devices/system/cpu/cpufreq/policy7/walt/hispeed_freq"]
      ],
      "hispeed_load": [
        ["/sys/devices/system/cpu/cpufreq/policy0/walt/hispeed_load"],
        ["/sys/devices/system/cpu/cpufreq/policy2/walt/hispeed_load"],
        ["/sys/devices/system/cpu/cpufreq/policy5/walt/hispeed_load"],
        ["/sys/devices/system/cpu/cpufreq/policy7/walt/hispeed_load"]
      ],
      "latency": [
        ["/sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy2/walt/down_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy2/walt/up_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy5/walt/down_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy5/walt/up_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us"],
        ["/sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us"]
      ],
      "min_freq": [
        ["$cpu_min_0"], ["$cpu_min_2"], ["$cpu_min_5"], ["$cpu_min_7"]
      ],
      "max_freq": [
        ["$cpu_max_0"], ["$cpu_max_2"], ["$cpu_max_5"], ["$cpu_max_7"]
      ],
      "cpu7_on": [
        ["$core_ctl_7", "1"],
        ["$max_cpus_cpu7", "#1"],
        ["$min_cpus_cpu7", "#1"],
        ["$core_ctl_7", "#0"]
      ],
      "cpu7_off": [
        ["$core_ctl_7", "1"],
        ["$min_cpus_cpu7", "#0"],
        ["$max_cpus_cpu7", "#0"]
      ],
      "cpu7_auto": [
        ["$core_ctl_7", "1"],
        ["$min_cpus_cpu7", "#0"],
        ["$max_cpus_cpu7", "#1"]
      ],
      "limiter_off": [
        ["/proc/game_opt/disable_cpufreq_limit", "#1"],
        ["/sys/module/migt/parameters/glk_disable", "#1"],
        ["/sys/module/perfmgr/parameters/perfmgr_enable", "#0"],
        ["/sys/module/migt/parameters/glk_freq_limit_walt", "#0"]
      ],
      "limiter_on": [
        ["/proc/game_opt/disable_cpufreq_limit", "0"],
        ["/sys/module/migt/parameters/glk_disable", "0"]
      ],
      "common_active": [
        ["@preset", "cpu7_on"]
      ],
      "common_inactive": [
        ["@values", "min_freq", "307200", "499200", "499200", "480000"],
        ["$sched_boost", "0"],
        ["@values", "hispeed_load", "90", "90", "90", "90"]
      ],
      "common_app": [
        ["@cpuset", "0-1", "0-6", "2-7", "2-7"],
        ["/dev/cpuset/sf/cpus", "#2-6"],
        ["@values", "latency", "0", "2000", "0", "2000", "0", "2000", "0", "2000"],
        ["/sys/devices/system/cpu/bus_dcvs/DDRQOS/boost_freq", "0"],
        ["/sys/devices/system/cpu/bus_dcvs/LLCC/240b7400.qcom,bwmon-llcc/max_freq", "806000"],
        ["$mod_percent", "105"]
      ],
      "common_gaming": [
        ["@limiters", "NONE"],
        ["@cpuset", "0-1", "0-3,5-6", "0-3,5-6", "0-7"],
        ["/dev/cpuset/sf/cpus", "#2-3"],
        ["$sched_boost", "0"],
        ["/sys/devices/system/cpu/bus_dcvs/DDRQOS/boost_freq", "#1"],
        ["$mod_percent", "95"]
      ],

      "powersave_active": [
        ["@preset", "common_active"],
        ["@target_loads",
          "82 1574400:92",
          "82 960000:87 1612800:92",
          "82 960000:87 1612800:92",
          "82 902400:87 1708800:92"],
        ["@limiters", "p1:cpu0", "p1:cpu2", "p1:cpu5", "p1:cpu7"],
        ["@hispeed_freq", "0", "844800", "844800", "844800"],
        ["@hispeed_load", "90", "90", "90", "90"]
      ],
      "powersave_inactive": [
        ["@preset", "common_inactive"],
        ["@preset", "cpu7_off"],
        ["@target_loads",
          "85 1017600:90",
          "85 960000:90 1612800:95",
          "85 960000:90 1612800:95",
          "85 902400:90 1593600:95"],
        ["@limiters", "idle:cpu0", "idle:cpu2", "idle:cpu5", "idle:cpu7"],
        ["@hispeed_freq", "0", "0", "0", "0"]
      ],

      "balance_active": [
        ["@preset", "common_active"],
        ["@values", "min_freq", "^787200", "^729600", "^729600", "^787200"],
        ["@target_loads",
          "80 1574400:90",
          "80 1708800:85 2131200:90",
          "80 1708800:85 2131200:90",
          "80 1708800:85 2112000:90"],
        ["@limiters", "p2:cpu0", "p2:cpu2", "p2:cpu5", "p2:cpu7"],
        ["@hispeed_freq", "0", "960000", "960000", "960000"],
        ["@hispeed_load", "90", "90", "90", "90"]
      ],
      "balance_inactive": [
        ["@preset", "common_inactive"],
        ["@preset", "cpu7_auto"],
        ["@target_loads",
          "85 1017600:90",
          "85 960000:90 1612800:95",
          "85 960000:90 1612800:95",
          "85 902400:90 1593600:95"],
        ["@limiters", "inactive:cpu0", "inactive:cpu2", "inactive:cpu5", "inactive:cpu7"],
        ["@hispeed_freq", "0", "729600", "729600", "787200"],
        ["@preset", "cpu7_off"]
      ],

      "performance_active": [
        ["@preset", "common_active"],
        ["@target_loads",
          "80 1574400:90",
          "80 1708800:85 2131200:90",
          "80 1708800:85 2131200:90",
          "80 1708800:85 2112000:90"],
        ["@limiters", "p3:cpu0", "p3:cpu2", "p3:cpu5", "p3:cpu7"],
        ["@values", "min_freq", "^787200", "^844800", "^844800", "^902400"],
        ["@hispeed_freq", "0", "1075200", "1075200", "1017600"],
        ["@hispeed_load", "85", "85", "85", "85"]
      ],
      "performance_inactive": [
        ["@preset", "common_inactive"],
        ["@target_loads",
          "85 1017600:90",
          "83 960000:85 1708800:90",
          "83 960000:85 1708800:90",
          "83 902400:85 1708800:90"],
        ["@limiters", "p1:cpu0", "p1:cpu2", "p1:cpu5", "p1:cpu7"],
        ["@hispeed_freq", "0", "844800", "844800", "844800"]
      ],

      "fast_active": [
        ["@preset", "common_active"],
        ["@target_loads",
          "80 1689600:85",
          "80 2131200:85",
          "80 2131200:85",
          "80 2112000:85"],
        ["@limiters", "p4:cpu0", "p4:cpu2", "p4:cpu5", "p4:cpu7"],
        ["@values", "min_freq", "^902400", "^960000", "^960000", "^902400"],
        ["@hispeed_freq", "0", "1075200", "1286400", "1248000"],
        ["@hispeed_load", "85", "85", "85", "85"]
      ],
      "fast_inactive": [
        ["@preset", "common_inactive"],
        ["@target_loads",
          "85 1689600:90",
          "83 1708800:87 2131200:95",
          "83 1708800:87 2131200:95",
          "83 1708800:87 2112000:95"],
        ["@limiters", "p2:cpu0", "p2:cpu2", "p2:cpu5", "p2:cpu7"],
        ["@hispeed_freq", "0", "844800", "844800", "844800"]
      ]
    },
    "schemes": {
      "powersave": {
        "call": [
          ["@preset", "reset"],
          ["@preset", "powersave_active"]
        ],
        "app": [
          ["@preset", "common_app"]
        ],
        "game": [
          ["@preset", "common_gaming"],
          ["@hispeed_freq", "0", "0", "0", "0"],
          ["@values", "max_freq", "1670400", "#1824000", "#1612800", "#1708800"],
          ["@values", "min_freq", "307200", "480000", "480000", "480000"]
        ]
      },
      "balance": {
        "call": [
          ["@preset", "reset"],
          ["@preset", "balance_active"]
        ],
        "app": [
          ["@preset", "common_app"]
        ],
        "game": [
          ["@preset", "common_gaming"],
          ["@hispeed_freq", "0", "960000", "1113600", "1171200"],
          ["@values", "max_freq", "1670400", "#2131200", "#1824000", "#2092800"],
          ["@values", "min_freq", "441600", "614400", "614400", "614400"]
        ]
      },
      "performance": {
        "call": [
          ["@preset", "reset"],
          ["@preset", "performance_active"]
        ],
        "app": [
          ["@preset", "common_app"]
        ],
        "game": [
          ["@preset", "common_gaming"],
          ["@values", "max_freq", "1804800", "#2438400", "#2246400", "#2476800"],
          ["@values", "min_freq", "672000", "729600", "614400", "787200"]
        ]
      },
      "fast": {
        "call": [
          ["@preset", "reset"],
          ["@preset", "fast_active"]
        ],
        "app": [
          ["@preset", "common_app"]
        ],
        "game": [
          ["@preset", "common_gaming"],
          ["@values", "max_freq", "#1804800", "#2841600", "#2630400", "#2803200"],
          ["@values", "min_freq", "1056000", "960000", "844800", "902400"]
        ]
      }
    },
    "apps": [
      {
        "friendly": "ELP",
        "packages": [
          "com.tencent.mobileqq",
          "com.tencent.tim",
          "org.telegram.messenger"
        ],
        "categories": ["Music", "Reader", "ShortVideo", "Nav"],
        "import": "_ELP.json"
      },
      { "friendly": "极速响应", "categories": ["Launcher"], "import": "_Launcher.json" },
      { "friendly": "扫码", "categories": ["Scanner"], "import": "_Scanner.json" },
      { "friendly": "相机", "categories": ["Camera"], "import": "_Camera.json" },
      { "friendly": "待机", "packages": ["standby"], "import": "_Standby.json" },
      { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
    ],
    "games": [
      {
        "friendly": "All",
        "packages": ["*"],
        "import": "_FAS.json"
      }
    ]
  }