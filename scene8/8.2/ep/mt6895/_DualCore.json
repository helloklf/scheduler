{
  "friendly": "游戏(双核强化)",
  "call": [
    ["@preset", "common_gaming"],
    ["@limiters", "NONE"]
  ],
  "modes": [
    {
      "mode": ["powersave"],
      "call": [
        ["@values", "max_freq", "#1800000", "#2300000", "#2300000"],
        ["@values", "min_freq",  "#700000",  "#500000",  "#500000"],
        ["$ddr_freq_min", "#1866000000"]
      ]
    },
    {
      "mode": ["balance"],
      "call": [
        ["@values", "max_freq", "#2000000", "#2450000", "#2450000"],
        ["@values", "min_freq",  "#800000",  "#700000", "#700000"],
        ["$ddr_freq_min", "#2667000000"]
      ]
    },
    {
      "mode": ["performance"],
      "call": [
        ["@values", "max_freq", "#2000000", "#2850000", "#2850000"],
        ["@values", "min_freq",  "#1000000", "#900000", "#900000"],
        ["$ddr_freq_min", "#3200000000"]
      ]
    },
    {
      "mode": ["fast"],
      "call": [
        ["@values", "max_freq", "#2000000", "#2850000", "#3100000"],
        ["@values", "min_freq", "#1200000", "#1200000", "#1200000"],
        ["$ddr_freq_min", "#5500000000"],
        ["$ddr_max", "#6400000000"]
      ]
    },
    {
      "mode": ["*"],
      "call": [
        ["@values", "max_freq", "#2000000", "#3000000", "#3100000"],
        ["@values", "min_freq", "#1200000", "#1600000", "#1600000"],
        ["$ddr_freq_min", "#5500000000"],
        ["$ddr_max", "#6400000000"]
      ]
    }
  ]
}