{
  "friendly": "游戏",
  "limiters": [
    { "id": "gboost:cpu0", "max": 1200000, "min":  800000, "turning": 1200000, "margin": 300, "mode": "bottom" },
    { "id": "gboost:cpu4", "max": 2650000, "min": 1300000, "turning": 2450000, "margin": 500, "mode": "bottom" },
    { "id": "gboost:cpu7", "max": 2800000, "min": 1300000, "turning": 2650000, "margin": 500, "mode": "bottom" }
  ],
  "call": [
    ["@preset", "comm_gaming"]
  ],
  "modes": [
    {
      "mode": ["powersave"],
      "call": [
        ["@values", "max_freq", "#1500000", "#2000000", "#2100000"],
        ["@values", "min_freq",  "#500000",  "#900000", "#1300000"],
        ["$ddr_freq_min", "#1866000000"]
      ]
    },
    {
      "mode": ["balance"],
      "call": [
        ["@values", "max_freq", "#1500000", "#2300000", "#2400000"],
        ["@values", "min_freq",  "#700000",  "#700000", "#1300000"],
        ["$ddr_freq_min", "#1866000000"]
      ]
    },
    {
      "mode": ["performance"],
      "call": [
        ["@values", "max_freq", "#1600000", "#2650000", "#2800000"],
        ["@values", "min_freq",  "#700000", "#1100000", "#1300000"],
        ["$ddr_freq_min", "#2667000000"]
      ]
    },
    {
      "mode": ["fast"],
      "call": [
        ["@values", "max_freq", "#1800000", "#2850000", "#3000000"],
        ["@values", "min_freq",  "#700000", "#1300000", "#1300000"],
        ["@limiters", "gboost:cpu0", "gboost:cpu4", "gboost:cpu7"],
        ["$ddr_freq_min", "#3200000000"]
      ]
    },
    {
      "mode": ["*"],
      "call": [
        ["@values", "max_freq", "#1800000", "#2850000", "#3000000"],
        ["@values", "min_freq", "#700000", "#1300000", "#1300000"],
        ["$ddr_freq_min", "#5500000000"]
      ]
    }
  ]
}