{
  "platform": "mt6895",
  "platform_name": "D8100",
  "alias": {
    "boost_affinity": "/sys/module/mtk_fpsgo/parameters/boost_affinity",
    "ddr_freq_min": "/sys/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/min_freq",
    "ddr_freq_max": "/sys/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/max_freq",
    "ddr_freq_cust": "/sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq",
    "ged_kpi": "/sys/module/sspm_v3/holders/ged/parameters/is_GED_KPI_enabled",
    "fpsgo": "/sys/kernel/fpsgo/common/fpsgo_enable",
    "cpufreq": "/proc/cpudvfs/cpufreq_debug",
    "perfmgr_enable": "/sys/module/mtk_fpsgo/parameters/perfmgr_enable",
    "ddr_max": "/sys/class/devfreq/mtk-dvfsrc-devfreq/max_freq",
    "sched_boost": "/sys/kernel/fpsgo/fbt/switch_idleprefer",
    "enable_ceiling": "/sys/kernel/fpsgo/fbt/enable_ceiling"
  },
  "features": {
    "limiter": {
      "active_interval": 30,
      "gaming_interval": 30,
      "inactive_interval": 100,
      "ddr_boost": false,
      "params": [
        { "id": "p1:cpu0", "max": 2000000, "min": 1600000, "margin": 500 },
        { "id": "p1:cpu4", "max": 2450000, "turning": 2100000, "min": 1600000, "margin": 350 },
        { "id": "p1:cpu7", "max": 2600000, "turning": 2100000, "min": 1800000, "margin": 350 },

        { "id": "p2:cpu4", "max": 2650000, "min": 2350000, "margin": 400 },
        { "id": "p2:cpu7", "max": 2850000, "min": 2450000, "margin": 400 },

        { "id": "p3:cpu4", "max": 2850000, "min": 2450000, "margin": 350 },
        { "id": "p3:cpu7", "max": 3100000, "min": 2650000, "margin": 350 },

        { "id": "inactive:cpu0", "max": 1800000, "turning": 1600000, "min": 700000, "margin": 400 },
        { "id": "inactive:cpu4", "max": 2000000, "min": 500000, "margin": 180 },
        { "id": "inactive:cpu7", "max": 2300000, "min": 700000, "margin": 220 },

        { "id": "idle:cpu0", "max": 1800000, "min": 600000, "margin": 150 },
        { "id": "idle:cpu4", "max": 1800000, "min": 400000, "margin": 120 },
        { "id": "idle:cpu7", "max": 2000000, "min": 500000, "margin": 140 }
      ]
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
        ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"],
        ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "521000"],
        ["$ddr_freq_cust", "4266000000"]
      ],
      "exit": [
        ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"],
        ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "0"],
        ["$ddr_freq_cust", "#0"]
      ]
    }
  },
  "presets": {
    "reset": [
      ["@mtk_reset"],
      ["@governor", "schedutil"],
      ["$perfmgr_enable", "#0"],
      ["$boost_affinity", "#0"]
    ],
    "min_freq": [
      ["$cpu_min_0"], ["$cpu_min_4"], ["$cpu_min_7"]
    ],
    "max_freq": [
      ["$cpu_max_0"], ["$cpu_max_4"], ["$cpu_max_7"]
    ],
    "common_actvie": [
      ["$cpu_max_0", "2000000"]
    ],
    "common_inactvie": [
      ["@values", "min_freq", "450000", "200000", "500000"],
      ["$ddr_freq_min", "#800000000"],
      ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"]
    ],
    "common_app": [
      ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_enable 1|cm_mgr_perf_enable 1"],
      ["@cpuset", "0-3", "0-7", "0-7", "0-7"],
      ["/sys/kernel/ged/hal/custom_upbound_gpu_freq", "#07"],
      ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"],
      ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "0"],
      ["$ddr_max", "#5500000000"]
    ],
    "common_gaming": [
      ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_enable 1|cm_mgr_perf_enable 1"],
      ["@cpuset", "0-2", "1-3", "0-5", "0-7"],
      ["/sys/kernel/ged/hal/custom_upbound_gpu_freq", "#0"],
      ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "#99"],
      ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "#0"],
      ["$ddr_freq_cust", "0"],
      ["@limiters", "NONE"],
      ["$ddr_max", "#5500000000"],
      ["$sched_boost", "#0"],
      ["$enable_ceiling", "#0"],
      ["$fpsgo", "#1"],
      ["$ged_kpi", "#0"]
    ],

    "powersave_active": [
      ["@limiters", "p1:cpu0", "p1:cpu4", "p1:cpu7"],
      ["@values", "min_freq", "800000", "500000", "600000"],
      ["$ddr_freq_min", "#2133000000"],
      ["@preset", "common_actvie"]
    ],
    "powersave_inactive": [
      ["@limiters", "idle:cpu0", "idle:cpu4", "idle:cpu7"],
      ["@preset", "common_inactvie"]
    ],
    "balance_active": [
      ["@limiters", "p2:cpu4", "p2:cpu7"],
      ["@values", "min_freq", "1000000", "900000", "800000"],
      ["$ddr_freq_min", "#2133000000"],
      ["@preset", "common_actvie"]
    ],
    "balance_inactive": [
      ["@limiters", "inactive:cpu0", "inactive:cpu4", "inactive:cpu7"],
      ["@preset", "common_inactvie"]
    ],
    "performance_active": [
      ["@limiters", "p3:cpu4", "p3:cpu7"],
      ["@values", "min_freq", "1200000", "1600000", "1600000"],
      ["$ddr_freq_min", "3200000000"],
      ["@preset", "common_actvie"]
    ],
    "performance_inactive": [
      ["@limiters", "p2:cpu4", "p2:cpu7"],
      ["@preset", "common_inactvie"]
    ],
    "fast_active": [
      ["@values", "max_freq", "2000000", "2850000", "3100000"],
      ["@values", "min_freq", "1200000", "1600000", "1600000"],
      ["$ddr_freq_min", "3200000000"],
      ["@preset", "common_actvie"]
    ],
    "fast_inactive": [
      ["@limiters", "p3:cpu4", "p3:cpu7"],
      ["@preset", "common_inactvie"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "reset"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@preset", "powersave_active"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "reset"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@preset", "balance_active"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "reset"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@preset", "performance_active"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "reset"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@preset", "fast_active"]
      ]
    },
    "pedestal": {
      "call": [
        ["@preset", "reset"]
      ],
      "app": [
        ["@preset", "comm_app"],
        ["@preset", "fast_active"]
      ]
    }
  },
  "apps": [
    {
      "friendly": "极速响应",
      "categories": ["Launcher"],
      "import": "_Launcher.json"
    },
    {
      "friendly": "待机",
      "packages": ["standby"],
      "import": "_Standby.json"
    },
    {
      "friendly": "扫码",
      "categories": ["Scanner"],
      "import": "_Scanner.json"
    },
    {
      "friendly": "相机",
      "categories": ["Camera"],
      "import": "_Camera.json"
    },
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Apps.json"
    }
  ],
  "games": [
    {
      "friendly": "双核强化",
      "packages": [
        "com.miHoYo.Yuanshen", "com.miHoYo.ys.mi", "com.miHoYo.ys.bilibili", "com.miHoYo.GenshinImpact",
        "com.tencent.tmgp.pubgmhd", "com.tencent.tmgp.pubgmhdce", "com.tencent.ig",
        "com.miHoYo.hkrpg", "com.miHoYo.hkrpg.bilibili", "com.HoYoverse.hkrpgoversea"
      ],
      "import": "_DualCore.json"
    },
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}