{
  "friendly": "游戏(双核强化)",
  "limiters": [
    { "id": "dual_boost:cpu0", "max": 1200000, "min":  800000, "turning": 1200000, "margin": 300, "mode": "bottom" },
    { "id": "dual_boost:cpu4", "max": 2650000, "min": 1300000, "turning": 2450000, "margin": 500, "mode": "bottom" },
    { "id": "dual_boost:cpu7", "max": 2800000, "min": 1300000, "turning": 2650000, "margin": 450, "mode": "bottom" }
  ],
  "call": [
    ["@preset", "comm_gaming"],
    ["$perfmgr_enable", "#0"],
    ["$fpsgo", "#0"],
    ["$ged_kpi", "#0"]
  ],
  "modes": [
    {
      "mode": ["powersave"],
      "call": [
        ["@values", "max_freq", "#1500000", "#2100000", "#1900000"],
        ["@values", "min_freq", "#500000", "#900000", "#1300000"],
        ["$ddr_freq_min", "#1866000000"]
      ]
    },
    {
      "mode": ["balance"],
      "call": [
        ["@values", "max_freq", "#1500000", "#2450000", "#2200000"],
        ["@values", "min_freq", "#700000", "#700000", "#1300000"],
        ["$ddr_freq_min", "#1866000000"]
      ]
    },
    {
      "mode": ["performance"],
      "call": [
        ["@values", "max_freq", "#1600000", "#2650000", "#2450000"],
        ["@values", "min_freq", "#700000", "#1300000", "#1300000"],
        ["$ddr_freq_min", "#2667000000"]
      ]
    },
    {
      "mode": ["fast"],
      "call": [
        ["@values", "max_freq", "#1800000", "#2850000", "#2800000"],
        ["@values", "min_freq", "#700000", "#1300000", "#1300000"],
        ["@limiters", "dual_boost:cpu0", "dual_boost:cpu4", "dual_boost:cpu7"],
        ["$ddr_freq_min", "#3200000000"]
      ]
    },
    {
      "mode": ["*"],
      "call": [
        ["@values", "max_freq", "#1800000", "#2850000", "#2800000"],
        ["@values", "min_freq", "#700000", "#1300000", "#1300000"],
        ["@limiters", "dual_boost:cpu0", "dual_boost:cpu4", "dual_boost:cpu7"],
        ["$ddr_freq_min", "#5500000000"]
      ]
    }
  ]
}