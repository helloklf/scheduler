{
  "friendly": "All",
  "match": [],
  "packages": ["*"],
  "sensors": [],
  "modes": [{
    "mode": ["powersave"],
    "booster": {
      "duration": 1500,
      "idle_delay": 800,
      "enter": [["@preset", "powersave_active"]],
      "exit": [["@preset", "powersave_inactive"]]
    }
  }, {
    "mode": ["balance"],
    "booster": {
      "duration": 2000,
      "idle_delay": 1000,
      "enter": [["@preset", "balance_active"]],
      "exit": [["@preset", "balance_inactive"]]
    }
  }, {
    "mode": ["performance"],
    "booster": {
      "duration": 2000,
      "idle_delay": 1000,
      "enter": [
        ["@preset", "performance_active"],
        ["@values", "sched_boost", "1", "2", "1", "0"]
      ],
      "exit": [["@preset", "performance_inactive"]]
    }
  }, {
    "mode": ["fast"],
    "booster": {
      "duration": 2000,
      "idle_delay": 1000,
      "enter": [
        ["@preset", "fast_active"],
        ["@values", "sched_boost", "1", "2", "1", "25"]
      ],
      "exit": [["@preset", "fast_inactive"]]
    }
  }]
}