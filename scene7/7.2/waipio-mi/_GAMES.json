{
  "friendly": "游戏",
  "sensors": [
    {
      "sensor": "battery",
      "interval": 5000,
      "logger": false,
      "rules": [
        { "threshold": [-1, 52], "enter_once": [["@values", "latency", "0", "8000", "0", "8000", "0", "8000"]] },
        { "threshold": [52, 48], "enter_once": [["@values", "latency", "0", "4000", "0", "4000", "0", "4000"]] },
        { "threshold": [48, 45], "enter_once": [["@values", "latency", "0", "3000", "0", "3000", "0", "3000"]] },
        { "threshold": [45, 41], "enter_once": [["@values", "latency", "0", "2000", "0", "2000", "0", "2000"]] },
        { "threshold": [41, -1], "enter_once": [["@values", "latency", "1000", "2000", "1000", "2000", "1000", "2000"]] }
      ]
    }
  ],
  "modes": [
    {
      "mode": ["powersave"],
      "call": [
        ["@values", "max_freq", "1574400", "1651200", "1728000"],
        ["@limiters", "g1:cpu0", "g1:cpu4", "g1:cpu7"]
      ]
    },
    {
      "mode": ["balance"],
      "call": [
        ["@values", "max_freq", "1574400", "1881600", "1958400"],
        ["@limiters", "g2:cpu0", "g2:cpu4", "g2:cpu7"]
      ]
    },
    {
      "mode": ["performance"],
      "call": [
        ["@values", "max_freq", "1689600", "1996800", "2169600"],
        ["@limiters", "g3:cpu0", "g3:cpu4", "g3:cpu7"]
      ]
    },
    {
      "mode": ["*"],
      "call": [
        ["@values", "max_freq", "1689600", "2112000", "2400000"],
        ["@limiters", "g4:cpu0", "g4:cpu4", "g4:cpu7"]
      ]
    }
  ]
}