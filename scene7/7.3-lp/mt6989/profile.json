{
  "platform": "mt6989",
  "platform_name": "D9300",
  "alias": {
    "boost_affinity": "/sys/module/mtk_fpsgo/parameters/boost_affinity",
    "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
    "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
    "ddr_freq_min": "/sys/class/devfreq/mtk-dvfsrc-devfreq/min_freq",
    "ddr_freq_cust": "/sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq",
    "ged_kpi": "/sys/module/sspm_v3/holders/ged/parameters/is_GED_KPI_enabled",
    "fpsgo": "/sys/kernel/fpsgo/common/fpsgo_enable",
    "perfmgr_enable": "/sys/module/mtk_fpsgo/parameters/perfmgr_enable",
    "ddr_max": "/sys/class/devfreq/mtk-dvfsrc-devfreq/max_freq",
    "gpu_max_freq": "/sys/kernel/ged/hal/custom_upbound_gpu_freq",
    "gpu_min_opp": "/sys/kernel/ged/hal/custom_boost_gpu_freq",
    "cpufreq": "/proc/powerhal_cpu_ctrl/perfserv_freq"
  },
  "features": {
    "limiter": {
      "active_interval": 30,
      "gaming_interval": 30,
      "inactive_interval": 100,
      "ddr_boost": false,
      "params": [
        { "id": "p1:cpu0", "step": -0.50, "max": 1700000, "turning": 1500000, "min": 500000, "margin": 300 },
        { "id": "p1:cpu4", "step": -0.50, "max": 2100000, "turning": 1900000, "min": 900000, "margin": 300 },
        { "id": "p1:cpu7", "step": -0.2, "max": 2400000, "turning": 2100000, "min": 900000, "margin": 300 },

        { "id": "p2:cpu0", "max": 1700000, "turning": 1500000, "min": 1200000, "margin": 300 },
        { "id": "p2:cpu4", "max": 2400000, "turning": 2100000, "min": 1700000, "margin": 300 },
        { "id": "p2:cpu7", "max": 2650000, "turning": 2300000, "min": 1800000, "margin": 300 },

        { "id": "p3:cpu0", "max": 1800000, "turning": 1600000, "min": 1400000, "margin": 300 },
        { "id": "p3:cpu4", "max": 2600000, "turning": 2400000, "min": 2100000, "margin": 300 },
        { "id": "p3:cpu7", "max": 2800000, "turning": 2600000, "min": 2100000, "margin": 300 },

        { "id": "p4:cpu0", "max": 2000000, "min": 1500000, "margin": 300 },
        { "id": "p4:cpu4", "max": 2850000, "turning": 2600000, "min": 2400000, "margin": 300 },
        { "id": "p4:cpu7", "max": 3050000, "turning": 2800000, "min": 2600000, "margin": 300 },


        { "id": "inactive:cpu0","max": 1800000, "min": 500000, "margin": 120 },
        { "id": "inactive:cpu4","max": 1800000, "min": 550000, "margin": 120 },
        { "id": "inactive:cpu7","max": 1800000, "min": 600000, "margin": 120 },

        { "id": "idle:cpu0","max": 1600000, "min": 500000, "margin": 100 },
        { "id": "idle:cpu4","max": 1600000, "min": 550000, "margin": 100 },
        { "id": "idle:cpu7","max": 1600000, "min": 600000, "margin": 100, "core_ctl": true }
      ]
    },
    "cpuset": {
      "ipc": [0, 1.175, 1.275]
    },
    "gesture_boost": {
      "enable": false,
      "enter": [],
      "exit": []
    }
  },
  "presets": {
    "reset": [
      ["@governor", "sugov_ext"],
      ["$perfmgr_enable", "#0"],
      ["/sys/class/devfreq/mtk-dvfsrc-devfreq/min_freq", " 754000000"]
    ],
    "min_freq": [
      ["$cpu_min_0"], ["$cpu_min_4"], ["$cpu_min_7"]
    ],
    "max_freq": [
      ["$cpu_max_0"], ["$cpu_max_4"], ["$cpu_max_7"]
    ],
    "common_actvie": [
    ],
    "common_inactvie": [
      ["@values", "min_freq", "#300000", "#550000", "#600000"]
    ],
    "comm_app": [
      ["@cpuset", "0-3", "0-6", "0-6", "0-7"],
      ["@preset", "freq_extreme"],
      ["$gpu_max_freq", "#14"]
    ],
    "comm_gaming": [
      ["@limiters", "NONE"],
      ["@cpuset", "0-3", "0-5", "0-5", "0-7"],
      ["$gpu_max_freq", "#22"]
    ],

    "powersave_active": [
      ["@limiters", "p1:cpu0", "p1:cpu4", "p1:cpu7"],
      ["@preset", "common_actvie"],
      ["@values", "min_freq", "400000", "#550000", "#600000"]
    ],
    "powersave_inactive": [
      ["@limiters", "idle:cpu0", "idle:cpu4", "idle:cpu7"],
      ["@preset", "common_inactvie"]
    ],
    "balance_active": [
      ["@limiters", "p2:cpu0", "p2:cpu4", "p2:cpu7"],
      ["@preset", "common_actvie"],
      ["@values", "min_freq", "500000", "550000", "700000"]
    ],
    "balance_inactive": [
      ["@limiters", "inactive:cpu0", "inactive:cpu4", "inactive:cpu7"],
      ["@preset", "common_inactvie"]
    ],
    "performance_active": [
      ["@limiters", "p3:cpu0", "p3:cpu4", "p3:cpu7"],
      ["@values", "min_freq", "700000", "700000", "700000"],
      ["@preset", "common_actvie"]
    ],
    "performance_inactive": [
      ["@limiters", "p2:cpu0", "p2:cpu4", "p2:cpu7"],
      ["@preset", "common_inactvie"]
    ],
    "fast_active": [
      ["@limiters", "p4:cpu0", "p4:cpu4", "p4:cpu7"],
      ["@preset", "common_actvie"],
      ["@values", "min_freq", "700000", "700000", "700000"]
    ],
    "fast_inactive": [
      ["@limiters", "p3:cpu0", "p3:cpu4", "p3:cpu7"],
      ["@preset", "common_inactvie"]
    ],
    "freq_low": [
      ["$cpufreq", "#300000 1700000 550000 2100000 600000 2100000"],
      ["@values", "max_freq", "1700000", "2100000", "2100000"],
      ["@values", "min_freq", "300000", "550000", "600000"]
    ],
    "freq_middle": [
      ["$cpufreq", "#300000 1700000 550000 2400000 600000 2400000"],
      ["@values", "max_freq", "1700000", "2400000", "2400000"],
      ["@values", "min_freq", "300000", "550000", "600000"]
    ],
    "freq_high": [
      ["$cpufreq", "#300000 1700000 550000 2650000 600000 2800000"],
      ["@values", "max_freq", "1700000", "2650000", "2800000"],
      ["@values", "min_freq", "300000", "550000", "600000"]
    ],
    "freq_extreme": [
      ["$cpufreq", "#300000 1900000 550000 2850000 600000 3250000"],
      ["@values", "max_freq", "1900000", "2850000", "3250000"],
      ["@values", "min_freq", "300000", "550000", "600000"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "powersave_active"]
      ],
      "app": [
        ["@preset", "comm_app"]
      ],
      "game": [
        ["@preset", "comm_gaming"],
        ["@preset", "freq_low"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "balance_active"]
      ],
      "app": [
        ["@preset", "comm_app"]
      ],
      "game": [
        ["@preset", "comm_gaming"],
        ["@preset", "freq_middle"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "performance_active"]
      ],
      "app": [
        ["@preset", "comm_app"]
      ],
      "game": [
        ["@preset", "comm_gaming"],
        ["@preset", "freq_high"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "fast_active"]
      ],
      "app": [
        ["@preset", "comm_app"]
      ],
      "game": [
        ["@preset", "comm_gaming"],
        ["@preset", "freq_extreme"]
      ]
    }
  },
  "apps": [
    {
      "friendly": "ELP",
      "packages": [
        "com.tencent.mobileqq",
        "com.tencent.tim",
        "org.telegram.messenger"
      ],
      "categories": ["Music", "Reader", "ShortVideo", "Nav"],
      "import": "_ELP.json"
    },
    { "friendly": "极速响应", "categories": ["Launcher"], "import": "_Launcher.json" },
    { "friendly": "扫码", "categories": ["Scanner"], "import": "_Scanner.json" },
    { "friendly": "相机", "categories": ["Camera"], "import": "_Camera.json" },
    { "friendly": "待机", "packages": ["standby"], "import": "_Standby.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_FAS.json"
    }
  ]
}