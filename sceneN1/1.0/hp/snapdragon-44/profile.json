{
  "alias": {
    "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
    "max_cpus_cpu4": "/sys/devices/system/cpu/cpu4/core_ctl/max_cpus",
    "min_cpus_cpu4": "/sys/devices/system/cpu/cpu4/core_ctl/min_cpus",
    "msm_min_freq": "/sys/module/msm_performance/parameters/cpu_min_freq",
    "msm_max_freq": "/sys/module/msm_performance/parameters/cpu_max_freq",
    "llcc_ddr_max": "/sys/class/devfreq/soc:qcom,cpu-llcc-ddr-bw/max_freq",
    "cpu_llcc_max": "/sys/class/devfreq/soc:qcom,cpu-cpu-llcc-bw/max_freq",
    "llcc_ddr_min": "/sys/class/devfreq/soc:qcom,cpu-llcc-ddr-bw/min_freq",
    "cpu_llcc_min": "/sys/class/devfreq/soc:qcom,cpu-cpu-llcc-bw/min_freq"
  },
  "features": {
    "limiter": {
      "limiters": {
        "p1": {
          "mode": "full",
          "cpus": [
            { "max": 1766400, "min": 403200, "margins": "300 1228800:200", "mt": 30, "excludes": [1] },
            { "max": 2323200, "min": 825600, "margins": "150 1843200:100" }
          ]
        },
        "p2": {
          "mode": "full",
          "cpus": [
            { "max": 1766400, "min": 576000,  "margins": "300 1228800:250", "excludes": [1] },
            { "max": 2649600, "min": 1056000, "margins": "240 1843200:150" }
          ]
        },
        "p3": {
          "mode": "full",
          "cpus": [
            { "max": 1766400, "min": 576000,  "margins": "400 1228800:300", "excludes": [1] },
            { "max": 2649600, "min": 1056000, "margins": "300 1920000:200" }
          ]
        },
        "p4": {
          "mode": "full",
          "cpus": [
            { "max": 1766400, "min": 576000, "margin": 400, "excludes": [1] },
            { "max": 2803200, "min": 1056000, "margin": 400 }
          ]
        },
        "inactive": {
          "mode": "full",
          "cpus": [
            { "max": 1689600, "min": 576000, "margin": 150 },
            { "max": 1996800, "min": 825600, "margin": 150 }
          ]
        },
        "idle": {
          "mode": "full",
          "cpus": [
            { "max": 1612800, "min": 576000, "margin": 150 },
            { "max": 1766400, "min": 825600, "margin": 100 }
          ]
        }
      }
    }
  },
  "presets": {
    "reset": [
      ["@ttj", "100000"],
      ["@msm_reset"]
    ],
    "hispeed_freq": [
      ["/sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_freq"],
      ["/sys/devices/system/cpu/cpufreq/policy4/schedutil/hispeed_freq"]
    ],
    "hispeed_load": [
      ["/sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_load"],
      ["/sys/devices/system/cpu/cpufreq/policy4/schedutil/hispeed_load"]
    ],
    "sched_config": [
      ["/proc/sys/kernel/sched_downmigrate"],
      ["/proc/sys/kernel/sched_upmigrate"],
      ["/proc/sys/kernel/sched_group_downmigrate"],
      ["/proc/sys/kernel/sched_group_upmigrate"]
    ],
    "sched_boost": [
      ["/proc/sys/kernel/sched_boost_top_app"],
      ["/proc/sys/kernel/sched_boost"],
      ["/dev/stune/top-app/schedtune.prefer_idle"],
      ["/dev/stune/top-app/schedtune.boost"]
    ],
    "min_freq": [
      ["$cpu_min_0"], ["$cpu_min_4"]
    ],
    "max_freq": [
      ["$cpu_max_0"], ["$cpu_max_4"]
    ],
    "common_active": [
      ["$cpu_max_0", "1766400"],
      ["@cpu_freqs_min", "#576000", "#825600"],
      ["@cpuset", "1", "0-3", "0-5", "0-7"],
      ["@preset", "cores_force_on"]
    ],
    "common_inactive": [
      ["@cpu_freqs_min", "#576000", "#825600"],
      ["@cpuset", "0-3", "0-3", "0-5", "0-7"]
    ],

    "bw_max": [
    ],
    "bw_low": [
    ],
    "cores_force_on": [
      ["$core_ctl_4", "1"], ["$max_cpus_cpu4", "4"], ["$min_cpus_cpu4", "4"], ["$core_ctl_4", "0"]
    ],
    "cores_force_off": [
      ["$core_ctl_4", "1"], ["$min_cpus_cpu4", "0"], ["$max_cpus_cpu4", "0"], ["$core_ctl_4", "0"]
    ],
    "cores_auto_off": [
      ["$core_ctl_4", "1"], ["$min_cpus_cpu4", "0"], ["$max_cpus_cpu4", "4"]
    ],

    "powersave_active": [
      ["@preset", "common_active"],
      ["@limiter", "p1"],
      ["@repeat", "sched_config", "70", "80", "150", "400"],
      ["@sched_limit", "0 0", "0 0"]
    ],
    "powersave_inactive": [
      ["@preset", "common_inactive"],
      ["@limiter", "idle"],
      ["@repeat", "sched_config", "85", "95", "150", "400"],
      ["@sched_limit", "0 0", "0 4000"]
    ],
    "powersave_idle": [
      ["@limiter", "idle"],
      ["@preset", "common_inactive"],
      ["@repeat", "sched_config", "85", "95", "150", "400"],
      ["@sched_limit", "0 0", "0 8000"]
    ],

    "balance_active": [
      ["@preset", "common_active"],
      ["@limiter", "p2"],
      ["@repeat", "sched_config", "65", "75", "150", "400"],
      ["@sched_limit", "0 0", "0 0"]
    ],
    "balance_inactive": [
      ["@limiter", "inactive"],
      ["@preset", "common_inactive"],
      ["@repeat", "sched_config", "85", "95", "150", "400"],
      ["@sched_limit", "0 0", "0 4000"]
    ],

    "performance_active": [
      ["@preset", "common_active"],
      ["@limiter", "p3"],
      ["@repeat", "sched_config", "62", "70", "150", "400"],
      ["@sched_limit", "0 0", "0 0"]
    ],
    "performance_inactive": [
      ["@limiter", "p1"],
      ["@preset", "common_inactive"],
      ["@repeat", "sched_config", "85", "95", "150", "400"],
      ["@sched_limit", "0 0", "0 4000"]
    ],

    "fast_active": [
      ["@preset", "common_active"],
      ["@limiter", "p4"],
      ["@repeat", "sched_config", "62 62", "70 78", "300", "400"],
      ["@sched_limit", "4000 0", "4000 0"]
    ],
    "fast_inactive": [
      ["@preset", "common_inactive"],
      ["@limiter", "p1"],
      ["@repeat", "sched_config", "85", "95", "150", "400"],
      ["@sched_limit", "0 0", "0 4000"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "powersave_active"],
        ["@values", "hispeed_freq", "1248000", "806400"],
        ["@values", "hispeed_load", "90", "90"],
        ["@values", "sched_boost", "0", "0", "0", "0"],
        ["@gpu_freq", "min", "500000"],
        ["@preset", "bw_low"]
      ],
      "game": [
        ["@cpu_freqs_max", "#1766400", "#2092800"],
        ["@cpu_freqs_min", "#576000", "#825600"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "balance_active"],
        ["@values", "hispeed_freq", "1248000", "1209600"],
        ["@values", "hispeed_load", "90", "90"],
        ["@values", "sched_boost", "1", "0", "0", "0"],
        ["@gpu_freq", "min", "630000"],
        ["@preset", "bw_max"]
      ],
      "game": [
        ["@cpu_freqs_max", "#1766400", "#2323200"],
        ["@cpu_freqs_min", "#576000", "#825600"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "performance_active"],
        ["@sched_limit", "0 0", "0 0", "0 0"],
        ["@values", "hispeed_freq", "1708800", "1209600"],
        ["@values", "hispeed_load", "87", "87"],
        ["@values", "sched_boost", "1", "0", "0", "0"],
        ["@gpu_freq", "min", "730000"],
        ["@preset", "bw_max"]
      ],
      "app": [],
      "game": [
        ["@cpu_freqs_max", "#1766400", "#2649600"],
        ["@cpu_freqs_min", "#576000", "#825600"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "reset"],
        ["@preset", "fast_active"],
        ["@values", "hispeed_freq", "0", "0"],
        ["@values", "hispeed_load", "0", "0"],
        ["@gpu_freq", "min", "max"],
        ["@preset", "bw_max"]
      ],
      "app": [
        ["@values", "sched_boost", "1", "0", "1", "10"]
      ],
      "game": [
        ["@values", "sched_boost", "1", "0", "0", "10"],
        ["@cpu_freqs_max", "#1766400", "#2803200"],
        ["@cpu_freqs_min", "#1420800", "#1766400"]
      ]
    },
    "pedestal": {
      "call": [
        ["@preset", "reset"],
        ["@sched_limit", "0 0", "0 0", "0 0"],
        ["@repeat", "sched_config", "62 40", "70 52", "300", "400"],
        ["@values", "hispeed_freq", "0", "0"],
        ["@values", "hispeed_load", "0", "0"],
        ["@values", "sched_boost", "1", "0", "1", "40"],
        ["@gpu_freq", "400000", "max"],
        ["@preset", "bw_max"],
        ["@cpu_freqs_max", "#1766400", "#2803200"],
        ["@cpu_freqs_min", "#1612800", "#2323200"]
      ],
      "game": [
      ]
    }
  },
  "apps": [
    {
      "friendly": "普通应用",
      "categories": ["ShortVideo", "Video"],
      "import": "_Apps.json"
    },
    {
      "friendly": "极速响应",
      "categories": ["Launcher"],
      "modes": [{
        "mode": ["powersave", "balance"],
        "booster": {
          "duration": 3000,
          "idle_delay": 1000,
          "enter": [["@preset", "balance_active"]],
          "exit": [["@preset", "balance_inactive"]]
        }
      }, {
        "mode": ["balance"],
        "booster": {
          "duration": 4000,
          "idle_delay": 1000,
          "enter": [["@preset", "performance_active"]],
          "exit": [["@preset", "performance_inactive"]]
        }
      }, {
        "mode": ["*"],
        "booster": {
          "duration": 5000,
          "idle_delay": 1000,
          "enter": [["@preset", "fast_active"]],
          "exit": [["@preset", "performance_inactive"]]
        }
      }]
    },
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Apps.json"
    }
  ],
  "games": [
    {
      "friendly": "Games",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}