{
  "alias": {
    "boost_affinity": "/sys/module/mtk_fpsgo/parameters/boost_affinity",
    "uclamp_heavy": "/dev/cpuctl/heavy/cpu.uclamp.min",
    "uclamp_heavy_max": "/dev/cpuctl/heavy/cpu.uclamp.max",
    "ddr_freq_min": "/sys/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/min_freq",
    "ddr_freq_max": "/sys/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/max_freq",
    "ddr_freq_cust": "/sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq",
    "ged_kpi": "/sys/module/sspm_v3/holders/ged/parameters/is_GED_KPI_enabled",
    "fpsgo": "/sys/kernel/fpsgo/common/fpsgo_enable",
    "cpufreq": "/proc/cpudvfs/cpufreq_debug"
  },
  "features": {
    "limiter": {
      "limiters": {
        "p1": {
          "cpus": [
            { "max": 2000000, "min": 1400000, "margins": "400" },
            { "max": 2200000, "min": 1400000, "margins": "400" }
          ]
        },
        "p2": {
          "cpus": [
            { "max": 2000000, "min": 1500000, "margins": "400" },
            { "max": 2600000, "min": 1800000, "margins": "400" }
          ]
        },
        "p3": {
          "cpus": [
            { "max": 2000000, "min": 1600000, "margins": "400" },
            { "max": 2600000, "min": 2100000, "margins": "400" }
          ]
        },
        "idle": {
          "cpus": [
            { "max": 1700000, "margins": "150" },
            { "max": 1700000, "margins": "150" }
          ]
        }
      }
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
        ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "24"],
        ["$ddr_freq_cust", "4266000000"]
      ],
      "exit": [
        ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"],
        ["$ddr_freq_cust", "#0"]
      ]
    }
  },
  "reset": [
    ["@mtk_reset"],
    ["@governor", "schedutil"],
    ["$uclamp_heavy_max", "max"],
    ["$boost_affinity", "#0"],
    ["$ddr_max", "#5500000000"]
  ],
  "presets": {
    "kpi_on": [
      ["$ged_kpi", "#1"],
      ["$fpsgo", "#1"]
    ],
    "kpi_off": [
      ["$fpsgo", "#1"],
      ["$ged_kpi", "#0"]
    ],
    "common_active": [
      ["$cpu_max_0", "2000000"]
    ],
    "common_inactive": [
      ["$ddr_freq_min", "#800000000"],
      ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"]
    ],
    "common_app": [
      ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_enable 0|cm_mgr_perf_enable 0"],
      ["@cpuset", "0-3", "0-7", "0-7", "0-7"],
      ["/sys/kernel/ged/hal/custom_upbound_gpu_freq", "#15"],
      ["/sys/kernel/ged/hal/timer_base_dvfs_margin", "#30"],
      ["/sys/kernel/ged/hal/loading_base_dvfs_step", "#6"]
    ],
    "common_gaming": [
      ["$uclamp_heavy", "0"],
      ["@preset", "kpi_off"],
      ["/sys/kernel/cm_mgr/dbg_cm_mgr", "cm_mgr_enable 1|cm_mgr_perf_enable 1"],
      ["/sys/kernel/ged/hal/custom_upbound_gpu_freq", "#0"],
      ["/sys/kernel/ged/hal/custom_boost_gpu_freq", "99"],
      ["/sys/module/ged/parameters/gpu_cust_boost_freq",  "0"],
      ["/sys/kernel/ged/hal/loading_base_dvfs_step", "#4"],
      ["/sys/kernel/ged/hal/timer_base_dvfs_margin", "#15"],
      ["@cpuset", "0-2", "1-3", "0-5", "0-7"],
      ["$ddr_freq_cust", "0"]
    ],

    "powersave_active": [
      ["@limiter", "p1"],
      ["@cpu_freqs_min", "800000", "500000", "600000"],
      ["$ddr_freq_min", "#2133000000"],
      ["@preset", "common_active"]
    ],
    "powersave_inactive": [
      ["@limiter", "idle"],
      ["@cpu_freqs_min", "450000", "200000", "500000"],
      ["@preset", "common_inactive"]
    ],
    "balance_active": [
      ["@limiter", "p2"],
      ["@cpu_freqs_min", "1000000", "900000", "800000"],
      ["$ddr_freq_min", "#2133000000"],
      ["@preset", "common_active"]
    ],
    "balance_inactive": [
      ["@limiter", "p1"],
      ["@cpu_freqs_min", "450000", "200000", "500000"],
      ["@preset", "common_inactive"]
    ],
    "performance_active": [
      ["@limiter", "p3"],
      ["@cpu_freqs_min", "1200000", "1600000", "1600000"],
      ["$ddr_freq_min", "3200000000"],
      ["@preset", "common_active"]
    ],
    "performance_inactive": [
      ["@limiter", "p2"],
      ["@cpu_freqs_min", "450000", "400000", "500000"],
      ["@preset", "common_inactive"]
    ],
    "fast_active": [
      ["@cpu_freq", "policy0", "1200000", "2000000"],
      ["@cpu_freq", "policy6", "1600000", "2850000"],
      ["$ddr_freq_min", "3200000000"],
      ["@preset", "common_active"]
    ],
    "fast_inactive": [
      ["@limiter", "p3"],
      ["@cpu_freqs_min", "450000", "400000", "500000"],
      ["@preset", "common_inactive"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@preset", "powersave_active"],
        ["$uclamp_heavy", "0"]
      ],
      "app": [
        ["@preset", "common_app"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@limiter", "NONE"],
        ["@cpu_freqs_min", "450000", "400000", "500000"],
        ["@cpu_freqs_max", "#2000000", "#1900000", "#2350000"],
        ["@cpu_freqs_min", "#450000", "#400000", "#500000"]
      ]
    },
    "balance": {
      "call": [
        ["@preset", "balance_active"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["$uclamp_heavy", "1.00"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@limiter", "NONE"],
        ["@cpu_freqs_min", "450000", "400000", "500000"],
        ["@cpu_freqs_max", "#2000000", "#2250000", "#2650000"],
        ["@cpu_freqs_min", "#450000", "#400000", "#500000"]
      ]
    },
    "performance": {
      "call": [
        ["@preset", "performance_active"],
        ["$uclamp_heavy", "1.00"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["$uclamp_heavy", "1.00"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@limiter", "NONE"],
        ["@cpu_freqs_min", "800000", "700000", "900000"],
        ["@cpu_freqs_max", "#2000000", "#2650000", "#2850000"],
        ["@cpu_freqs_min", "#800000", "#700000", "#900000"]
      ]
    },
    "fast": {
      "call": [
        ["@preset", "fast_active"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["$uclamp_heavy", "1.00"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@limiter", "NONE"],
        ["@cpu_freqs_min", "1600000", "1800000", "1800000"],
        ["@cpu_freqs_max", "#2000000", "#2850000", "#3100000"],
        ["@cpu_freqs_min", "#1600000", "#1800000", "#1800000"]
      ]
    }
  },
  "apps": [
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}