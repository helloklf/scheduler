{
  "alias": {
    "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
    "perfmgr_enable": "/sys/module/perfmgr/parameters/perfmgr_enable",
    "cpu_min_5": "/sys/devices/system/cpu/cpufreq/policy5/scaling_min_freq",
    "cpu_max_5": "/sys/devices/system/cpu/cpufreq/policy5/scaling_max_freq",
    "sched_boost": "/proc/sys/walt/sched_boost",
    "glk_disable": "/sys/module/migt/parameters/glk_disable",
    "input_boost": "/proc/sys/walt/input_boost/sched_boost_on_input",
    "sched_assist": "/proc/oplus_scheduler/sched_assist/sched_assist_enabled"
  },
  "features": {
    "limiter": {
      "ddr_boost": false,
      "limiters": {}
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
        ["$cpu_max_0", "^1804800"],
        ["$cpu_max_2", "^2630400"],
        ["$cpu_max_5", "^2630400"],
        ["$cpu_max_7", "^2630400"],
        ["$sched_boost", "1"]
      ],
      "exit": [
        ["$sched_boost", "0"]
      ]
    }
  },
  "reset": [
    ["@msm_reset"],
    ["@governor", "xres"],
    ["/sys/devices/system/cpu/bus_dcvs/L3/boost_freq", "364800"],
    ["/sys/devices/system/cpu/bus_dcvs/DDR/boost_freq", "547000"]
  ],
  "presets": {
    "target_loads": [
      ["/sys/devices/system/cpu/cpu0/cpufreq/walt/target_loads"],
      ["/sys/devices/system/cpu/cpu2/cpufreq/walt/target_loads"],
      ["/sys/devices/system/cpu/cpu4/cpufreq/walt/target_loads"],
      ["/sys/devices/system/cpu/cpu8/cpufreq/walt/target_loads"]
    ],
    "limiter_off": [
      ["/proc/game_opt/disable_cpufreq_limit", "#1"],
      ["/sys/module/migt/parameters/glk_disable", "#1"],
      ["/sys/module/perfmgr/parameters/perfmgr_enable", "#0"],
      ["/sys/module/migt/parameters/glk_freq_limit_walt", "#0"]
    ],
    "limiter_on": [
      ["/proc/game_opt/disable_cpufreq_limit", "0"],
      ["/sys/module/migt/parameters/glk_disable", "0"]
    ],
    "common_active": [
    ],
    "common_inactive": [
      ["@cpu_freqs_min", "307200", "499200", "499200", "480000"],
      ["$sched_boost", "0"]
    ],
    "common_app": [
      ["$perfmgr_enable", "0"],
      ["@cpuset", "0-1", "0-6", "2-7", "2-7"],
      ["/dev/cpuset/sf/cpus", "#2-7"],
      ["$mod_percent", "125"],
      ["$sched_assist", "1"]
    ],
    "common_gaming": [
      ["@preset", "common_active"],
      ["@limiter", "NONE"],
      ["@cpuset", "0-1", "0-6", "0-6", "0-7"],
      ["/dev/cpuset/sf/cpus", "#2-6"],
      ["$sched_boost", "0"],
      ["$mod_percent", "100"]
    ],

    "powersave_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "#787200", "#614400", "#614400", "#576000"],
      ["@target_loads",
        "80 1574400:90",
        "80 960000:85 1612800:90",
        "80 960000:85 1612800:90",
        "80 902400:85 1708800:90"],
      ["@hispeed_freq", "0", "844800", "844800", "844800"]
    ],
    "powersave_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1017600:90",
        "85 960000:90 1612800:95",
        "85 960000:90 1612800:95",
        "85 902400:90 1478400:95"],
      ["@hispeed_freq", "0", "0", "0", "0"]
    ],

    "balance_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "787200", "729600", "729600", "787200"],
      ["@target_loads",
        "80 1574400:90",
        "80 1708800:85 2131200:90",
        "80 1708800:85 2131200:90",
        "80 1708800:85 2112000:90"],
      ["@hispeed_freq", "0", "960000", "960000", "960000"]
    ],
    "balance_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1017600:90",
        "85 960000:90 1612800:95",
        "85 960000:90 1612800:95",
        "85 902400:90 1478400:95"],
      ["@hispeed_freq", "0", "729600", "729600", "787200"]
    ],

    "performance_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "787200", "729600", "729600", "787200"],
      ["@target_loads",
        "80 1574400:90",
        "80 1708800:85 2131200:90",
        "80 1708800:85 2131200:90",
        "80 1708800:85 2112000:90"],
      ["@hispeed_freq", "0", "1075200", "1075200", "1017600"]
    ],
    "performance_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1017600:90",
        "83 960000:85 1708800:90",
        "83 960000:85 1708800:90",
        "83 902400:85 1708800:90"],
      ["@hispeed_freq", "0", "844800", "844800", "844800"]
    ],

    "fast_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "787200", "844800", "844800", "902400"],
      ["@target_loads",
        "80 1689600:85",
        "80 2131200:85",
        "80 2131200:85",
        "80 2112000:85"],
      ["@hispeed_freq", "0", "1075200", "1286400", "1248000"]
    ],
    "fast_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1689600:90",
        "83 1708800:87 2131200:95",
        "83 1708800:87 2131200:95",
        "83 1708800:87 2112000:95"],
      ["@hispeed_freq", "0", "844800", "844800", "844800"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["/sys/devices/system/cpu/cpufreq/boost", "0"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "1670400", "#1920000", "#1920000", "#2092800"],
        ["@preset", "powersave_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_on"],
        ["@hispeed_freq", "0", "0", "0", "0"]
      ]
    },
    "balance": {
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "1804800", "#2246400", "#2246400", "#2476800"],
        ["@preset", "balance_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_on"],
        ["@hispeed_freq", "0", "960000", "1113600", "1171200"]
      ]
    },
    "performance": {
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "#1804800", "#2515200", "#2515200", "#2803200"],
        ["@preset", "performance_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_off"],
        ["@hispeed_freq", "1017600", "1497600", "1497600", "1478400"]
      ]
    },
    "fast": {
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "#1804800", "#2841600", "#2841600", "#2995200"],
        ["@preset", "fast_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_off"],
        ["@hispeed_freq", "1574400", "1708800", "1708800", "1708800"]
      ]
    }
  },
  "apps": [
    {
      "friendly": "白名单",
      "packages": [
        "com.termux",
        "xyz.chatboxapp.chatbox",
        "com.danemadsen.maid",
        "com.freakurl.apps.ollama",
        "io.github.xororz.localdream"
      ],
      "import": "_WhiteList.json"
    },
    { "friendly": "相机", "packages": ["Camera"], "import": "_Camera.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "Games",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}