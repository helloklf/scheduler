{
  "alias": {
    "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
    "perfmgr_enable": "/sys/module/perfmgr/parameters/perfmgr_enable",
    "cpu_min_6": "/sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq",
    "cpu_max_6": "/sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq",
    "cpu_min_8": "/sys/devices/system/cpu/cpufreq/policy8/scaling_min_freq",
    "cpu_max_8": "/sys/devices/system/cpu/cpufreq/policy8/scaling_max_freq",
    "sched_boost": "/proc/sys/walt/sched_boost",
    "glk_disable": "/sys/module/migt/parameters/glk_disable",
    "input_boost": "/proc/sys/walt/input_boost/sched_boost_on_input",
    "core_ctl": "/sys/devices/system/cpu/cpu8/core_ctl/enable"
  },
  "features": {
    "limiter": {
      "ddr_boost": false,
      "limiters": {}
    },
    "gesture_boost": {
      "enable": true,
      "enter": [
        ["$cpu_max_0", "^1795200"],
        ["$cpu_max_2", "^1891200"],
        ["$cpu_max_6", "^2678400"],
        ["$cpu_max_8", "^2592000"],
        ["$sched_boost", "1"]
      ],
      "exit": [
        ["$sched_boost", "0"]
      ]
    }
  },
  "reset": [
    ["@xring_reset"],
    ["@governor", "xres"],
    ["/sys/class/devfreq/ddr_devfreq/min_freq", "836000000"],
    ["/sys/devices/system/cpu/cpu0/cpufreq/xres/adaptive_high_freq", "#0"],
    ["/sys/devices/system/cpu/cpu0/cpufreq/xres/adaptive_low_freq", "#0"],
    ["/sys/devices/system/cpu/cpu2/cpufreq/xres/adaptive_high_freq", "#0"],
    ["/sys/devices/system/cpu/cpu2/cpufreq/xres/adaptive_low_freq", "#0"],
    ["/sys/devices/system/cpu/cpu4/cpufreq/xres/adaptive_high_freq", "#0"],
    ["/sys/devices/system/cpu/cpu4/cpufreq/xres/adaptive_low_freq", "#0"],
    ["/sys/devices/system/cpu/cpu8/cpufreq/xres/adaptive_high_freq", "#0"],
    ["/sys/devices/system/cpu/cpu8/cpufreq/xres/adaptive_low_freq", "#0"]
  ],
  "presets": {
    "target_loads": [
      ["/sys/devices/system/cpu/cpu0/cpufreq/xres/target_loads"],
      ["/sys/devices/system/cpu/cpu2/cpufreq/xres/target_loads"],
      ["/sys/devices/system/cpu/cpu4/cpufreq/xres/target_loads"],
      ["/sys/devices/system/cpu/cpu8/cpufreq/xres/target_loads"]
    ],
    "xres_c0": [
      ["/sys/devices/system/cpu/cpu0/cpufreq/xres/hispeed_freq"],
      ["/sys/devices/system/cpu/cpu0/cpufreq/xres/rtg_boost_freq"],
      ["/sys/devices/system/cpu/cpu0/cpufreq/xres/irq_boost_freq"]
    ],
    "xres_c1": [
      ["/sys/devices/system/cpu/cpu2/cpufreq/xres/hispeed_freq"],
      ["/sys/devices/system/cpu/cpu2/cpufreq/xres/rtg_boost_freq"],
      ["/sys/devices/system/cpu/cpu2/cpufreq/xres/irq_boost_freq"]
    ],
    "xres_c2": [
      ["/sys/devices/system/cpu/cpu4/cpufreq/xres/hispeed_freq"],
      ["/sys/devices/system/cpu/cpu4/cpufreq/xres/rtg_boost_freq"],
      ["/sys/devices/system/cpu/cpu4/cpufreq/xres/irq_boost_freq"]
    ],
    "xres_c3": [
      ["/sys/devices/system/cpu/cpu8/cpufreq/xres/hispeed_freq"],
      ["/sys/devices/system/cpu/cpu8/cpufreq/xres/rtg_boost_freq"],
      ["/sys/devices/system/cpu/cpu8/cpufreq/xres/irq_boost_freq"]
    ],
    "limiter_off": [
      ["/proc/game_opt/disable_cpufreq_limit", "#1"],
      ["/sys/module/migt/parameters/glk_disable", "#1"],
      ["/sys/module/perfmgr/parameters/perfmgr_enable", "#0"],
      ["/sys/module/migt/parameters/glk_freq_limit_walt", "#0"]
    ],
    "common_active": [
      ["@values", "xres_c0", "#1036800", "#1228800", "#1228800"],
      ["@values", "xres_c2", "#1017600",  "#1017600",  "#844800"],
      ["@values", "xres_c3", "#1017600", "#816000", "#816000"]
    ],
    "common_inactive": [
      ["@cpu_freqs_min", "334230", "417790", "691200", "1891200"],
      ["$sched_boost", "0"],
      ["@values", "xres_c0", "#835200", "#1036800", "#1036800"],
      ["@values", "xres_c2", "#844800", "#844800", "#844800"],
      ["@values", "xres_c3", "#816000", "#816000", "#816000"]
    ],
    "common_app": [
      ["$perfmgr_enable", "0"],
      ["@cpuset", "0-1", "0-3", "2-7", "2-9"],
      ["/dev/cpuset/sf/cpus", "#2-7"],
      ["$core_ctl", "#1"]
    ],
    "common_gaming": [
      ["@preset", "common_active"],
      ["@limiter", "NONE"],
      ["@cpuset", "0-1", "0-3", "2-7", "2-9"],
      ["/dev/cpuset/sf/cpus", "#2-6"],
      ["$sched_boost", "0"],
      ["$core_ctl", "#0"]
    ],

    "powersave_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "#643200", "#691200", "#691200", "#1891200"],
      ["@target_loads",
        "80 1603200:90",
        "80 1017600:85 1536000:90",
        "80 1017600:85 1555200:90",
        "80 1891200:85 1891200:90"]
    ],
    "powersave_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1036800:90",
        "85 844800:90 1536000:95",
        "85 940800:90 1555200:95",
        "95"]
    ],

    "balance_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "835200", "691200", "691200", "1891200"],
      ["@target_loads",
        "80 1603200:90",
        "80 1555200:85 1718400:90",
        "80 1555200:85 1900800:90",
        "85 2044800:90"]
    ],
    "balance_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1036800:90",
        "85 844800:90 1536000:95",
        "85 940800:90 1555200:95",
        "95"]
    ],

    "performance_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "835200", "691200", "691200", "1891200"],
      ["@target_loads",
        "80 1603200:90",
        "80 1718400:85 1891200:90",
        "80 1728000:85 2083200:90",
        "85 2044800:90"]
    ],
    "performance_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1036800:90",
        "85 1017600:90 1536000:95",
        "85 940800:90 1555200:95",
        "90"]
    ],

    "fast_active": [
      ["@preset", "common_active"],
      ["@cpu_freqs_min", "835200", "844800", "816000", "1891200"],
      ["@target_loads",
        "80 1603200:85",
        "80 1891200:85",
        "80 2083200:85",
        "80 2044800:85"]
    ],
    "fast_inactive": [
      ["@preset", "common_inactive"],
      ["@target_loads",
        "85 1603200:90",
        "83 1718400:87 1891200:95",
        "83 1728000:87 2083200:95",
        "87 2044800:95"]
    ]
  },
  "schemes": {
    "powersave": {
      "call": [
        ["/sys/devices/system/cpu/cpufreq/boost", "0"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "1603200", "#1891200", "#1900800", "#2044800"],
        ["@preset", "powersave_active"]
      ],
      "game": [
        ["@preset", "common_gaming"]
      ]
    },
    "balance": {
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "1795200", "#1891200", "#2236800", "#2400000"],
        ["@preset", "balance_active"]
      ],
      "game": [
        ["@preset", "common_gaming"]
      ]
    },
    "performance": {
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "#1795200", "#1891200", "#2544000", "#2793600"],
        ["@preset", "performance_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_off"]
      ]
    },
    "fast": {
      "app": [
        ["@preset", "common_app"],
        ["@cpu_freqs_max", "#1795200", "#1891200", "#2812800", "#2976000"],
        ["@preset", "fast_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_off"]
      ]
    }
  },
  "apps": [
    {
      "friendly": "白名单",
      "packages": [
        "com.termux",
        "xyz.chatboxapp.chatbox",
        "com.danemadsen.maid",
        "com.freakurl.apps.ollama",
        "io.github.xororz.localdream"
      ],
      "import": "_WhiteList.json"
    },
    { "friendly": "相机", "packages": ["Camera"], "import": "_Camera.json" },
    { "friendly": "All", "packages": ["*"], "import": "_Apps.json" }
  ],
  "games": [
    {
      "friendly": "Games",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}
